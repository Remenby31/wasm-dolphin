{
  "mode": "screening",
  "blockCount": 2,
  "maxBlockCount": 2,
  "primaryMetric": "fixedEmulatedWork.throughputGameSpeedPercent",
  "direction": "higher",
  "minimumEffectPercent": 0,
  "hypothesis": "The sampled draw-detail suite adds less than 2% incremental fixed-work overhead on top of the producer profiler.",
  "invalidationRules": [
    "use the verified reference-battle fixed battle with SAVE_STATE_AT=0 and no gameplay input",
    "both arms require metrics=1 and wgpuprodprofile=1 with otherwise identical settings",
    "the reference arm must expose wgdraw v1 disabled with zero counters",
    "the detail arm must expose wgdraw v1 enabled with stable epoch, phase order, periods, stratified cadence, and monotonic counters",
    "each arm's two primary-metric observations must remain within 10% of their arm mean",
    "each ABBA/BAAB block must remain below 2% incremental throughput regression",
    "actual core-tick and frame work must remain within 5% between arms"
  ],
  "stopRule": "Require two complete ABBA/BAAB blocks; reject any block with >=2% profiling regression, non-equivalent semantic work, or invalid producer/draw profile evidence.",
