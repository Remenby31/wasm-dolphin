-  if (!s_regions_enabled.load(std::memory_order_relaxed) || !RegionFilterHas(ppc_state.pc) ||
+  if (!s_regions_on || !RegionFilterHas(ppc_state.pc) ||
       !ppc_state.msr.IR || !ppc_state.msr.DR || !ppc_state.msr.FP ||
       (ppc_state.feature_flags & FEATURE_FLAG_PERFMON) != 0 ||
       !s_region_at.contains(ppc_state.pc))
@@ -9673,6 +9679,7 @@ extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotQueueRegion(const u8* bytes,
 extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_JitSetRegionsEnabled(int enabled)
 {
   s_regions_enabled.store(enabled != 0, std::memory_order_relaxed);
+  s_regions_on = enabled != 0;
 }
 
 // Tests (the Node core has no CPU thread loop): install what is queued, as
@@ -9754,7 +9761,7 @@ extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_JitRegionStats(int sample_every)
 void CachedInterpreter::ExecuteOneBlock([[maybe_unused]] bool allow_redispatch)
 {
 #ifdef __EMSCRIPTEN__
-  if (s_regions_enabled.load(std::memory_order_relaxed) && !s_region_at.empty() &&
+  if (s_regions_on && !s_region_at.empty() &&
       TryRunRegion(m_ppc_state))
     return;
 #endif
@@ -10140,6 +10147,7 @@ void CachedInterpreter::Run()
     // The compile budget has been replenished and no cached callback is active.
     RetryDeferredWasmBlocks(*this);
     ServiceRegionInstalls();
+    s_regions_on = s_regions_enabled.load(std::memory_order_relaxed);
     ApplyRegionStatsRequest();
     // Start new timing slice
     // Metrics-off runs avoid all per-slice clocks. BeginSlice also resets
