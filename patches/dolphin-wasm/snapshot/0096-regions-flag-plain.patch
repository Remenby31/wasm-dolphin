 std::atomic<bool> s_regions_enabled{false};
+// The CPU thread's copy of s_regions_enabled, refreshed at each slice and by
+// the setter: the per-block tests read it. In wasm every atomic load is a
+// sequentially consistent i32.atomic.load, relaxed or not, which the engine
+// cannot hoist out of the run loop; without regions that was two such loads
+// per block.
+bool s_regions_on = false;
 // Direct-mapped filter of entry PCs (bit (pc >> 2) & 0xfffff, 128 KiB: a
 // disc maps ~135 000 entries, 64 Kibit saturated): the dispatcher
 // and block chaining look up the map only when the bit is set, so installed
@@ -9572,7 +9578,7 @@ bool TryRunRegion(PowerPC::PowerPCState& ppc_state)
 // mode regions run in.
 inline bool RegionWouldRun(const PowerPC::PowerPCState& ppc_state)
