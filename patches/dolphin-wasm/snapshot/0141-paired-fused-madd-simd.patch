+// Patch 0141: ps_madd/msub/nmadd/nmsub/madds0/madds1 with fused relaxed_madd
+// (0129's mode), both lanes in f64x2 at once. Inside the MSR fast-path if:
+// emits `if (every lane passes) { store both lanes, FPRF } else helper end`.
+// A lane passes exactly where the scalar path (EmitFpArithLane with
+// EmitExactMulAddSub's fused branch) computes it inline without its tie fix:
+// a and frC zero or normal, then frC rounded to 25 bits (Force25Bit), then a
+// zero operand with b finite or the 2^995 / 2^-900 range, no single tie in
+// a * c + b (the scalar fix stays, inline, for the helper here: rare), and a
+// result that is zero or a normal single (no NaN, overflow or NI flush). The
+// rest, and any lane failing, calls the interpreter for the whole op, as the
+// scalar path does when one of its lanes fails.
+void EmitPairedFusedMulAddSub(std::vector<u8>& body, const WasmStateLayout& layout,
+                              const PPCAnalyst::CodeOp& op, bool sub, bool negate, u32 c_lane,
+                              bool splat_c, u32 downcount)
+{
+  const UGeckoInstruction inst = op.inst;
+  const u32 va = WasmV128ScratchLocal(0), vc = WasmV128ScratchLocal(1);
+  const u32 vb = WasmV128ScratchLocal(2), vr = WasmV128ScratchLocal(3);
+  const auto simd = [&](u32 code) {
+    body.push_back(0xfd);
+    EmitU32Leb(body, code);
+  };
+  constexpr u32 LOAD = 0x00, STORE = 0x0b, CONST = 0x0c, SHUFFLE = 0x0d, EXTRACT = 0x21,
+                EQ = 0x47, LT = 0x49, LE = 0x4b, GE = 0x4c, AND = 0x4e, ANDNOT = 0x4f, OR = 0x50,
+                DEMOTE = 0x5e, PROMOTE = 0x5f, ALL_TRUE = 0xc3, ADD_I64 = 0xce, EQ_I64 = 0xd6,
+                ABS = 0xec, NEG = 0xed, MUL = 0xf2, MADD = 0x107;
+  const auto load = [&](u32 offset) {
+    EmitLocalGet(body, 0);
+    simd(LOAD);
+    body.push_back(0x03);  // align 8 (state lanes are 8-aligned)
+    EmitU32Leb(body, offset);
+  };
+  const auto i64x2 = [&](u64 v) {
+    simd(CONST);
+    for (int k = 0; k < 2; ++k)
+      for (int i = 0; i < 8; ++i)
+        body.push_back(static_cast<u8>(v >> (8 * i)));
+  };
+  const auto f64x2 = [&](double v) { i64x2(std::bit_cast<u64>(v)); };
+  const auto get = [&](u32 l) { EmitLocalGet(body, l); };
+  const auto abs_of = [&](u32 l) {
+    get(l);
+    simd(ABS);
+  };
+  // |x| == 0, or 2^-1022 <= |x| < inf (EmitIsZeroOrNormalDouble per lane;
+  // NaN compares false).
+  const auto zero_or_normal = [&](u32 l) {
+    abs_of(l); f64x2(0.0); simd(EQ);
+    abs_of(l); f64x2(0x1p-1022); simd(GE);
+    abs_of(l); f64x2(std::numeric_limits<double>::infinity()); simd(LT);
+    simd(AND);
+    simd(OR);
+  };
+
+  load(PsOffset(layout, inst.FA, 0));
+  EmitLocalSet(body, va);
+  load(PsOffset(layout, inst.FC, 0));
+  if (splat_c)
+  {
+    // ps_madds0/1: frC's lane c_lane in both lanes.
+    body.push_back(0x22);  // local.tee
+    EmitU32Leb(body, vc);
+    get(vc);
+    simd(SHUFFLE);
+    for (int k = 0; k < 2; ++k)
+      for (u32 i = 0; i < 8; ++i)
+        body.push_back(static_cast<u8>(c_lane * 8 + i));
+  }
+  EmitLocalSet(body, vc);
+  load(PsOffset(layout, inst.FB, 0));
+  if (sub)
+    simd(NEG);
+  EmitLocalSet(body, vb);
+
+  // The mask, all-ones per passing lane: a and frC zero or normal before
+  // Force25Bit (a denormal frC rounds to zero there, its product does not).
+  zero_or_normal(va);
+  zero_or_normal(vc);
+  simd(AND);
+  // Force25Bit(c) = (c & ~0x7ffffff) + (c & 0x8000000), on the bits.
+  get(vc); i64x2(0xfffffffff8000000ull); simd(AND);
+  get(vc); i64x2(0x8000000ull); simd(AND);
+  simd(ADD_I64);
+  EmitLocalSet(body, vc);
+  // A zero a or frC with b finite, or the range of 0129's fused path.
+  get(va); f64x2(0.0); simd(EQ);
+  get(vc); f64x2(0.0); simd(EQ);
+  simd(OR);
+  abs_of(vb); f64x2(std::numeric_limits<double>::infinity()); simd(LT);
+  simd(AND);
+  abs_of(va); f64x2(0x1p995); simd(LE);
+  abs_of(vc); f64x2(0x1p995); simd(LE);
+  simd(AND);
+  abs_of(vb); f64x2(0x1p995); simd(LE);
+  simd(AND);
+  get(va); get(vc); simd(MUL); simd(ABS); f64x2(0x1p-900); simd(GE);
+  simd(AND);
+  simd(OR);
+  simd(AND);
+  // r = fma(a, c, b), rounded once.
+  get(va); get(vc); get(vb); simd(MADD);
+  body.push_back(0x22);  // local.tee
+  EmitU32Leb(body, vr);
+  // No single tie: the 29 bits below single precision are not exactly half.
+  i64x2(0x1fffffffull); simd(AND); i64x2(0x10000000ull); simd(EQ_I64);
+  simd(ANDNOT);
+  // r is zero or rounds to a normal single (EmitIsZeroOrNormalSingleResult).
+  abs_of(vr); f64x2(0.0); simd(EQ);
+  abs_of(vr); f64x2(0x1p-126); simd(GE);
+  abs_of(vr); i64x2(0x47effffff0000000ull); simd(LT);
+  simd(AND);
+  simd(OR);
+  simd(AND);
+  simd(ALL_TRUE);
+  HintNextIf(body, true);  // a lane leaves the fast path rarely
+  body.push_back(0x04);
+  body.push_back(0x40);
+  // ForceSingle both lanes, then nmadd/nmsub negate the rounded result.
+  EmitLocalGet(body, 0);
+  get(vr);
+  simd(DEMOTE);
+  simd(PROMOTE);
+  if (negate)
+    simd(NEG);
+  body.push_back(0x22);  // local.tee
+  EmitU32Leb(body, vr);
+  simd(STORE);
+  body.push_back(0x03);
+  EmitU32Leb(body, PsOffset(layout, inst.FD, 0));
+  const u32 r0 = WasmFpScratchLocal(0);
+  get(vr);
+  simd(EXTRACT);
+  body.push_back(0x00);
+  EmitLocalSet(body, r0);
+  EmitSetFprfZeroOrNormal(body, layout, r0, 0, op.wantsFPRF);
+  body.push_back(0x05);
+  EmitFpCall(body, op, downcount);
+  body.push_back(0x0b);
+}
