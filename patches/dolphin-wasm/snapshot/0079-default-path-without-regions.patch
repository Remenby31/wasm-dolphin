+#ifdef __EMSCRIPTEN__
+// Region stats with timing on: one block lookup in sample_every is timed and
+// stands for sample_every of them (lookups are short and many). Out of line,
+// so that ExecuteOneBlock stays the size it was without the stats.
+template <typename BlockCache>
+[[gnu::noinline]] const u8* TimedDispatch(BlockCache& cache)
+{
+  if (++s_sampled_lookups < s_region_stats.sample_every)
+    return cache.Dispatch();
+  s_sampled_lookups = 0;
+  const auto t0 = std::chrono::steady_clock::now();
+  const u8* const found = cache.Dispatch();
+  s_sampled_lookup_ms +=
+      std::max(std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0)
+                       .count() -
+                   s_clock_pair_ms,
+               0.0) *
+      s_region_stats.sample_every;
+  return found;
+}
+#endif
