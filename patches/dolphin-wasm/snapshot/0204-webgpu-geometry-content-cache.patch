+  // entries leave in insertion order, never one used in the current submit
+  // (the copy into it would land before that submit's draws). Content keeps
+  // its meaning across save loads and resets, so placement epochs do not
+  // touch it; only its own setter (init, device loss) clears it.
+  enum class GeometryCacheResult
+  {
+    Miss,    // not served: the stream path takes it
+    Served,  // a hit or an insertion: out_base_* point into the cache
+    Failed,  // the insertion's upload was refused: no placement
+  };
+  struct GeometryCacheKey
+  {
+    u64 lo = 0;
+    u64 hi = 0;
+    u32 bytes = 0;
+    u32 stride = 0;
+    bool operator==(const GeometryCacheKey& other) const
+    {
+      return lo == other.lo && hi == other.hi && bytes == other.bytes && stride == other.stride;
+    }
+  };
+  struct GeometryCacheKeyHash
+  {
+    size_t operator()(const GeometryCacheKey& key) const
+    {
+      return static_cast<size_t>(key.lo ^ (key.hi * 0x9E3779B97F4A7C15ull) ^ key.bytes ^
+                                 (static_cast<u64>(key.stride) << 32));
+    }
+  };
+  struct GeometryCacheEntry
+  {
+    u32 offset = 0;
+    u32 packet_bytes = 0;
+    u64 used_submit = 0;
+    std::vector<u8> sample;  // the bytes, for the sampled comparison
+  };
+  GeometryCacheResult TryGeometryCache(u32 vertex_bytes, u32 index_bytes, u32 packet_bytes,
+                                       u32 vertex_stride, u32* out_base_vertex,
+                                       u32* out_base_index);
+  void ResetGeometryCache();
+  static constexpr u32 kGeometryCacheSize = 32u * 1024u * 1024u;
+  static constexpr u32 kGeometryCacheInsertCapPerFrame = 1024u * 1024u;
+  u32 m_cache_size = kGeometryCacheSize;  // smaller in the smoke
+  u32 m_cache_buffer_id = 0;
+  u32 m_cache_write = 0;
+  u64 m_cache_epoch = 0;
+  u64 m_cache_submit = 0;
+  u32 m_cache_inserted_this_frame = 0;
+  u32 m_cache_inserts = 0;
+  bool m_draw_from_cache = false;
+  bool m_last_draw_from_cache = false;
+  std::unordered_map<GeometryCacheKey, GeometryCacheEntry, GeometryCacheKeyHash> m_cache_entries;
+  std::deque<GeometryCacheKey> m_cache_order;
+  std::unordered_set<GeometryCacheKey, GeometryCacheKeyHash> m_cache_seen_previous;
+  std::unordered_set<GeometryCacheKey, GeometryCacheKeyHash> m_cache_seen_current;
 };
 
