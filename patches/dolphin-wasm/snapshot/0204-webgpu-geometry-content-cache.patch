+void VertexManager::ResetGeometryCache()
+{
+  if (m_cache_buffer_id != 0)
+    m_retired_geometry_buffers.push_back(m_cache_buffer_id);
+  m_cache_buffer_id = 0;
+  m_cache_write = 0;
+  m_cache_inserted_this_frame = 0;
+  m_cache_inserts = 0;
+  m_draw_from_cache = false;
+  m_cache_entries.clear();
+  m_cache_order.clear();
+  m_cache_seen_previous.clear();
+  m_cache_seen_current.clear();
+  s_geometry_cache_stats.resets += 1;
+}
+
+VertexManager::GeometryCacheResult
+VertexManager::TryGeometryCache(u32 vertex_bytes, u32 index_bytes, u32 packet_bytes,
+                                u32 vertex_stride, u32* out_base_vertex, u32* out_base_index)
+{
+  WebGPUCommandStream& cs = GetCommandStream();
+  const u64 cache_epoch = GetGeometryCacheEpoch();
+  if (cache_epoch != m_cache_epoch)
+  {
+    ResetGeometryCache();
+    m_cache_epoch = cache_epoch;
+  }
+  // A frame ends at SUBMIT_PRESENT: what it saw becomes "the frame before".
+  const u64 submit_serial = cs.GetSubmitSerial();
+  if (submit_serial != m_cache_submit)
+  {
+    m_cache_seen_previous.swap(m_cache_seen_current);
+    m_cache_seen_current.clear();
+    m_cache_inserted_this_frame = 0;
+    m_cache_submit = submit_serial;
+  }
+
+  // The packet as the stream path would upload it: vertices, then indices.
+  XXH3_state_t state;
+  XXH3_128bits_reset(&state);
+  if (vertex_bytes != 0)
+    XXH3_128bits_update(&state, m_base_buffer_pointer, vertex_bytes);
+  if (index_bytes != 0)
+    XXH3_128bits_update(&state, m_cpu_index_buffer.data(), index_bytes);
+  const XXH128_hash_t hash = XXH3_128bits_digest(&state);
+  const GeometryCacheKey key{hash.low64, hash.high64, packet_bytes, vertex_stride};
+  const bool seen_before = m_cache_seen_previous.contains(key);
+  m_cache_seen_current.insert(key);
+
+  const auto place = [&](u32 offset) {
+    m_draw_from_cache = true;
+    m_last_vertex_byte = offset;
+    m_last_index_byte = offset + vertex_bytes;
+    *out_base_vertex = offset / vertex_stride;
+    *out_base_index = (offset + vertex_bytes) / sizeof(u16);
+    if (!m_last_draw_from_cache)
+      s_geometry_cache_stats.switches += 1;
+    m_last_draw_from_cache = true;
+  };
+
+  if (const auto hit = m_cache_entries.find(key); hit != m_cache_entries.end())
+  {
+    GeometryCacheEntry& entry = hit->second;
+    entry.used_submit = submit_serial;
+    if (!entry.sample.empty() && IsGeometryCacheCompareEnabled())
+    {
+      // Diagnostics: a hash collision would draw other bytes. Compare the
+      // sampled entries' bytes with this packet's.
+      s_geometry_cache_stats.compares += 1;
+      const bool same =
+          entry.sample.size() >= vertex_bytes + index_bytes &&
+          std::memcmp(entry.sample.data(), m_base_buffer_pointer, vertex_bytes) == 0 &&
+          std::memcmp(entry.sample.data() + vertex_bytes, m_cpu_index_buffer.data(),
+                      index_bytes) == 0;
+      if (!same)
+        s_geometry_cache_stats.collisions += 1;
+    }
+    s_geometry_cache_stats.hits += 1;
+    s_geometry_cache_stats.hit_bytes += packet_bytes;
+    place(entry.offset);
+    return GeometryCacheResult::Served;
+  }
+
+  const auto miss = [&] {
+    s_geometry_cache_stats.misses += 1;
+    s_geometry_cache_stats.miss_bytes += packet_bytes;
+    return GeometryCacheResult::Miss;
+  };
+  if (!seen_before || packet_bytes > m_cache_size)
+    return miss();
+  if (m_cache_inserted_this_frame + packet_bytes > kGeometryCacheInsertCapPerFrame)
+  {
+    s_geometry_cache_stats.cap_skips += 1;
+    return miss();
+  }
+
+  // Room in the ring: aligned to the stride (base_vertex), wrapping to 0;
+  // the oldest entries in the way go, unless the current submit uses one.
+  const u64 aligned_64 =
+      (static_cast<u64>(m_cache_write) + vertex_stride - 1) / vertex_stride * vertex_stride;
+  u32 offset = aligned_64 + packet_bytes <= m_cache_size ? static_cast<u32>(aligned_64) : 0;
+  while (!m_cache_order.empty())
+  {
+    const auto oldest = m_cache_entries.find(m_cache_order.front());
+    if (oldest == m_cache_entries.end())
+    {
+      m_cache_order.pop_front();
+      continue;
+    }
+    const GeometryCacheEntry& entry = oldest->second;
+    const bool overlaps =
+        entry.offset < offset + packet_bytes && offset < entry.offset + entry.packet_bytes;
+    if (!overlaps)
+      break;
+    if (entry.used_submit == submit_serial)
+    {
+      s_geometry_cache_stats.blocked += 1;
+      return miss();
+    }
+    m_cache_entries.erase(oldest);
+    m_cache_order.pop_front();
+  }
+
+  if (m_cache_buffer_id == 0)
+  {
+    m_cache_buffer_id = cs.PushCreateBuffer(m_cache_size, kUsageGeometry);
+    if (m_cache_buffer_id == 0)
+      return miss();
+  }
+  // Through the public FIFO at once, as a range flush: published ahead of the
+  // pass that draws from it, and valid even if that pass is aborted later.
+  const UploadPacket packet = cs.UploadAllocTwoSegments(
+      m_base_buffer_pointer, vertex_bytes, m_cpu_index_buffer.data(), index_bytes, 4, 4);
+  if (packet.src_heap_ptr == 0)
+  {
+    s_geometry_cache_stats.failed += 1;
+    return GeometryCacheResult::Failed;
+  }
+  if (packet.second_offset != vertex_bytes || packet.total_size != packet_bytes)
+  {
+    cs.FailLastUpload(packet.src_heap_ptr, packet.total_size);
+    s_geometry_cache_stats.failed += 1;
+    return GeometryCacheResult::Failed;
+  }
+  if (!cs.PushUploadBuffer(m_cache_buffer_id, offset, packet.src_heap_ptr, packet.total_size,
+                           BufferUploadRole::Geometry))
+  {
+    s_geometry_cache_stats.failed += 1;
+    return GeometryCacheResult::Failed;
+  }
+
+  GeometryCacheEntry entry;
+  entry.offset = offset;
+  entry.packet_bytes = packet_bytes;
+  entry.used_submit = submit_serial;
+  // Diagnostics: one insertion in 64 keeps its bytes for the comparison.
+  if (IsGeometryCacheCompareEnabled() && (m_cache_inserts++ % 64) == 0)
+  {
+    entry.sample.resize(vertex_bytes + index_bytes);
+    std::memcpy(entry.sample.data(), m_base_buffer_pointer, vertex_bytes);
+    std::memcpy(entry.sample.data() + vertex_bytes, m_cpu_index_buffer.data(), index_bytes);
+  }
+  m_cache_entries.emplace(key, std::move(entry));
+  m_cache_order.push_back(key);
+  m_cache_write = offset + packet_bytes;
+  m_cache_inserted_this_frame += packet_bytes;
+  s_geometry_cache_stats.inserts += 1;
+  s_geometry_cache_stats.insert_bytes += packet_bytes;
+  place(offset);
+  return GeometryCacheResult::Served;
+}
