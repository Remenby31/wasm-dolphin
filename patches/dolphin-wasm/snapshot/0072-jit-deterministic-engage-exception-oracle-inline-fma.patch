+// Deterministic engage (SetPpcWasmJitWarmup): the CPU thread switches to the
+// armed policy once the emulated field counter (MovieManager's, advanced by
+// VI on this thread and saved in states) reaches start + `fields`. The start
+// is field 0 when armed for a boot, and the loaded field after a state load
+// (taken on the CPU thread before the loaded state runs), so the engage
+// field depends on emulated time only, never on when the worker armed it.
+// s_wasm_engaged_frame reports it (UINT64_MAX until engaged).
+std::atomic<int> s_wasm_armed_policy{-1};
+std::atomic<u32> s_wasm_armed_fields{0};
+std::atomic<bool> s_wasm_arm_restart{false};
+std::atomic<bool> s_wasm_arm_from_boot{false};
+u64 s_wasm_arm_start_frame = 0;
+bool s_wasm_arm_started = false;
+std::atomic<u64> s_wasm_engaged_frame{UINT64_MAX};
+}  // namespace
+
+// Runs on the CPU thread before ApplyRequestedWasmPolicy: turns an armed
+// warmup into a policy request at the exact emulated field.
+void ApplyArmedWasmPolicyAt(u64 frame)
+{
+  const int armed = s_wasm_armed_policy.load(std::memory_order_acquire);
+  if (armed < 0)
+    return;
+  if (s_wasm_arm_restart.exchange(false, std::memory_order_acq_rel) || !s_wasm_arm_started)
+  {
+    s_wasm_arm_start_frame = s_wasm_arm_from_boot.exchange(false) ? 0 : frame;
+    s_wasm_arm_started = true;
+    s_wasm_engaged_frame.store(UINT64_MAX, std::memory_order_relaxed);
+    s_requested_wasm_policy.store(0, std::memory_order_release);
+  }
+  if (s_wasm_engaged_frame.load(std::memory_order_relaxed) == UINT64_MAX &&
+      frame - s_wasm_arm_start_frame >= s_wasm_armed_fields.load(std::memory_order_relaxed))
+  {
+    s_wasm_engaged_frame.store(frame, std::memory_order_relaxed);
+    s_requested_wasm_policy.store(armed, std::memory_order_release);
+  }
+}
+
+void ApplyArmedWasmPolicy()
+{
+  if (s_wasm_armed_policy.load(std::memory_order_acquire) >= 0)
+    ApplyArmedWasmPolicyAt(Core::System::GetInstance().GetMovie().GetCurrentFrame());
+}
+
+// Drives the armed warmup with a synthetic field counter, as the CPU thread
+// would at the start of each slice; returns the engaged field or -1.
+extern "C" EMSCRIPTEN_KEEPALIVE double DolphinWeb_JitArmedStepForTest(double frame)
+{
+  ApplyArmedWasmPolicyAt(static_cast<u64>(frame));
+  const u64 engaged = s_wasm_engaged_frame.load(std::memory_order_relaxed);
+  return engaged == UINT64_MAX ? -1.0 : static_cast<double>(engaged);
+}
+
+// Arms the JIT to engage `fields` emulated fields from now (or from the next
+// state load), decided on the CPU thread. policy: 1 guarded, 2 mixed; 0
+// disarms and turns the JIT off.
+extern "C" EMSCRIPTEN_KEEPALIVE void SetPpcWasmJitWarmup(int policy, u32 fields)
+{
+  if (policy <= 0)
+  {
+    s_wasm_armed_policy.store(-1, std::memory_order_release);
+    SetPpcWasmJitEnabled(0);
+    return;
+  }
+  s_wasm_armed_fields.store(fields, std::memory_order_relaxed);
+  s_wasm_arm_from_boot.store(true, std::memory_order_relaxed);
+  s_wasm_arm_restart.store(true, std::memory_order_release);
+  s_wasm_armed_policy.store(policy < 2 ? 1 : 2, std::memory_order_release);
