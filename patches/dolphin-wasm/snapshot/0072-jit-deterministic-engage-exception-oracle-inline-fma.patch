+}
+
+// Emulated field at which the armed JIT engaged; -1 while it has not.
+extern "C" EMSCRIPTEN_KEEPALIVE double GetPpcWasmJitEngagedFrame()
+{
+  const u64 frame = s_wasm_engaged_frame.load(std::memory_order_relaxed);
+  return frame == UINT64_MAX ? -1.0 : static_cast<double>(frame);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_JitOnStateLoaded()
