+
+// Field the armed warmup counts from (0 at boot, the loaded field after a
+// state load); -1 when not armed.
+extern "C" EMSCRIPTEN_KEEPALIVE double GetPpcWasmJitArmStartFrame()
+{
+  return s_wasm_armed_policy.load(std::memory_order_acquire) < 0 || !s_wasm_arm_started ?
+             -1.0 :
