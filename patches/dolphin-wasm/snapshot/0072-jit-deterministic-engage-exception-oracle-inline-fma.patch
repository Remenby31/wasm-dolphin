+  if (s_wasm_armed_policy.load(std::memory_order_acquire) < 0)
+    return;
+  // A state loaded before the first slice still counts from the loaded field.
+  s_wasm_arm_from_boot.store(false, std::memory_order_relaxed);
+  s_wasm_arm_restart.store(true, std::memory_order_release);
+}
