diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
--- a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
@@ -15466,6 +15466,22 @@ constexpr u32 WASM_FRAGMENT_PC_LOCAL = 56;  // appended after the block locals 1
 // code inside its ranges (invalidation drops it by those ranges): no branch
 // following (a call is a jump, its return point an entry), and the block
 // stops at `limit`, the end of the range holding pc.
+// Patch 0105: an FPU op the direct tier does not emit (the Rc forms, mffs,
+// mtfsf, the paired-single ops 0087 leaves to helpers, ...) stays in the
+// region as a call to the interpreter (EmitInterpretCall: GPR cache flushed
+// and reloaded, a halt returns 2) instead of ending it: leaving the region
+// for one op cost a round trip through the dispatcher and the cached
+// interpreter. Only computational FPU ops: an op that changes the MSR, the
+// translation or the code (system, cache and branch ops) still ends the
+// region, which never checks the CPU's mode between its blocks.
+bool RegionInterpretsInline(const PPCAnalyst::CodeOp& op)
+{
+  if ((op.opinfo->flags & FL_USE_FPU) == 0 || op.canEndBlock || op.branchIsIdleLoop)
+    return false;
+  const UGeckoInstruction inst = op.inst;
+  return !(inst.OPCD == 4 && inst.SUBOP10 == 1014);  // dcbz_l: a cache op
+}
+
 bool BuildFragmentBlock(Core::System& system, u32 pc, u32 limit, FragmentBlock* out)
 {
   auto& ppc = system.GetPPCState();
@@ -15497,7 +15513,7 @@ bool BuildFragmentBlock(Core::System& system, u32 pc, u32 limit, FragmentBlock*
   for (; prefix < block.m_num_instructions; ++prefix)
