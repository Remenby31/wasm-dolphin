diff --git a/Source/Core/VideoCommon/ShaderCache.cpp b/Source/Core/VideoCommon/ShaderCache.cpp
--- a/Source/Core/VideoCommon/ShaderCache.cpp
+++ b/Source/Core/VideoCommon/ShaderCache.cpp
@@ -748,6 +748,24 @@ static GXUberPipelineUid ApplyDriverBugs(const GXUberPipelineUid& in)
     out.ps_uid.GetUidData()->no_dual_src = true;
   }
 
+  // Patch 0222: the same WebGPU rule the specialized pipelines already follow
+  // (PipelineUtils.cpp ApplyDriverBugs): a pixel shader that writes depth
+  // (per_pixel_depth) does not emit the dual-source output, the draw falls
+  // back to single-source blending. Our SPIR-V -> WGSL translator, Naga 26,
+  // refuses a fragment output struct with @blend_src members plus any other
+  // member, @builtin(frag_depth) included ("If `blend_src` is used, there must
+  // be exactly two outputs ..."). The WGSL spec and Naga >= 30 only forbid
+  // other @location members, so Naga 26 is the stricter one; the narrowest fix
+  // is this rule, which gives the ubershaders exactly the specialized
+  // shaders' blending (no translator upgrade, no change to any specialized
+  // result). Without it every dual-source + per-pixel-depth ubershader failed
+  // to translate.
+  if (g_backend_info.api_type == APIType::Vulkan && out.ps_uid.GetUidData()->per_pixel_depth)
+  {
+    out.blending_state.use_dual_src = false;
+    out.ps_uid.GetUidData()->no_dual_src = true;
+  }
+
   if (g_ActiveConfig.UseVSForLinePointExpand())
   {
     // All primitives are expanded to triangles in the vertex shader
diff --git a/Source/Core/VideoCommon/UberShaderVertex.cpp b/Source/Core/VideoCommon/UberShaderVertex.cpp
--- a/Source/Core/VideoCommon/UberShaderVertex.cpp
+++ b/Source/Core/VideoCommon/UberShaderVertex.cpp
@@ -151,7 +151,16 @@ float3 load_input_float3_rawtex(uint vtx_offset, uint attr_offset) {{
     out.Write("ATTRIBUTE_LOCATION({:s}) in float4 rawpos;\n", ShaderAttrib::Position);
 #ifdef __EMSCRIPTEN__
     // See VertexShaderGen.cpp: WebGL2 path feeds posmtx as float, not uint.
-    out.Write("ATTRIBUTE_LOCATION({:s}) in float4 posmtx;\n", ShaderAttrib::PositionMatrix);
+    // Patch 0222: the WebGPU backend (api_type == Vulkan) feeds it as uint8x4
+    // (Uint base type), as the specialized vertex shader already declares it:
+    // a float4 here made createRenderPipeline refuse every ubershader geometry
+    // pipeline ("Attribute base type (Uint for VertexFormat::Uint8x2) does not
+    // match the shader's base type (Float) in location (1)"). The body reads
+    // `int(posmtx.r)`, the same value from either type.
+    if (api_type == APIType::Vulkan)
+      out.Write("ATTRIBUTE_LOCATION({:s}) in uint4 posmtx;\n", ShaderAttrib::PositionMatrix);
+    else
+      out.Write("ATTRIBUTE_LOCATION({:s}) in float4 posmtx;\n", ShaderAttrib::PositionMatrix);
 #else
     out.Write("ATTRIBUTE_LOCATION({:s}) in uint4 posmtx;\n", ShaderAttrib::PositionMatrix);
 #endif
