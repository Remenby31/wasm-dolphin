+// Patch 0163: the update forms of the FP loads and stores (lfsu, lfdu,
+// stfsu, stfdu and their x forms) write rA only when the access ran. At an
+// address that is not a multiple of 4 the interpreter raises the alignment
+// exception and returns before the update; the exception stays pending (it
+// does not stop the instruction, Interpreter.cpp), so the code goes on and
+// rA must keep its old value. A DSI halts before this point.
+void EmitFloatUpdateRa(std::vector<u8>& body, const WasmStateLayout& layout, UGeckoInstruction inst)
+{
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 3);
+  body.push_back(0x71);  // i32.and
+  body.push_back(0x45);  // i32.eqz
+  HintNextIf(body, true);  // aligned
+  body.push_back(0x04);
+  body.push_back(0x40);
+  EmitStateStoreU32Prefix(body);
+  EmitLocalGet(body, 1);
+  EmitStateStoreU32Suffix(body, GprOffset(layout, inst.RA));
+  body.push_back(0x0b);
+}
