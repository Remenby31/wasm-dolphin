+// 0195 tests: where the next burst goes (the CPU FIFO's write pointer).
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_GatherPipeFifoForTest()
+{
+  return Core::System::GetInstance().GetProcessorInterface().m_fifo_cpu_write_pointer;
+}
+
+// 0195 tests: the gather pipe's pending bytes (copied to `out`, at most
+// `capacity`) and their count; `reset` 1 sets it up empty first (GPFifo::Init:
+// the test CPU set-up does not run the hardware's init), 2 flushes its whole
+// 32-byte bursts first (GPFifo::FastCheckGatherPipe: the JIT flushes late,
+// the interpreter at every burst; the bytes are the same).
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_GatherPipeForTest(int reset, u8* out, u32 capacity)
+{
+  auto& system = Core::System::GetInstance();
+  if (reset == 1)
+  {
+    system.GetGPFifo().Init();
+    // The CPU FIFO the bursts go to: 64 KiB at RAM 1 MiB, written in order.
+    auto& pi = system.GetProcessorInterface();
+    pi.m_fifo_cpu_base = 0x00100000;
+    pi.m_fifo_cpu_end = 0x0010ffe0;
+    pi.m_fifo_cpu_write_pointer = pi.m_fifo_cpu_base;
+  }
+  else if (reset == 2)
+    system.GetGPFifo().FastCheckGatherPipe();
+  const auto& ppc = system.GetPPCState();
+  const u32 count = static_cast<u32>(ppc.gather_pipe_ptr - ppc.gather_pipe_base_ptr);
+  if (out)
+    std::memcpy(out, ppc.gather_pipe_base_ptr, std::min(count, capacity));
+  return count;
+}
