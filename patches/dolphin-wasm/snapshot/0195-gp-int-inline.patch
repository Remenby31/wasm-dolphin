+// 0195: the slow arm of an integer store (value in local 2, EA in local 1):
+// to the gather pipe in line when the address is the pipe's (the float
+// stores' test, EmitGatherPipeFloatStoreCondition, without MSR.FP: the
+// physical page 0x0C008000 under the standard BATs or in real mode, LE off),
+// else the write import. MMU::Write takes the same page to GPFifo::Write*
+// whatever the alignment; the pipe is flushed at every 32 bytes as
+// GPFifo::Write* does (FastCheckGatherPipe: CheckGatherPipe without the JIT's
+// recompile hint).
+void EmitWriteSlowArm(std::vector<u8>& body, const WasmStateLayout& layout, u32 size,
+                      u32 import_index)
+{
+  const auto call = [&] {
+    EmitLocalGet(body, 0);
+    EmitLocalGet(body, 1);
+    EmitLocalGet(body, 2);
+    EmitCallImport(body, import_index);
+  };
+  if ((DolphinWebDisableMask() & DOLPHIN_WEB_ENABLE_GP_INT_INLINE) == 0)
+  {
+    call();
+    return;
+  }
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 0x0ffff000);
+  body.push_back(0x71);  // i32.and
+  EmitI32Const(body, GPFifo::GATHER_PIPE_PHYSICAL_ADDRESS);
+  body.push_back(0x46);  // i32.eq
+  if (!RegionGuardsActive())
+  {
+    EmitStateLoadU32(body, layout.msr_offset);
+    EmitI32Const(body, 1);  // LE
+    body.push_back(0x71);
+    body.push_back(0x45);  // i32.eqz
+    body.push_back(0x71);  // i32.and
+  }
+  body.insert(body.end(), {0x04, 0x40});  // if
+  if (size == 4)
+  {
+    EmitStoreU32BigEndianToGatherPipe(body, layout);
+  }
+  else
+  {
+    if (size == 2)
+      EmitBswap16FromLocal(body, 2);
+    else
+      EmitLocalGet(body, 2);
+    EmitLocalSet(body, 3);
+    EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+    EmitLocalGet(body, 3);
+    body.push_back(size == 2 ? 0x3b : 0x3a);  // i32.store16 / i32.store8
+    body.push_back(0x00);
+    EmitU32Leb(body, 0);
+    EmitStateStoreU32Prefix(body);
+    EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+    EmitI32Const(body, size);
+    body.push_back(0x6a);
+    EmitStateStoreU32Suffix(body, layout.gather_pipe_ptr_offset);
+  }
+  // Flushed at every 32-byte burst, as GPFifo::Write* does (CheckGatherPipe),
+  // not near the end of the pipe's buffer as after a float store: games write
+  // their sync commands (tokens, draw done) with integer stores and then wait
+  // for the GPU, which must have received them (measured: with the late
+  // flush no game frame came, rendering frozen).
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitStateLoadU32(body, layout.gather_pipe_base_ptr_offset);
+  body.push_back(0x6b);  // i32.sub
+  EmitI32Const(body, GPFifo::GATHER_PIPE_SIZE);
+  body.push_back(0x4f);  // i32.ge_u
+  body.insert(body.end(), {0x04, 0x40});  // if
+  EmitLocalGet(body, 0);
+  EmitI32Const(body, 0);
+  EmitI32Const(body, 0);
+  EmitCallImport(body, WASM_IMPORT_FASTCHECK_GPFIFO_INDEX);
+  body.push_back(0x0b);  // end
+  body.push_back(0x05);  // else
+  call();
+  body.push_back(0x0b);  // end
+}
