+#ifdef __EMSCRIPTEN__
+std::optional<const AbstractPipeline*> VertexManagerBase::WaitForSpecializedPipeline()
+{
+  const double budget_us = s_uber_wait_us_budget.load(std::memory_order_relaxed);
+  const double left_us = budget_us - m_uber_wait_frame_us;
+  if (!(left_us > 0))
+    return std::nullopt;
+  const double start = emscripten_get_now();
+  std::optional<const AbstractPipeline*> res;
+  bool blocked = false;
+  for (;;)
+  {
+    // the wake count before the retrieve: work finishing after it wakes the
+    // wait below at once (nothing is missed between the two)
+    const u64 seen = g_shader_cache->AsyncWakeCount();
+    // retrieve what already finished (shaders, then the pipeline item the
+    // retrieve re-queues), then look again
+    g_shader_cache->RetrieveAsyncShaders();
+    res = g_shader_cache->GetPipelineForUidAsync(m_current_pipeline_config);
+    const double spent_us = (emscripten_get_now() - start) * 1000;
+    if (res || spent_us >= left_us)
+      break;
+    // sleep until an item that did real work finishes, or the budget ends:
+    // expired, no retrieve and no look again (that would run past the budget)
+    blocked = true;
+    if (!g_shader_cache->WaitForAsyncWake(seen, (left_us - spent_us) / 1000))
+      break;
+    s_uber_wait_wakeups.fetch_add(1, std::memory_order_relaxed);
+  }
+  const double spent_us = (emscripten_get_now() - start) * 1000;
+  m_uber_wait_frame_us += spent_us;
+  const u32 w = static_cast<u32>(spent_us);
+  s_uber_wait_us_sum.fetch_add(w, std::memory_order_relaxed);
+  u32 prev = s_uber_wait_us_max.load(std::memory_order_relaxed);
+  while (w > prev && !s_uber_wait_us_max.compare_exchange_weak(prev, w, std::memory_order_relaxed))
+  {
+  }
+  const bool got = res.has_value() && *res != nullptr;
+  if (blocked)
+  {
+    s_uber_waits.fetch_add(1, std::memory_order_relaxed);
+    if (got)
+    {
+      s_uber_wait_hits.fetch_add(1, std::memory_order_relaxed);
+      s_uber_wait_hit_us_sum.fetch_add(w, std::memory_order_relaxed);
+      u32 hp = s_uber_wait_hit_us_max.load(std::memory_order_relaxed);
+      while (w > hp && !s_uber_wait_hit_us_max.compare_exchange_weak(hp, w, std::memory_order_relaxed))
+      {
+      }
+    }
+    else
+    {
+      s_uber_wait_miss_us_sum.fetch_add(w, std::memory_order_relaxed);
+    }
+  }
+  else if (got)
+  {
+    s_uber_retrieve_hits.fetch_add(1, std::memory_order_relaxed);
+  }
+  // as 0223: a ready result is used as it is (a failed compile included)
+  return res;
+}
+#endif
