+#ifdef __EMSCRIPTEN__
+std::optional<const AbstractPipeline*> VertexManagerBase::WaitForSpecializedPipeline()
+{
+  const double budget_us = s_uber_wait_us_budget.load(std::memory_order_relaxed);
+  const double left_us = budget_us - m_uber_wait_frame_us;
+  if (!(left_us > 0))
+    return std::nullopt;
+  const double start = emscripten_get_now();
+  std::optional<const AbstractPipeline*> res;
+  for (;;)
+  {
+    // retrieve what already finished (shaders, then the pipeline item the
+    // retrieve re-queues), then look again
+    g_shader_cache->RetrieveAsyncShaders();
+    res = g_shader_cache->GetPipelineForUidAsync(m_current_pipeline_config);
+    const double waited_us = (emscripten_get_now() - start) * 1000;
+    if (res || waited_us >= left_us)
+      break;
+    g_shader_cache->WaitForAsyncCompletion((left_us - waited_us) / 1000);
+  }
+  const double waited_us = (emscripten_get_now() - start) * 1000;
+  m_uber_wait_frame_us += waited_us;
+  const u32 w = static_cast<u32>(waited_us);
+  s_uber_wait_us_sum.fetch_add(w, std::memory_order_relaxed);
+  u32 prev = s_uber_wait_us_max.load(std::memory_order_relaxed);
+  while (w > prev && !s_uber_wait_us_max.compare_exchange_weak(prev, w, std::memory_order_relaxed))
+  {
+  }
+  s_uber_waits.fetch_add(1, std::memory_order_relaxed);
+  if (res)
+    s_uber_wait_hits.fetch_add(1, std::memory_order_relaxed);
+  return res;
+}
+#endif
