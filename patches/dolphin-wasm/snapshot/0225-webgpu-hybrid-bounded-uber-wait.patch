+// Patch 0225: the bounded wait, T in ms (0..50; 0 = none). Set by the web core
+// from ?uberwait before the video backend starts.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetUberWaitMs(int ms)
+{
+  s_uber_wait_us_budget.store(static_cast<u32>(std::clamp(ms, 0, 50)) * 1000,
+                              std::memory_order_relaxed);
+  // shaders retrieved before pipelines only while the wait is on (T = 0: 0223's order)
+  VideoCommon::AsyncShaderCompiler::SetRetrieveShadersFirst(ms > 0);
+}
+
+// Patch 0225, cumulative: out[0] us spent (sum), [1] longest call (us),
+// [2] calls that blocked, [3] specialized pipelines got after blocking,
+// [4] T (ms), [5] got from the first retrieve without blocking, [6] wake-ups,
+// [7] us of the blocked calls that got it (sum), [8] the longest of those (us),
+// [9] us of the blocked calls that did not (sum).
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_UberWaitStats(double* out)
+{
+  out[0] = static_cast<double>(s_uber_wait_us_sum.load(std::memory_order_relaxed));
+  out[1] = s_uber_wait_us_max.load(std::memory_order_relaxed);
+  out[2] = s_uber_waits.load(std::memory_order_relaxed);
+  out[3] = s_uber_wait_hits.load(std::memory_order_relaxed);
+  out[4] = s_uber_wait_us_budget.load(std::memory_order_relaxed) / 1000.0;
+  out[5] = s_uber_retrieve_hits.load(std::memory_order_relaxed);
+  out[6] = s_uber_wait_wakeups.load(std::memory_order_relaxed);
+  out[7] = static_cast<double>(s_uber_wait_hit_us_sum.load(std::memory_order_relaxed));
+  out[8] = s_uber_wait_hit_us_max.load(std::memory_order_relaxed);
+  out[9] = static_cast<double>(s_uber_wait_miss_us_sum.load(std::memory_order_relaxed));
+}
+
 // Cumulative: [0] flushes drawn through the two passes, [1] extra draws (the
