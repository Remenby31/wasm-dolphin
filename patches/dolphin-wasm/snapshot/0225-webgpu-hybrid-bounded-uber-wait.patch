+bool AsyncShaderCompiler::WaitForCompletedWork(double timeout_ms)
+{
+  std::unique_lock lock(m_completed_work_lock);
+  if (!m_completed_work.empty())
+    return true;
+  if (!(timeout_ms > 0))
+    return false;
+  return m_completed_work_cv.wait_for(lock,
+                                      std::chrono::microseconds(static_cast<s64>(timeout_ms * 1000)),
+                                      [this] { return !m_completed_work.empty(); });
+}
