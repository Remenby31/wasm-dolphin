+#ifdef __EMSCRIPTEN__
+// Patch 0225 (?uberwait=T, hybrid mode only): the GPU thread waits at most T ms
+// per frame (a budget over all of the frame's draws, never T per draw) for a
+// specialized pipeline the async compiler is making, retrieving finished work
+// as soon as it lands instead of only at the end of the frame; past the budget
+// the draw takes the ubershader pipeline, as 0223 does. T = 0 (the default):
+// no wait and no early retrieve, exactly 0223. The thread sleeps on the async
+// compiler's count of items that did real work (a pipeline item whose shaders
+// were not ready finishes as a no-op and never wakes it), so it never spins.
+// Counters: the time spent (sum, max of one call), the calls that blocked at
+// least once (waits), those that got a real specialized pipeline (hits; a
+// failed compile, a null pipeline, is not one), those that got it from the
+// first retrieve without blocking (early retrieve hits), and the wake-ups.
+static std::atomic<u32> s_uber_wait_us_budget{0};
+static std::atomic<u64> s_uber_wait_us_sum{0};
+static std::atomic<u32> s_uber_wait_us_max{0};
