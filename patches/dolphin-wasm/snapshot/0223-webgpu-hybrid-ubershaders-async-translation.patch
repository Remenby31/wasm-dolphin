+
+// Patch 0223: the window of draws since the previous VI tag closes here.
+static void CloseUberViWindow(u32 vi_since_load, u32 load_generation, u32 draws)
+{
+  if (s_uber_last_generation.exchange(load_generation, std::memory_order_relaxed) !=
+      load_generation)
+    s_uber_frames_since_load.store(0, std::memory_order_relaxed);
+  if (draws > 0)
+  {
+    s_uber_frames.fetch_add(1, std::memory_order_relaxed);
+    s_uber_frames_since_load.fetch_add(1, std::memory_order_relaxed);
+  }
+  // VI tags come from the GPU thread only: one allocation, then published.
+  UberViSlot* ring = s_uber_vi_ring.load(std::memory_order_acquire);
+  if (!ring)
+  {
+    ring = new UberViSlot[UBER_VI_RING];
+    s_uber_vi_ring.store(ring, std::memory_order_release);
+  }
+  UberViSlot& slot = ring[vi_since_load % UBER_VI_RING];
+  slot.draws.store(draws, std::memory_order_relaxed);
+  slot.generation.store(load_generation, std::memory_order_relaxed);
+  slot.vi.store(vi_since_load, std::memory_order_release);
+}
+
+// Patch 0223: the uber draws of the windows that closed at vi_since_load and
+// at the tag before it (the picture shown at a VI was drawn in the window
+// before it or in its own: both are counted, a conservative "the captured
+// picture may hold an uber draw"). out[0] found (1, or 0 when either slot was
+// overwritten or never written in this load), out[1] that window, out[2] the
+// one before, out[3] the load generation.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_UberDrawsAtVi(u32 vi_since_load, u32* out)
+{
+  const u32 gen = s_uber_last_generation.load(std::memory_order_relaxed);
+  const UberViSlot* ring = s_uber_vi_ring.load(std::memory_order_acquire);
+  u32 found = ring ? 1 : 0, cur = 0, prev = 0;
+  for (u32 k = 0; k < 2; ++k)
+  {
+    if (!ring || vi_since_load < k)
+      continue;
+    const u32 vi = vi_since_load - k;
+    const UberViSlot& slot = ring[vi % UBER_VI_RING];
+    if (slot.vi.load(std::memory_order_acquire) != vi ||
+        slot.generation.load(std::memory_order_relaxed) != gen)
+    {
+      found = 0;
+      continue;
+    }
+    (k == 0 ? cur : prev) = slot.draws.load(std::memory_order_relaxed);
+  }
+  out[0] = found;
+  out[1] = cur;
+  out[2] = prev;
+  out[3] = gen;
+}
