+u32 WebGPUGfx::PushPendingShader(const AbstractShader* shader)
+{
+  const auto* s = static_cast<const WebGPUShader*>(shader);
+  if (!s)
+    return 0;
+  if (s->IsPending() && m_cmd_stream.ready())
+  {
+    const u32 id = m_cmd_stream.PushCreateShader(s->GetWgsl().data(), s->GetWgsl().size(),
+                                                 static_cast<u32>(s->GetStage()));
+    if (id != 0)
+      m_shader_ok.fetch_add(1, std::memory_order_relaxed);
+    else
+      m_shader_fail.fetch_add(1, std::memory_order_relaxed);
+    // A failed push (ring full) stays failed, as in the synchronous path.
+    s->SetPushed(id);
+  }
+  return s->GetBridgeId();
+}
+
+u32 WebGPUGfx::PushPendingPipeline(const AbstractPipeline* pipeline)
+{
+  const auto* p = static_cast<const WebGPUPipeline*>(pipeline);
+  if (!p)
+    return 0;
+  if (p->IsPending() && m_cmd_stream.ready())
+  {
+    // Order in the ring: the shaders' CreateShader, then CreatePipelineCfg,
+    // then (the caller's draw) SetPipeline. The replay worker sees them in it.
+    const u32 vs_id = PushPendingShader(p->m_config.vertex_shader);
+    const u32 fs_id = PushPendingShader(p->m_config.pixel_shader);
+    u32 id = 0;
+    if (vs_id != 0 && fs_id != 0)
+    {
+      const std::vector<u8> blob = SerializePipelineConfig(p->m_config, vs_id, fs_id);
+      id = m_cmd_stream.PushCreatePipelineCfg(blob.data(), blob.size());
+    }
+    p->SetPushed(id);
+  }
+  return p->GetBridgeId();
+}
