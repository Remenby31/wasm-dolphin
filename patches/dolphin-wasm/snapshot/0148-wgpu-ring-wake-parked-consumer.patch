+// The consumer parks by setting kProtocolConsumerParked, then waiting on the
+// write index for the value it last saw; the producer stores the write index,
+// then reads the bit. Both sides are sequentially consistent, so either the
+// producer sees the bit and notifies, or the consumer's wait sees the new
+// write index and returns at once: no wakeup is lost.
+void WebGPUCommandStream::WakeParkedConsumer()
+{
+  if ((m_header->protocol_flags.load(std::memory_order_seq_cst) & kProtocolConsumerParked) == 0)
+    return;
+  emscripten_futex_wake(reinterpret_cast<volatile void*>(&m_header->write), INT_MAX);
+}
