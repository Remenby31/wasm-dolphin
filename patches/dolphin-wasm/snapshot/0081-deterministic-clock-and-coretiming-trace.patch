diff --git a/Source/Core/Core/WasmDetTrace.h b/Source/Core/Core/WasmDetTrace.h
new file mode 100644
index 0000000..02686bd
--- /dev/null
+++ b/Source/Core/Core/WasmDetTrace.h
@@ -0,0 +1,82 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// Harness diagnostics for emulation determinism (dolphin_web_discio.cpp,
+// validationReadDetTrace): every CoreTiming event the CPU thread runs, and
+// every event another thread schedules, in order, with its emulated time and
+// how late it ran. Two runs of one boot that should be identical are compared
+// on this log: the first entry that differs names what host timing reached.
+// Off unless a harness session asks (?dettrace=1); then one relaxed load per
+// event and a few stores.
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+namespace DolphinWeb::DetTrace
+{
+enum Kind : std::uint32_t
+{
+  Run = 0,        // the CPU thread ran the event (time, late = cycles late)
+  Moved = 1,      // an off-thread event got its emulated time (time; late = 0)
+  OffThread = 2,  // another thread scheduled it (time = cycles into the future)
+};
+
+struct Entry
+{
+  std::uint64_t time;
+  std::int64_t late;
+  std::uintptr_t name;  // const std::string* of the event type (resolved on read)
+  std::uint32_t kind;
+};
+static_assert(sizeof(Entry) == 24 || sizeof(std::uintptr_t) != 4, "the worker reads 24-byte entries");
+
+inline constexpr std::uint32_t kLogCapacity = 1u << 18;
+
+inline std::atomic<bool> s_enabled{false};
+inline std::array<Entry, kLogCapacity> s_log{};
+inline std::atomic<std::uint32_t> s_log_count{0};
+inline std::atomic<std::uint64_t> s_hash{1469598103934665603ull};
+inline std::atomic<std::uint64_t> s_events{0};
+
+inline bool Enabled()
+{
+  return s_enabled.load(std::memory_order_relaxed);
+}
+
+inline void Record(Kind kind, const std::string* name, std::uint64_t time, std::int64_t late)
+{
+  if (!Enabled())
+    return;
+  // A slot per entry, whichever thread records it.
+  const std::uint32_t n = s_log_count.fetch_add(1, std::memory_order_relaxed);
+  if (n < kLogCapacity)
+    s_log[n] = Entry{time, late, reinterpret_cast<std::uintptr_t>(name), kind};
+  if (kind == OffThread)
+    return;  // another thread, at a host-timed moment: hashed when Moved
+  // From here on, the CPU thread only.
+  // The name's characters, not its address: equal runs must hash equal.
+  std::uint64_t h = s_hash.load(std::memory_order_relaxed);
+  if (name)
+    for (const char c : *name)
+      h = (h ^ static_cast<unsigned char>(c)) * 1099511628211ull;
+  for (const std::uint64_t v : {std::uint64_t{kind}, time, static_cast<std::uint64_t>(late)})
+    h = (h ^ v) * 1099511628211ull;
+  s_hash.store(h, std::memory_order_relaxed);
+  s_events.fetch_add(1, std::memory_order_relaxed);
+}
+
+inline void Enable(bool on)
+{
+  if (on)
+  {
+    s_log_count.store(0, std::memory_order_relaxed);
+    s_hash.store(1469598103934665603ull, std::memory_order_relaxed);
+    s_events.store(0, std::memory_order_relaxed);
+  }
+  s_enabled.store(on, std::memory_order_release);
+}
+}  // namespace DolphinWeb::DetTrace
