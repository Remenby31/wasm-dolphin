+void RetryOffThreadWasmBlocks(CachedInterpreter& cpu)
+{
+  // A few waiting blocks per slice, round robin: ready ones are erased so the
+  // next dispatch recompiles them (in place); stale ones (block gone or
+  // replaced) are dropped.
+  auto& waiting = s_wasm_off_thread_waiting;
+  for (int checked = 0; checked < 32 && !waiting.empty(); ++checked)
+  {
+    if (s_wasm_off_thread_cursor >= waiting.size())
+      s_wasm_off_thread_cursor = 0;
+    const OffThreadWait entry = waiting[s_wasm_off_thread_cursor];
+    auto* cache = cpu.GetBlockCache();
+    auto* block = cache->GetBlockFromStartAddress(entry.address,
+                                                  static_cast<CPUEmuFeatureFlags>(entry.features));
+    const bool stale = !block || block->normalEntry != entry.normal_entry;
+    const bool ready = s_wasm_jit_ready_bits[entry.bit].load(std::memory_order_acquire) != 0 ||
+                       ++waiting[s_wasm_off_thread_cursor].checks > 4096;
+    if (!stale && !ready)
+    {
+      ++s_wasm_off_thread_cursor;
+      continue;
+    }
+    if (!stale)
+    {
+      s_wasm_off_thread_in_place.insert((u64{entry.features} << 32) | entry.address);
+      cache->EraseSingleBlock(*block);
+    }
+    waiting[s_wasm_off_thread_cursor] = waiting.back();
+    waiting.pop_back();
+  }
+}
