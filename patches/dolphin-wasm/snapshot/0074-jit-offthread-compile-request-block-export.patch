+static void ServiceBlockDumpRequest(CachedInterpreter& jit)
+{
+  const u32 wanted = s_block_dump_requested.load(std::memory_order_acquire);
+  if (wanted == s_block_dump_done.load(std::memory_order_relaxed))
+    return;
+  s_block_dump.clear();
+  const Core::CPUThreadGuard guard(Core::System::GetInstance());  // CPU thread: no pause
+  jit.GetBlockCache()->RunOnBlocks(guard, [](const JitBlock& block) {
+    const u32 flags = 1u | ((block.feature_flags & FEATURE_FLAG_MSR_IR) ? 0u : 4u);
+    s_block_dump.insert(s_block_dump.end(), {block.effectiveAddress, block.originalSize * 4, flags});
+  });
+  s_block_dump_done.store(wanted, std::memory_order_release);
