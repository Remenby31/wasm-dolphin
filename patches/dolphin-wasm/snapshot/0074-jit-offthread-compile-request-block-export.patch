+// Executed-block export for the first-launch profile (docs/aot-plan.md).
+// The worker asks with DolphinWeb_JitDumpBlocksRequest(); the CPU thread
+// fills the buffer at its next slice boundary, so the block map is read on
+// its own thread without pausing emulation; the worker polls
+// until DolphinWeb_JitDumpBlocksDone() >= the sequence it got (a later
+// request may be served in the same pass), then reads
+// DolphinWeb_JitDumpBlocksCount() triplets {effective address, PPC byte
+// length, flags} at DolphinWeb_JitDumpBlocksBuffer(). flags: bit 0 executed
+// (every cached block was dispatched: a dispatch miss creates it), bit 1
+// reserved, bit 2 real mode (MSR.IR clear). The cache is cleared on icbi and
+// state loads: dump periodically and merge.
+static std::atomic<u32> s_block_dump_requested{0};
+static std::atomic<u32> s_block_dump_done{0};
+static std::vector<u32> s_block_dump;
