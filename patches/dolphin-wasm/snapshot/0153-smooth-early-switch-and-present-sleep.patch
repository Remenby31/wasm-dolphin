diff --git a/Source/Core/Core/CoreTiming.cpp b/Source/Core/Core/CoreTiming.cpp
index d8041e2..c2ab050 100644
--- a/Source/Core/Core/CoreTiming.cpp
+++ b/Source/Core/Core/CoreTiming.cpp
@@ -62,21 +62,37 @@ namespace DolphinWeb
 // Patch 0150 (?dupvsync=1): a duplicated XFB rearms the Rush throttle as a
 // presented one does (Presenter::ViSwap).
 std::atomic<bool> g_dup_xfb_rearms_throttle{false};
+// Patch 0153 (?smoothearly=0): the video thread presents on arrival, without
+// the sleep to the present's time (Present.cpp). SmoothEarlyPresentation off
+// alone does not do it: with Rush off, upstream's GetUpdatedPresentationTime
+// still returns the intended time, and the thread sleeps until it.
+std::atomic<bool> g_present_on_arrival{false};
 }  // namespace DolphinWeb
 
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetPresentOnArrival(int on)
+{
+  DolphinWeb::g_present_on_arrival.store(on != 0, std::memory_order_relaxed);
+}
+
 extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetDupXfbRearmsThrottle(int on)
 {
   DolphinWeb::g_dup_xfb_rearms_throttle.store(on != 0, std::memory_order_relaxed);
 }
 
 // The pacing settings the core runs with, from its effective config: bit 0
-// SyncOnSkipIdle, bit 1 Rush Frame Presentation, bit 2 the 0150 rearm. The
-// harness reads it (validationReadPacingConfig) to know a switch was applied.
+// SyncOnSkipIdle, bit 1 Rush Frame Presentation, bit 2 the 0150 rearm, bit 3
+// the video thread's present sleep (0153: SmoothEarlyPresentation on and not
+// presenting on arrival; ?smoothearly=0 clears it). The harness reads it
+// (validationReadPacingConfig) to know a switch was applied.
 extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_PacingConfig()
 {
   return (Config::Get(Config::MAIN_SYNC_ON_SKIP_IDLE) ? 1u : 0u) |
          (Config::Get(Config::MAIN_RUSH_FRAME_PRESENTATION) ? 2u : 0u) |
-         (DolphinWeb::g_dup_xfb_rearms_throttle.load(std::memory_order_relaxed) ? 4u : 0u);
+         (DolphinWeb::g_dup_xfb_rearms_throttle.load(std::memory_order_relaxed) ? 4u : 0u) |
+         (Config::Get(Config::MAIN_SMOOTH_EARLY_PRESENTATION) &&
+                  !DolphinWeb::g_present_on_arrival.load(std::memory_order_relaxed) ?
+              8u :
+              0u);
 }
 #endif
 
