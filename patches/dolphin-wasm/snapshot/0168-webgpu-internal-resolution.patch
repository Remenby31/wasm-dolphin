+bool WebGPUCommandStream::PushBackbufferSize(u32 w, u32 h)
+{
+  if (!m_header || w == 0 || h == 0)
+    return false;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::BackbufferSize);
+  rec.arg.u[0] = w;
+  rec.arg.u[1] = h;
+  return Push(rec);
+}
