   // ends + submits.
   m_cmd_stream.EnsureRing();
   EndPassIfOpen();
+  // Patch 0168: the consumer sizes the canvas from the backbuffer the
+  // presenter laid out, before the first pass at a new size.
+  const SurfaceInfo surface = GetSurfaceInfo();
+  if ((surface.width != m_announced_backbuffer_w || surface.height != m_announced_backbuffer_h) &&
+      m_cmd_stream.ready() && m_cmd_stream.PushBackbufferSize(surface.width, surface.height))
+  {
+    m_announced_backbuffer_w = surface.width;
+    m_announced_backbuffer_h = surface.height;
+  }
   m_fb_color_id = 0;
   m_fb_depth_id = 0;
   m_clear_col[0] = clear_color[0];
@@ -2684,9 +2694,25 @@
   // incompatible with the bgra8unorm canvas pass ("Attachment state
   // ... not compatible"), so the blit silently failed and nothing
   // presented. Must match the consumer's context format.
-  return {640, 480, 1.0f, AbstractTextureFormat::BGRA8};
+  //
+  // Internal resolution (patch 0168): the EFB and the XFB copies are N times
+  // native, so the backbuffer the XFB is blitted into is too; at 640x480 the
+  // presenter would average the extra pixels away. BindBackbuffer tells the
+  // consumer, which sizes the canvas to match. The core allows 1 to 4.
+  const u32 scale = static_cast<u32>(std::clamp(g_ActiveConfig.iEFBScale, 1, 4));
+  return {640 * scale, 480 * scale, 1.0f, AbstractTextureFormat::BGRA8};
 }
 
+void WebGPUGfx::OnConfigChanged(u32 changed_bits)
+{
+  AbstractGfx::OnConfigChanged(changed_bits);
+  // A new internal resolution: lay the presenter out on the new backbuffer
+  // now, as other backends do when their surface resizes. The next
+  // BindBackbuffer announces the size before drawing into it.
+  if ((changed_bits & CONFIG_CHANGE_BIT_TARGET_SIZE) && g_presenter)
+    g_presenter->SetBackbuffer(GetSurfaceInfo());
+}
