+// Patch 0117: only while stats are on (blocks emitted before are dropped
+// with the cache at the reset); a wasm block's count stands before it (a
+// halted run counts too), an interpreted one's before its EndBlock.
+void CachedInterpreter::WriteCountMemBlock(bool wasm)
