+#ifdef __EMSCRIPTEN__
+namespace
+{
+// Patch 0138: the code space (callbacks and operands only, the WASM bodies
+// live in their own modules) is 32 MiB instead of Jit64's 128 MiB. Under
+// Emscripten the allocation is a memalign + memset that dirties all of it at
+// boot. ?codespace=<MiB> (DolphinWeb_SetCodeSpaceMiB, before the boot) sets
+// it for a measurement. Counters in GetPpcWasmHelperStats: cache clears in
+// all, those because the space was full, and the highest offset written.
+std::atomic<u32> s_code_space_mib{32};
+std::atomic<u32> s_code_clears{0};
+std::atomic<u32> s_code_full_clears{0};
+std::atomic<u32> s_code_high_kib{0};
+}  // namespace
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetCodeSpaceMiB(int mib)
+{
+  if (mib >= 4 && mib <= 128)
+    s_code_space_mib.store(static_cast<u32>(mib), std::memory_order_relaxed);
+}
+#endif
