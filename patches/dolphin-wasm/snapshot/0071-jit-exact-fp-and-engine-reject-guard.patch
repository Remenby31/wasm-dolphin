+// Interpreter-vs-JIT differential oracle. One program (PowerPC words placed at
+// 0x80003000, ending in a return to the sentinel held in LR) and one input
+// state go in; the program then runs twice from that state: once with the
+// interpreter, once through the same block pipeline as the CPU thread
+// (analyzer, direct-candidate prefix, BuildWasmCachedInterpreterBlock, engine
+// compile, RunWasmBlock semantics, interpreter for what is not compiled). Both
+// final states are written out for the caller to compare. Used by
+// tests/jit-oracle.test.mjs in Node, where the same engine as Chrome runs the
+// generated modules.
+namespace
+{
+constexpr u32 JIT_ORACLE_CODE_VA = 0x80003000;
+constexpr u32 JIT_ORACLE_SENTINEL_VA = 0x80002000;
+constexpr u32 JIT_ORACLE_SCRATCH_VA = 0x80100000;
+constexpr u32 JIT_ORACLE_SCRATCH_BYTES = 256;
+constexpr u32 JIT_ORACLE_MAX_WORDS = 256;
+constexpr u32 JIT_ORACLE_STATE_WORDS = 240;
+constexpr u32 JIT_ORACLE_STEP_LIMIT = 20000;
+// Memory both runs start from and are compared on, beyond the scratch bytes
+// that travel in the state words: update forms drift their base around it.
+constexpr u32 JIT_ORACLE_WINDOW_VA = JIT_ORACLE_SCRATCH_VA - 0x800;
+constexpr u32 JIT_ORACLE_WINDOW_BYTES = 0x1000;
+
+struct JitOracleBuffer
+{
+  u32 program[JIT_ORACLE_MAX_WORDS];
+  u32 input[JIT_ORACLE_STATE_WORDS];
+  u32 interp[JIT_ORACLE_STATE_WORDS];
+  u32 jit[JIT_ORACLE_STATE_WORDS];
+  // compiled blocks, compiled ops, interpreted blocks, engine rejects
+  u32 stats[4];
+};
+JitOracleBuffer s_jit_oracle{};
+std::array<u8, JIT_ORACLE_WINDOW_BYTES> s_jit_oracle_window_start{};
+std::array<u8, JIT_ORACLE_WINDOW_BYTES> s_jit_oracle_window_interp{};
+// SPRs outside the state words (SPRG, SRR, HID, ...) restart from this copy
+// for each run, so the JIT run never sees what the interpreter run wrote.
+std::array<u32, 1024> s_jit_oracle_spr{};
+std::string s_jit_oracle_message;
+
+// State words: 0-31 GPR, 32 CR, 33 XER, 34 LR, 35 CTR, 36 FPSCR, 37 MSR,
+// 38-45 GQR0-7, 46 pending exceptions, 47 PC, 48-175 PS0/PS1 bits per FPR
+// (low word first), 176-239 the scratch bytes at JIT_ORACLE_SCRATCH_VA.
+void JitOracleLoadState(Core::System& system, const u32* in)
+{
+  auto& ppc = system.GetPPCState();
+  std::copy(s_jit_oracle_spr.begin(), s_jit_oracle_spr.end(), ppc.spr);
+  for (u32 i = 0; i < 32; ++i)
+    ppc.gpr[i] = in[i];
+  ppc.cr.Set(in[32]);
+  ppc.SetXER(UReg_XER{in[33]});
+  LR(ppc) = in[34];
+  CTR(ppc) = in[35];
+  ppc.fpscr.Hex = in[36];
+  ppc.msr.Hex = in[37];
+  for (u32 i = 0; i < 8; ++i)
+    ppc.spr[SPR_GQR0 + i] = in[38 + i];
+  ppc.Exceptions = 0;
+  ppc.pc = JIT_ORACLE_CODE_VA;
+  ppc.npc = JIT_ORACLE_CODE_VA;
+  for (u32 i = 0; i < 32; ++i)
+  {
+    const u32* w = &in[48 + i * 4];
+    ppc.ps[i].SetBoth(u64{w[0]} | (u64{w[1]} << 32), u64{w[2]} | (u64{w[3]} << 32));
+  }
+  std::memcpy(system.GetMemory().GetRAM() + (JIT_ORACLE_SCRATCH_VA & 0x01ffffff), &in[176],
+              JIT_ORACLE_SCRATCH_BYTES);
+  ppc.downcount = 0x7fffffff;
+}
+
+void JitOracleSaveState(Core::System& system, u32* out)
+{
+  auto& ppc = system.GetPPCState();
+  for (u32 i = 0; i < 32; ++i)
+    out[i] = ppc.gpr[i];
+  out[32] = ppc.cr.Get();
+  out[33] = ppc.GetXER().Hex;
+  out[34] = LR(ppc);
+  out[35] = CTR(ppc);
+  out[36] = ppc.fpscr.Hex;
+  out[37] = ppc.msr.Hex;
+  for (u32 i = 0; i < 8; ++i)
+    out[38 + i] = ppc.spr[SPR_GQR0 + i];
+  out[46] = ppc.Exceptions;
+  out[47] = ppc.pc;
+  for (u32 i = 0; i < 32; ++i)
+  {
+    const u64 a = ppc.ps[i].PS0AsU64(), b = ppc.ps[i].PS1AsU64();
+    u32* w = &out[48 + i * 4];
+    w[0] = static_cast<u32>(a);
+    w[1] = static_cast<u32>(a >> 32);
+    w[2] = static_cast<u32>(b);
+    w[3] = static_cast<u32>(b >> 32);
+  }
+  std::memcpy(&out[176], system.GetMemory().GetRAM() + (JIT_ORACLE_SCRATCH_VA & 0x01ffffff),
+              JIT_ORACLE_SCRATCH_BYTES);
+}
+
+bool JitOracleSetUp(Core::System& system)
+{
+  // The interpreter's FPSCR writes assert they run on the CPU thread.
+  Core::DeclareAsCPUThread();
+  auto& memory = system.GetMemory();
+  if (!memory.GetRAM())
+    memory.Init();
+  if (!memory.GetRAM())
+    return false;
+  auto& ppc = system.GetPPCState();
+  // The BATs libogc programs run under: 0x80000000 cached and 0xC0000000
+  // uncached views of MEM1, translation on, paired singles enabled.
+  for (const u32 base : {SPR_IBAT0U, SPR_DBAT0U})
+  {
+    ppc.spr[base] = 0x80001fff;
+    ppc.spr[base + 1] = 0x00000002;
+  }
+  ppc.spr[SPR_DBAT1U] = 0xc0001fff;
+  ppc.spr[SPR_DBAT1U + 1] = 0x0000002a;
+  ppc.spr[SPR_HID2] = 0xa0000000;
+  HID0(ppc).DCE = 1;  // as libogc leaves it; dcbz raises an alignment exception otherwise
+  system.GetMMU().DBATUpdated();
+  system.GetMMU().IBATUpdated();
+  std::copy(ppc.spr, ppc.spr + s_jit_oracle_spr.size(), s_jit_oracle_spr.begin());
+  return true;
+}
+
+// Returns false when the program raised an exception: pending exceptions, or
+// a pc outside the program (the interpreter vectors DSI itself).
+bool JitOracleInterpretSteps(Core::System& system, u32 steps, u32* budget, u32 word_count)
+{
+  auto& ppc = system.GetPPCState();
+  auto& interpreter = system.GetInterpreter();
+  for (u32 i = 0; i < steps && ppc.pc != JIT_ORACLE_SENTINEL_VA && *budget; ++i, --*budget)
+  {
+    interpreter.SingleStepInner();
+    if (ppc.Exceptions || (ppc.pc != JIT_ORACLE_SENTINEL_VA &&
+                           (ppc.pc - JIT_ORACLE_CODE_VA) >= word_count * 4))
+    {
+      return false;
+    }
+  }
+  return true;
+}
+}  // namespace
+
+// Hands raw bytes to the block compile path (as TryWriteWasmBlock would) and
+// returns the handle: 0 when the engine rejects the module. Lets a test prove
+// that a CompileError/LinkError is contained instead of killing the thread.
+extern "C" EMSCRIPTEN_KEEPALIVE int DolphinWeb_JitCompileBytesForTest(const u8* bytes, u32 size)
+{
+  return CompileWasmCachedInterpreterBlockForTest(std::vector<u8>(bytes, bytes + size));
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_JitEngineRejectCount()
+{
+  return s_wasm_engine_reject_count.load(std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE u32* DolphinWeb_JitOracleBuffer()
+{
+  return &s_jit_oracle.program[0];
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE const char* DolphinWeb_JitOracleMessage()
+{
+  return s_jit_oracle_message.c_str();
+}
+
+// Returns 0 when both runs produced the same state words, 1 when they differ,
+// 2 when no block compiled (nothing was compared), 3 when the interpreter run
+// raised an exception (not compared), negative on a setup error.
+// disable_mask is the CachedInterpreter mask the run uses (production default:
+// blockmerge|shortprefix disabled, 0x220000).
+extern "C" EMSCRIPTEN_KEEPALIVE int DolphinWeb_JitOracleRun(u32 word_count, u32 disable_mask)
+{
+  auto& system = Core::System::GetInstance();
+  s_jit_oracle_message.clear();
+  s_jit_oracle.stats[0] = s_jit_oracle.stats[1] = s_jit_oracle.stats[2] = s_jit_oracle.stats[3] = 0;
+  if (word_count == 0 || word_count > JIT_ORACLE_MAX_WORDS || !JitOracleSetUp(system))
+    return -1;
+  auto& memory = system.GetMemory();
+  for (u32 i = 0; i < word_count; ++i)
+  {
+    const u32 w = s_jit_oracle.program[i];
+    u8* p = memory.GetRAM() + ((JIT_ORACLE_CODE_VA & 0x01ffffff) + i * 4);
+    p[0] = static_cast<u8>(w >> 24);
+    p[1] = static_cast<u8>(w >> 16);
+    p[2] = static_cast<u8>(w >> 8);
+    p[3] = static_cast<u8>(w);
+  }
+  system.GetPowerPC().GetBreakPoints().Clear();
+  auto& ppc = system.GetPPCState();
+  u8* const window = memory.GetRAM() + (JIT_ORACLE_WINDOW_VA & 0x01ffffff);
+
+  JitOracleLoadState(system, s_jit_oracle.input);
+  std::memcpy(s_jit_oracle_window_start.data(), window, JIT_ORACLE_WINDOW_BYTES);
+  u32 budget = JIT_ORACLE_STEP_LIMIT;
+  if (!JitOracleInterpretSteps(system, JIT_ORACLE_STEP_LIMIT, &budget, word_count))
+  {
+    // Exception paths are not compared: the oracle has no vectors to run.
+    s_jit_oracle_message = fmt::format("interpreter raised an exception near {:#010x}", ppc.pc);
+    return 3;
+  }
+  JitOracleSaveState(system, s_jit_oracle.interp);
+  std::memcpy(s_jit_oracle_window_interp.data(), window, JIT_ORACLE_WINDOW_BYTES);
+  std::memcpy(window, s_jit_oracle_window_start.data(), JIT_ORACLE_WINDOW_BYTES);
+
+  const u32 saved_mask = s_dolphin_web_disable_mask.exchange(disable_mask);
+  const u32 min_prefix = DolphinWebHelperDisabled(DOLPHIN_WEB_DISABLE_SHORT_PREFIX) ? 4u : 2u;
+  PPCAnalyst::PPCAnalyzer analyzer;
+  analyzer.SetBranchFollowingEnabled(Config::Get(Config::MAIN_JIT_FOLLOW_BRANCH));
+  PPCAnalyst::CodeBuffer buffer(JIT_ORACLE_MAX_WORDS + 8);
+  JitOracleLoadState(system, s_jit_oracle.input);
+  budget = JIT_ORACLE_STEP_LIMIT;
+  const auto state_base = reinterpret_cast<std::uintptr_t>(&ppc);
+  const auto offset = [&](const void* field) {
+    return static_cast<u32>(reinterpret_cast<std::uintptr_t>(field) - state_base);
+  };
+  const WasmStateLayout layout = {
+      offset(&ppc.npc), offset(ppc.gpr), offset(ppc.ps), offset(ppc.cr.fields),
+      offset(ppc.spr), offset(&ppc.msr), offset(&ppc.fpscr), offset(&ppc.feature_flags),
+      offset(&ppc.pagetable_update_pending), offset(&ppc.xer_ca), offset(&ppc.xer_so_ov),
+      offset(&ppc.xer_stringctrl), offset(&ppc.m_enable_dcache), offset(&ppc.gather_pipe_ptr),
+      offset(&ppc.gather_pipe_base_ptr),
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(memory.GetRAM())),
+      memory.GetRamSizeReal(),
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(memory.GetL1Cache())),
+      memory.GetL1CacheSize(),
+  };
+  int result = 0;
+  while (budget && ppc.pc != JIT_ORACLE_SENTINEL_VA && !ppc.Exceptions)
+  {
+    PPCAnalyst::CodeBlock block;
+    const u32 next_pc = analyzer.Analyze(ppc.pc, &block, &buffer, buffer.size());
+    if (block.m_memory_exception || block.m_num_instructions == 0)
+    {
+      result = -2;
+      break;
+    }
+    u32 prefix = 0;
+    for (; prefix < block.m_num_instructions; ++prefix)
+    {
+      const PPCAnalyst::CodeOp& op = buffer[prefix];
+      if (op.branchIsIdleLoop || !IsPpcWasmDirectInstructionCandidate(op) ||
+          ((op.opinfo->flags & FL_USE_FPU) != 0 && !ppc.msr.FP))
+        break;
+      if (op.canEndBlock)
+      {
+        ++prefix;
+        break;
+      }
+    }
+    std::vector<u8> bytes;
+    if (prefix >= min_prefix)
+    {
+      const bool entire = prefix == block.m_num_instructions;
+      const bool ends_with_branch = buffer[prefix - 1].canEndBlock;
+      const u32 resume_pc = entire ? next_pc : buffer[prefix].address;
+      // A partial prefix does not write npc on the CPU thread (the cached
+      // interpreter continues with the next op); here the loop resumes there.
+      bytes = BuildWasmCachedInterpreterBlock(
+          std::span<const PPCAnalyst::CodeOp>{buffer.data(), prefix}, layout, resume_pc,
+          !ends_with_branch, false, false);
+    }
+    if (bytes.empty())
+    {
+      ++s_jit_oracle.stats[2];
+      if (!JitOracleInterpretSteps(system, block.m_num_instructions, &budget, word_count))
+        break;
+      continue;
+    }
+    const int handle = CompileWasmCachedInterpreterBlockForTest(bytes);
+    if (handle <= 0)
+    {
+      ++s_jit_oracle.stats[3];
+      s_jit_oracle_message = fmt::format("engine rejected block at {:#010x} ({} ops)", ppc.pc, prefix);
+      result = -3;
+      break;
+    }
+    ++s_jit_oracle.stats[0];
+    s_jit_oracle.stats[1] += prefix;
+    budget = budget > prefix ? budget - prefix : 0;
+    const int halted = DolphinWeb_CachedInterpreterRunWasmBlockForTest(
+        handle, static_cast<int>(state_base));
+    if (halted)
+      break;
+    ppc.pc = ppc.npc;
+  }
+  s_dolphin_web_disable_mask.store(saved_mask);
+  JitOracleSaveState(system, s_jit_oracle.jit);
+  if (result < 0)
+    return result;
+  if (budget == 0)
+    s_jit_oracle_message = "step limit reached";
+  if (s_jit_oracle.stats[0] == 0)
+    return 2;
+  for (u32 i = 0; i < JIT_ORACLE_WINDOW_BYTES; ++i)
+  {
+    if (window[i] != s_jit_oracle_window_interp[i])
+    {
+      s_jit_oracle_message = fmt::format("memory at {:#010x}: interp {:#04x} jit {:#04x}",
+                                         JIT_ORACLE_WINDOW_VA + i, s_jit_oracle_window_interp[i],
+                                         window[i]);
+      return 1;
+    }
+  }
+  return std::memcmp(s_jit_oracle.interp, s_jit_oracle.jit, sizeof s_jit_oracle.jit) == 0 ? 0 : 1;
+}
