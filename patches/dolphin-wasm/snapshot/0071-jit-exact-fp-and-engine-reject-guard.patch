+// [i32 single bits in local `bits_local`] -> [f64]: ConvertToDouble, bit-exact
+// (a NaN keeps its payload and signalling bit; f64.promote would quiet it).
+void EmitConvertToDouble(std::vector<u8>& body, u32 bits_local)
+{
+  EmitLocalGet(body, bits_local);
+  EmitI32Const(body, 0x7fffffff);
+  body.push_back(0x71);
+  EmitI32Const(body, 0x7f800000);
+  body.push_back(0x4b);  // i32.gt_u: NaN
+  body.push_back(0x04);
+  body.push_back(0x7c);  // if (result f64)
+  EmitLocalGet(body, bits_local);
+  body.push_back(0xad);  // i64.extend_i32_u
+  body.push_back(0x22);
+  EmitU32Leb(body, 4);
+  EmitI64Const(body, 0xc0000000);
+  body.push_back(0x83);
+  EmitI64Const(body, 32);
+  body.push_back(0x86);
+  EmitI64Const(body, u64{7} << 59);
+  body.push_back(0x84);  // i64.or
+  EmitLocalGet(body, 4);
+  EmitI64Const(body, 0x3fffffff);
+  body.push_back(0x83);
+  EmitI64Const(body, 29);
+  body.push_back(0x86);
+  body.push_back(0x84);
+  body.push_back(0xbf);
+  body.push_back(0x05);
+  EmitLocalGet(body, bits_local);
+  body.push_back(0xbe);  // f32.reinterpret_i32
+  body.push_back(0xbb);  // f64.promote_f32 (exact for zero, normal, denormal, inf)
+  body.push_back(0x0b);
+}
