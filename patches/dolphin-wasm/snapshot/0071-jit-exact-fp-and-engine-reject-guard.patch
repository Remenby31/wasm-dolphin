+    break;
+  case 28:  // fmsub(s), ps_msub
+    kind = FpArithKind::MulSub;
+    break;
+  case 31:  // fnmadd(s), ps_nmadd
+    kind = FpArithKind::MulAdd;
+    negate = true;
+    break;
+  case 30:  // fnmsub(s), ps_nmsub
+    kind = FpArithKind::MulSub;
+    negate = true;
+    break;
