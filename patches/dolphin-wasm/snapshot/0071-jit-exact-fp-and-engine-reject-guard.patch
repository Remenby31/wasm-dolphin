+void EmitStoreFprLaneFromLocal(std::vector<u8>& body, const WasmStateLayout& layout, u32 fd,
+                               u32 lane, u32 local)
+{
+  EmitStateStoreU32Prefix(body);
+  EmitLocalGet(body, local);
+  EmitStateStoreF64Suffix(body, PsOffset(layout, fd, lane));
+}
