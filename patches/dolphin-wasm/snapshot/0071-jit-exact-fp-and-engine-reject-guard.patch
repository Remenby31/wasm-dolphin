+  EmitLocalGet(body, 3);
   body.push_back(0x04);
   body.push_back(0x40);
+  EmitStoreFprLaneFromLocal(body, layout, inst.FD, 0, r0);
+  if (paired)
+    EmitStoreFprLaneFromLocal(body, layout, inst.FD, 1, r1);
+  else if (single)
+    EmitStoreFprLaneFromLocal(body, layout, inst.FD, 1, r0);
+  // fmul and fmuls also clear FI/FR, fmadds sets FI and clears FR; the
+  // paired forms leave both.
+  const bool clears_fi_fr = !paired && (kind == FpArithKind::Mul || fmadds_fi);
+  EmitSetFprfZeroOrNormal(body, layout, r0, clears_fi_fr ? (0x00020000u | 0x00040000u) : 0,
+                          op.wantsFPRF);
+  if (fmadds_fi)
+  {
+    EmitStateStoreU32Prefix(body);
+    EmitStateLoadU32(body, layout.fpscr_offset);
+    EmitLocalGet(body, raw);
+    EmitLocalGet(body, r0);
+    body.push_back(0x62);  // f64.ne
+    EmitI32Const(body, 17);
+    body.push_back(0x74);
+    body.push_back(0x72);
+    EmitStateStoreU32Suffix(body, layout.fpscr_offset);
+  }
+  body.push_back(0x05);
+  EmitFpCall(body, op, downcount);
+  body.push_back(0x0b);
+  body.push_back(0x05);
+  EmitFpCall(body, op, downcount);
+  body.push_back(0x0b);
+}
 
