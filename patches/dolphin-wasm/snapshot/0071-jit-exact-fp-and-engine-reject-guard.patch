+// land in this scratch state are never needed.
+extern "C" double DolphinWeb_CachedInterpreterFma(double a, double c, double b, u32 flags)
+{
+  static PowerPC::PowerPCState scratch;
+  switch (flags & 3)
+  {
+  case 0:
+    return NI_madd_msub<false, false>(scratch, a, c, b).value;
+  case 1:
+    return NI_madd_msub<true, false>(scratch, a, c, b).value;
+  case 2:
+    return NI_madd_msub<false, true>(scratch, a, c, b).value;
+  default:
+    return NI_madd_msub<true, true>(scratch, a, c, b).value;
+  }
+}
