+// fadd/fsub/fmul/fdiv (63), their single forms (59), ps_add/ps_sub/ps_mul/
+// ps_muls0/ps_muls1 (4). FMA-family subops go to the interpreter helper.
+void EmitExactFpArithmetic(std::vector<u8>& body, const WasmStateLayout& layout,
+                           const PPCAnalyst::CodeOp& op, u32 downcount)
+{
