+// [f64] -> [i32]: ConvertToSingle (stfs) or ConvertToSingleFTZ (psq_st),
+// bit-exact: truncating, with the hardware's denormal shift.
+void EmitConvertToSingle(std::vector<u8>& body, bool ftz)
+{
+  body.push_back(0xbd);
+  EmitLocalSet(body, 4);
+  // exp = (x >> 52) & 0x7ff
+  EmitLocalGet(body, 4);
+  EmitI64Const(body, 52);
+  body.push_back(0x88);
+  body.push_back(0xa7);
+  EmitI32Const(body, 0x7ff);
+  body.push_back(0x71);
+  EmitLocalSet(body, 3);
+  const auto emit_common = [&] {
+    // (x >> 32) & 0xc0000000 | (x >> 29) & 0x3fffffff
+    EmitLocalGet(body, 4);
+    EmitI64Const(body, 32);
+    body.push_back(0x88);
+    EmitI64Const(body, 0xc0000000);
+    body.push_back(0x83);
+    EmitLocalGet(body, 4);
+    EmitI64Const(body, 29);
+    body.push_back(0x88);
+    EmitI64Const(body, 0x3fffffff);
+    body.push_back(0x83);
+    body.push_back(0x84);
+    body.push_back(0xa7);
+  };
+  const auto emit_sign = [&] {
+    EmitLocalGet(body, 4);
+    EmitI64Const(body, 32);
+    body.push_back(0x88);
+    body.push_back(0xa7);
+    EmitI32Const(body, 0x80000000);
+    body.push_back(0x71);
+  };
+  if (ftz)
+  {
+    // exp > 896 keeps the bits; anything smaller (zero included, where both
+    // give the sign alone) flushes to a signed zero.
+    EmitLocalGet(body, 3);
+    EmitI32Const(body, 896);
+    body.push_back(0x4b);  // i32.gt_u
+    body.push_back(0x04);
+    body.push_back(0x7f);  // if (result i32)
+    emit_common();
+    body.push_back(0x05);
+    emit_sign();
+    body.push_back(0x0b);
+    return;
+  }
+  // 874 <= exp <= 896: (0x80000000 | frac >> 21) >> (905 - exp) | sign
+  EmitLocalGet(body, 3);
+  EmitI32Const(body, 874);
+  body.push_back(0x6b);
+  EmitI32Const(body, 23);
+  body.push_back(0x49);  // i32.lt_u
+  body.push_back(0x04);
+  body.push_back(0x7f);  // if (result i32)
+  EmitI32Const(body, 0x80000000);
+  EmitLocalGet(body, 4);
+  EmitI64Const(body, 0x000fffffffffffffull);
+  body.push_back(0x83);
+  EmitI64Const(body, 21);
+  body.push_back(0x88);
+  body.push_back(0xa7);
+  body.push_back(0x72);
+  EmitI32Const(body, 905);
+  EmitLocalGet(body, 3);
+  body.push_back(0x6b);
+  body.push_back(0x76);  // i32.shr_u
+  emit_sign();
+  body.push_back(0x72);
+  body.push_back(0x05);
+  emit_common();
+  body.push_back(0x0b);
+}
