+enum class FpArithKind
+{
+  Add,
+  Sub,
+  Mul,
+  Div,
+  MulAdd,  // a * c + b
+  MulSub,  // a * c - b
+};
+
+// Computes one lane into f64 local `dst` (rounded to single when `single`,
+// then negated when `negate`) and ANDs its fast-path condition into i32
+// local 3. `unrounded`, when given, receives the value before rounding.
+void EmitFpArithLane(std::vector<u8>& body, const WasmStateLayout& layout, UGeckoInstruction inst,
+                     FpArithKind kind, bool single, u32 lane, u32 c_lane, u32 dst,
+                     bool negate = false, u32 unrounded = UINT32_MAX)
+{
+  EmitStateLoadF64(body, PsOffset(layout, inst.FA, lane));
+  if (kind == FpArithKind::MulAdd || kind == FpArithKind::MulSub)
+  {
+    // The interpreter's own NI_madd_msub (frC rounding and the single tie fix
+    // included) through an import: plain WASM would round twice.
+    EmitStateLoadF64(body, PsOffset(layout, inst.FC, c_lane));
+    EmitStateLoadF64(body, PsOffset(layout, inst.FB, lane));
+    EmitI32Const(body, (kind == FpArithKind::MulSub ? 1u : 0u) | (single ? 2u : 0u));
+    body.push_back(0x10);
+    EmitU32Leb(body, WASM_IMPORT_FMA_INDEX);
+  }
+  else if (kind == FpArithKind::Mul)
+  {
+    EmitStateLoadF64(body, PsOffset(layout, inst.FC, c_lane));
+    if (single)
+    {
+      // Single-precision multiplies round frC to 25 bits first (Force25Bit).
+      body.push_back(0x22);  // local.tee
+      EmitU32Leb(body, dst);
+      EmitIsNotDenormalDouble(body);
+      EmitLocalGet(body, 3);
+      body.push_back(0x71);
+      EmitLocalSet(body, 3);
+      EmitLocalGet(body, dst);
+      EmitForce25BitNonDenormal(body);
+    }
+    body.push_back(0xa2);  // f64.mul
+  }
+  else
+  {
+    EmitStateLoadF64(body, PsOffset(layout, inst.FB, lane));
+    body.push_back(kind == FpArithKind::Add ? 0xa0 : kind == FpArithKind::Sub ? 0xa1 : 0xa3);
+  }
+  body.push_back(0x22);
+  EmitU32Leb(body, dst);
+  if (single)
+    EmitIsZeroOrNormalSingleResult(body);
+  else
+    EmitIsZeroOrNormalDouble(body);
+  EmitLocalGet(body, 3);
+  body.push_back(0x71);
+  EmitLocalSet(body, 3);
+  if (unrounded != UINT32_MAX)
+  {
+    EmitLocalGet(body, dst);
+    EmitLocalSet(body, unrounded);
+  }
+  if (single || negate)
+  {
+    EmitLocalGet(body, dst);
+    if (single)
+    {
+      body.push_back(0xb6);  // f32.demote_f64
+      body.push_back(0xbb);  // f64.promote_f32
+    }
+    if (negate)
+      body.push_back(0x9a);  // f64.neg (the result is not NaN on this path)
+    EmitLocalSet(body, dst);
+  }
+}
