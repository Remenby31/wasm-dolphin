+  EmitFpFastPathMsrCondition(body, layout);
+  body.push_back(0x04);
+  body.push_back(0x40);
+  EmitI32Const(body, 1);
+  EmitLocalSet(body, 3);
+  const u32 r0 = WasmFpScratchLocal(0), r1 = WasmFpScratchLocal(1), raw = WasmFpScratchLocal(2);
+  // fmadds alone sets FI from the rounding (FI = unrounded != result).
+  const bool fmadds_fi = inst.OPCD == 59 && inst.SUBOP5 == 29;
