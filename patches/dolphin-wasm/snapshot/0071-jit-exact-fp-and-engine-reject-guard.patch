+      return;
+    }
+    kind = FpArithKind::MulAdd;
+    c_lane0 = c_lane1 = inst.SUBOP5 - 14;
+    break;
+  case 21:
+    kind = FpArithKind::Add;
+    break;
+  case 20:
+    kind = FpArithKind::Sub;
+    break;
+  case 18:
+    kind = FpArithKind::Div;
+    break;
+  case 25:
+    kind = FpArithKind::Mul;
+    break;
+  case 12:  // ps_muls0
+  case 13:  // ps_muls1
+    kind = FpArithKind::Mul;
+    c_lane0 = c_lane1 = inst.SUBOP5 - 12;
+    break;
+  default:
+    EmitFpCall(body, op, downcount);
+    return;
+  }
