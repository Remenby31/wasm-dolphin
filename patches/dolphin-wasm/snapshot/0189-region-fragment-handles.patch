+// 0189: the fragments of the region module installed at `handle` (kept by
+// DolphinWeb_CachedInterpreterCompileWasmBlock), each put in a slot of the
+// core's table (a released slot first). Writes (entry pc, fragment slot) pairs
+// for the module's "region-entries", in that order, at most `capacity`; 0 when
+// the module has no entry -> fragment section or the table is full.
+EM_JS(int, DolphinWeb_RegionFragmentHandles, (int handle, unsigned int* out, int capacity), {
+  const kept = globalThis._dolphinRegionFragments;
+  const e = kept && kept.get(handle);
+  if (!e) return 0;
+  kept.delete(handle);
+  const [entries] = WebAssembly.Module.customSections(e.mod, "region-entries");
+  const [owners] = WebAssembly.Module.customSections(e.mod, "region-entry-fragments");
+  if (!entries || !owners || entries.byteLength !== owners.byteLength) return 0;
+  const pcs = new Uint32Array(entries.slice(0));
+  const of = new Uint32Array(owners.slice(0));
+  if (pcs.length > capacity) return 0;
+  const free = (globalThis._dolphinFreeTableSlots ??= []);
+  const slots = [];
+  for (let i = 0; i < e.table.length; i++) {
+    let slot = free.pop();
+    if (slot === undefined) {
+      slot = wasmTable.length;
+      try { wasmTable.grow(1); } catch (err) {
+        for (const s of slots) { wasmTable.set(s, null); free.push(s); }
+        return 0;
+      }
+    }
+    wasmTable.set(slot, e.table.get(i));
+    slots.push(slot);
+  }
+  const view = new DataView(HEAPU8.buffer);
+  for (let i = 0; i < pcs.length; i++) {
+    view.setUint32(out + 8 * i, pcs[i], true);
+    view.setUint32(out + 8 * i + 4, slots[of[i]] ?? 0, true);
+  }
+  return pcs.length;
+});
+
+// 0189: slots of the core's table no region uses any more, for the next ones.
+EM_JS(void, DolphinWeb_ReleaseTableSlots, (const int* slots, int count), {
+  const free = (globalThis._dolphinFreeTableSlots ??= []);
+  for (let i = 0; i < count; i++) {
+    const s = HEAP32[(slots >> 2) + i];
+    wasmTable.set(s, null);
+    free.push(s);
+  }
+});
