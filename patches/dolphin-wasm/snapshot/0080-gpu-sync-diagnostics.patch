diff --git a/Source/Core/VideoCommon/WasmGpuSyncDiag.h b/Source/Core/VideoCommon/WasmGpuSyncDiag.h
new file mode 100644
index 0000000000..051f4c3301
--- /dev/null
+++ b/Source/Core/VideoCommon/WasmGpuSyncDiag.h
@@ -0,0 +1,45 @@
+// Copyright 2026 Dolphin Emulator Project (wasm-dolphin fork)
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+// Harness diagnostics for a dual-core GPU stall: the GPU thread's FIFO loop
+// and the pixel engine's token/finish handshake with the CPU thread. Off unless
+// the harness hooks are on (DolphinWeb_HarnessEnable): every hook is one
+// relaxed load of `s_enabled`, then nothing.
+
+#include <atomic>
+#include <cstdint>
+
+namespace DolphinWeb::GpuSyncDiag
+{
+inline std::atomic<bool> s_enabled{false};
+
+struct Counters
+{
+  std::atomic<std::uint64_t> gpu_loop_iterations{0};
+  std::atomic<std::uint64_t> fifo_chunks_decoded{0};
+  // PixelEngine: SetToken/SetFinish calls (video thread), the ones that
+  // actually scheduled the CPU-thread event (m_event_raised was clear), and
+  // the event runs on the CPU thread.
+  std::atomic<std::uint64_t> pe_token_requests{0};
+  std::atomic<std::uint64_t> pe_finish_requests{0};
+  std::atomic<std::uint64_t> pe_events_scheduled{0};
+  std::atomic<std::uint64_t> pe_events_run{0};
+  std::atomic<std::uint64_t> pe_finish_signalled{0};
+  std::atomic<std::uint64_t> pe_token_signalled{0};
+};
+
+inline Counters s_counters{};
+
+inline bool Enabled()
+{
+  return s_enabled.load(std::memory_order_relaxed);
+}
+
+inline void Count(std::atomic<std::uint64_t>& counter)
+{
+  if (Enabled())
+    counter.fetch_add(1, std::memory_order_relaxed);
+}
+}  // namespace DolphinWeb::GpuSyncDiag
