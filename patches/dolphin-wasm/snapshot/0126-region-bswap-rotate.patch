@@ -4524,8 +4524,26 @@ void EmitL1Address(std::vector<u8>& body, const WasmStateLayout& layout)
   body.push_back(0x6a);
 }
 
+// Patch 0126: in region code, the byte swap in the form LLVM emits,
+// (rotl(x, 8) & 0x00ff00ff) | (rotr(x, 8) & 0xff00ff00), 5 ops instead of
+// 10. Blocks keep their bytes (and cache keys).
 void EmitBswap32FromLocal(std::vector<u8>& body, u32 local_index)
 {
+  if (s_wasm_fragment_relocs)
+  {
+    EmitLocalGet(body, local_index);
+    EmitI32Const(body, 8);
+    body.push_back(0x77);  // i32.rotl
+    EmitI32Const(body, 0x00ff00ff);
+    body.push_back(0x71);  // i32.and
+    EmitLocalGet(body, local_index);
+    EmitI32Const(body, 8);
+    body.push_back(0x78);  // i32.rotr
+    EmitI32Const(body, 0xff00ff00u);
+    body.push_back(0x71);
+    body.push_back(0x72);  // i32.or
+    return;
+  }
   EmitLocalGet(body, local_index);
   EmitI32Const(body, 0xff);
   body.push_back(0x71);
@@ -16784,8 +16802,9 @@ namespace
 // ps_neg/mr/nabs/abs compiled inline (3 and 4 are taken by 0084 and 0083).
 // 6 (0105): FPU ops outside the direct tier stay in the region, interpreted.
 // 10 (0111): compares store their CR field as one i64, bc fused (7-9 are
-// taken by 0108-0110).
-constexpr u32 AOT_COMPILER_VERSION = 10;
+// taken by 0108-0110). 16 (0126): region byte swaps as two rotates (11-15
+// are taken by the region patches 0112-0119).
+constexpr u32 AOT_COMPILER_VERSION = 16;
 constexpr u32 AOT_MAX_FRAGMENT_BYTES = 1u << 20;
 thread_local std::vector<u32> t_aot_out;
 u8* s_aot_ram = nullptr;
