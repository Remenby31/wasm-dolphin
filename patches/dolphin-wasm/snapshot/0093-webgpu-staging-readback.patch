 void WebGPUStagingTexture::Flush()
 {
+  // Waits only for what is not back yet: a copy issued ahead (the EFB peek
+  // cache's RefreshPeekCache) has usually landed by the time it is read.
+  if (!WaitForCopies(500))
+  {
+    static bool s_logged = false;
+    if (!s_logged)
+    {
+      s_logged = true;
+      WARN_LOG_FMT(VIDEO, "WebGPU readback: copy {} not back after 500 ms, using older texels",
+                   m_issued);
+    }
+  }
   m_needs_flush = false;
 }
 
