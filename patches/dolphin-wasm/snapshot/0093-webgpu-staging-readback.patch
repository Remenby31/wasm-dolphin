+bool WebGPUStagingTexture::WaitForCopies(u32 timeout_ms)
+{
+  if (static_cast<u32>(m_words[0].load(std::memory_order_acquire)) >= m_issued)
+    return true;
+#ifdef __EMSCRIPTEN__
+  const double deadline = emscripten_get_now() + timeout_ms;
+  for (;;)
+  {
+    const s32 done = m_words[0].load(std::memory_order_acquire);
+    if (static_cast<u32>(done) >= m_issued)
+      return true;
+    const double left = deadline - emscripten_get_now();
+    if (left <= 0)
+      return false;
+    emscripten_futex_wait(reinterpret_cast<volatile void*>(&m_words[0]),
+                          static_cast<u32>(done), left);
+  }
+#else
+  return false;
+#endif
+}
