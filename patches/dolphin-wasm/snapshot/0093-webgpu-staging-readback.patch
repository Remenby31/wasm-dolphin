+
+static u32 Pack16(u32 lo, u32 hi);
+
+bool WebGPUCommandStream::PushCopyToStaging(u32 src_id, u32 x, u32 y, u32 w, u32 h, u32 layer,
+                                            u32 level, u32 texel_size, u32 seq, u32 dst_ptr,
+                                            u32 dst_stride, u32 words_ptr)
+{
+  if (!m_header || src_id == 0 || w == 0 || h == 0 || dst_ptr == 0 || words_ptr == 0)
+    return false;
+  // Like a blit, a readback cannot run ahead of an unpublished pass that
+  // produces its source: the caller ends the pass first.
+  if (m_pass_staging)
+  {
+    PoisonPass();
+    return false;
+  }
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::CopyToStaging);
+  rec.arg.u[0] = src_id;
+  rec.arg.u[1] = Pack16(x, y);
+  rec.arg.u[2] = Pack16(w, h);
+  rec.arg.u[3] = (layer & 0xFFu) | ((level & 0xFu) << 8) | ((texel_size & 0xFu) << 12) |
+                 ((seq & 0xFFFFu) << 16);
+  rec.arg.u[4] = dst_ptr;
+  rec.arg.u[5] = dst_stride;
+  rec.arg.u[6] = words_ptr;
   return Push(rec);
 }
 
