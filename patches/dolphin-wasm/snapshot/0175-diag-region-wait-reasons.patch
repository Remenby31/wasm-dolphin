+// Patch 0175 (diagnosis): [DIAG_COUNT reason counts, logged installs, window
+// start ms x 100]; then the log copied to `log` (8 floats per install, at
+// most `cap` installs, the last ones). Returns the installs copied.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_RegionDiag(u32* counts, float* log, u32 cap)
+{
+  for (u32 i = 0; i < DIAG_COUNT; ++i)
+    counts[i] = s_diag_reasons[i];
+  counts[DIAG_COUNT] = s_diag_logged;
+  counts[DIAG_COUNT + 1] = static_cast<u32>(std::max(s_diag_window_start_ms, 0.f) * 100);
+  const u32 kept = std::min<u32>(s_diag_logged, DIAG_LOG);
+  const u32 n = std::min(kept, cap);
+  for (u32 k = 0; k < n; ++k)
+  {
+    const DiagInstall& e = s_diag_log[(s_diag_logged - n + k) % DIAG_LOG];
+    std::memcpy(log + 8 * k, &e, sizeof(DiagInstall));
+  }
+  return n;
+}
