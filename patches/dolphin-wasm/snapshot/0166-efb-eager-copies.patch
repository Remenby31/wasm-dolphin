+#ifdef __EMSCRIPTEN__
+extern "C" int DolphinWeb_EfbEager();
+#endif
+
+bool TextureCacheBase::EfbEagerActive()
+{
+#ifdef __EMSCRIPTEN__
+  // Single core: the CPU thread decodes the FIFO itself and could read the
+  // RAM right after the copy, before its texels land; dual core only.
+  return DolphinWeb_EfbEager() != 0 && Core::System::GetInstance().IsDualCoreMode();
+#else
+  return false;
+#endif
+}
+
+void TextureCacheBase::FlushLandedEFBCopies()
+{
+  // In order: a copy is written only once every copy before it is.
+  auto landed = m_pending_efb_copies.begin();
+  for (; landed != m_pending_efb_copies.end(); ++landed)
+  {
+    const auto& staging = (*landed)->pending_efb_copy;
+    if (staging && !staging->IsCopyComplete())
+      break;
+    FlushEFBCopy(landed->get());
+  }
+  m_pending_efb_copies.erase(m_pending_efb_copies.begin(), landed);
+}
+
+void TextureCacheBase::FlushEFBCopiesOverlapping(u32 address, u32 size)
+{
+  for (const auto& entry : m_pending_efb_copies)
+  {
+    if (entry->OverlapsMemoryRange(address, size))
+    {
+      FlushEFBCopies();
+      return;
+    }
+  }
+}
