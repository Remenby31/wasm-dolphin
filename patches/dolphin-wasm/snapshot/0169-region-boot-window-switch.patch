+// Patch 0169 (diagnosis): where a region lookup at `pc` stops. Bits: 1 in
+// the filter, 2 an owner in s_region_at, 4 that region live, 8 verified,
+// 16 its entries list `pc`, 32 FindRegionIndex finds it (lookup slot
+// included); bits 8-23: the owner's index + 1 (0: none, capped).
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_RegionProbePc(u32 pc)
+{
+  u32 bits = RegionFilterHas(pc) ? 1u : 0u;
+  const auto it = s_region_at.find(pc);
+  if (it != s_region_at.end())
+  {
+    bits |= 2u;
+    const u32 index = it->second;
+    bits |= std::min<u32>(index + 1, 0xffff) << 8;
+    if (index < s_regions.size())
+    {
+      const InstalledRegion& region = s_regions[index];
+      if (region.live)
+        bits |= 4u;
+      if (region.verified)
+        bits |= 8u;
+      if (std::find(region.entries.begin(), region.entries.end(), pc) != region.entries.end())
+        bits |= 16u;
+    }
+  }
+  if (bits & 1u)
+  {
+    if (FindRegionIndex(pc) != NO_REGION)
+      bits |= 32u;
+  }
+  return bits;
+}
