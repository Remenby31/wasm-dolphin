+// Patch 0169 (diagnosis): watch these PCs (count <= 8; 0 stops watching) and
+// zero their counters; count < 0 only reads. Returns the counters' address
+// (8 x REGION_WATCH_WORDS u32).
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_RegionWatch(const u32* pcs, int count)
+{
+  if (count < 0)
+    return static_cast<u32>(reinterpret_cast<std::uintptr_t>(s_region_watch.data()));
+  s_region_watch.fill(0);
+  s_region_watch_since = std::chrono::steady_clock::now();
+  s_region_watch_count = static_cast<u32>(std::clamp(count, 0, 8));
+  for (u32 i = 0; i < s_region_watch_count; ++i)
+    s_region_watch[i * REGION_WATCH_WORDS] = pcs[i];
+  return static_cast<u32>(reinterpret_cast<std::uintptr_t>(s_region_watch.data()));
+}
