+// Patch 0169 (diagnosis): up to 8 watched PCs; for each, the region
+// attempts at it (TryRunRegion reached) and the codes its region returned
+// (0 left normally, 1 not an entry, 2 stop, 3 guest return). Attempts minus
+// runs: refused (mode, guard, lookup, verification). Words per slot: pc,
+// tries, code 0, code 1, code 2, code 3, then the refusals: filter miss,
+// IR/DR off, guards (LE, FE0, FE1, LSQE), performance monitor, XER.SO set,
+// lookup miss, verifications, then the host ms (since the watch was set) of
+// the first run, 0: none yet (14 words a slot).
+constexpr u32 REGION_WATCH_WORDS = 14;
+std::chrono::steady_clock::time_point s_region_watch_since;
+std::array<u32, 8 * REGION_WATCH_WORDS> s_region_watch{};
+u32 s_region_watch_count = 0;
+inline u32* RegionWatchSlot(u32 pc)
+{
+  for (u32 i = 0; i < s_region_watch_count; ++i)
+  {
+    if (s_region_watch[i * REGION_WATCH_WORDS] == pc)
+      return &s_region_watch[i * REGION_WATCH_WORDS];
+  }
+  return nullptr;
+}
