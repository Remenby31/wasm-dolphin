@@ -608,6 +640,30 @@ void CoreTimingManager::SleepUntil(TimePoint time_point)
     // pacing). Busy-spin burned that 41ms of CPU on the pthread which
     // starved the main-thread audio worklet → underruns. Sleep releases
     // the CPU so audio/render can use it during throttle.
+#ifdef __EMSCRIPTEN__
+    // Patch 0165: sleep to the target minus the margin, then spin to it
+    // (the spin is at most the margin, plus nothing when the sleep overran).
+    const u32 margin_us = DolphinWeb::g_sleep_margin_us.load(std::memory_order_relaxed);
+    if (margin_us != 0)
+    {
+      const TimePoint coarse = time_point - std::chrono::microseconds{margin_us};
+      if (coarse > time)
+        std::this_thread::sleep_until(coarse);
+      const u32 step_us = DolphinWeb::g_sleep_step_us.load(std::memory_order_relaxed);
+      if (step_us != 0)
+      {
+        const auto step = std::chrono::microseconds{step_us};
+        while (time_point - Clock::now() > step)
+          std::this_thread::sleep_for(step);
+      }
+      const TimePoint spin_start = Clock::now();
+      TimePoint now = spin_start;
+      while (now < time_point)
+        now = Clock::now();
+      DolphinWeb::PresentCadence::AddSpin(now - spin_start);
+    }
+    else
+#endif
     if (use_precision_timer)
       m_precision_cpu_timer.SleepUntil(time_point);
     else
