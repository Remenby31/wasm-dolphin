+namespace DolphinWeb
+{
+// Patch 0165 (?sleepmargin=<us>): the CPU thread's throttle sleeps until its
+// target minus this margin, then spins to the target. The worker's timed
+// Atomics.wait wakes ~2.5 ms late (0162: p50 2.5, p99 5 ms), so two thirds of
+// the throttles found their target already passed. 0: the plain sleep.
+std::atomic<u32> g_sleep_margin_us{0};
+// ?sleepstep=<us>: inside the margin, short sleeps of this length while more
+// than one step is left, before the final spin (fewer spun microseconds if a
+// short wait wakes closer to its time than a long one). 0: spin the margin.
+std::atomic<u32> g_sleep_step_us{0};
+}  // namespace DolphinWeb
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetThrottleSleepMarginUs(int us)
+{
+  DolphinWeb::g_sleep_margin_us.store(static_cast<u32>(std::clamp(us, 0, 8000)),
+                                      std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetThrottleSleepStepUs(int us)
+{
+  DolphinWeb::g_sleep_step_us.store(static_cast<u32>(std::clamp(us, 0, 4000)),
+                                    std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_ThrottleSleepStepUs()
+{
+  return DolphinWeb::g_sleep_step_us.load(std::memory_order_relaxed);
+}
