+// CPU thread, patch 0165: one timed wait, its requested length and lateness.
+inline void OnWait(Clock::duration requested, Clock::duration late)
+{
+  if (!g_on) [[likely]]
+    return;
+  const u32 req = Micros(requested);
+  g_stats.waits += 1;
+  Bin(g_stats.wait_req_hist, 64, WAIT_REQ_BIN_US, req);
+  const u64 ratio = req ? static_cast<u64>(Micros(late)) * WAIT_RATIO_BINS / req : 0;
+  g_stats.wait_ratio_hist[std::min<u64>(ratio, WAIT_RATIO_BINS - 1)] += 1;
+}
+// CPU thread, patch 0165: the time a throttle spun to its target.
+inline void AddSpin(Clock::duration d)
+{
+  if (g_on) [[unlikely]]
+    g_stats.spin_us += Micros(d);
+}
