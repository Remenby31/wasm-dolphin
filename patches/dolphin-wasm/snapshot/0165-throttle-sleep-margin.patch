+namespace DolphinWeb
+{
+// Patch 0165 (?sleepmargin=<us>): the CPU thread's throttle sleeps until its
+// target minus this margin, then spins to the target. The worker's timed
+// Atomics.wait wakes ~2.5 ms late (0162: p50 2.5, p99 5 ms), so two thirds of
+// the throttles found their target already passed. 0: the plain sleep.
+std::atomic<u32> g_sleep_margin_us{0};
+// ?sleepstep=<us>: inside the margin, short sleeps of this length while more
+// than one step is left, before the final spin (fewer spun microseconds if a
+// short wait wakes closer to its time than a long one). 0: spin the margin.
+std::atomic<u32> g_sleep_step_us{0};
+// ?sleepk=<permille>: the geometric cascade (research/deep-precise-sleep.md
+// §6 D): each wait is k x the time left, until at most ?sleepspin=<us> is
+// left, then a spin. macOS wakes a wait of d at most ~d/4 late (timer
+// coalescing), so with k = 0.75 each wake lands before the target and the
+// time left shrinks by >= 4x per wait. 0: off (takes precedence over the margin).
+std::atomic<u32> g_sleep_k_permille{0};
+std::atomic<u32> g_sleep_spin_us{300};
+
+// One timed wait of the CPU thread's throttle, with its requested length and
+// lateness counted (0162/0165 histograms) while the counters are on.
+static void ThrottleWaitUntil(std::chrono::steady_clock::time_point target)
+{
+  if (!PresentCadence::g_on)
+  {
+    std::this_thread::sleep_until(target);
+    return;
+  }
+  const auto start = std::chrono::steady_clock::now();
+  if (target <= start)
+    return;
+  std::this_thread::sleep_until(target);
+  PresentCadence::OnWait(target - start, std::chrono::steady_clock::now() - target);
+}
+}  // namespace DolphinWeb
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetThrottleSleepMarginUs(int us)
+{
+  DolphinWeb::g_sleep_margin_us.store(static_cast<u32>(std::clamp(us, 0, 8000)),
+                                      std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetThrottleSleepStepUs(int us)
+{
+  DolphinWeb::g_sleep_step_us.store(static_cast<u32>(std::clamp(us, 0, 4000)),
+                                    std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_ThrottleSleepStepUs()
+{
+  return DolphinWeb::g_sleep_step_us.load(std::memory_order_relaxed);
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetThrottleSleepCascade(int k_permille, int spin_us)
+{
+  DolphinWeb::g_sleep_k_permille.store(static_cast<u32>(std::clamp(k_permille, 0, 950)),
+                                       std::memory_order_relaxed);
+  DolphinWeb::g_sleep_spin_us.store(static_cast<u32>(std::clamp(spin_us, 50, 2000)),
+                                    std::memory_order_relaxed);
+}
+
+// The cascade's k (permille, 0: off) in the low 16 bits, its spin limit (us)
+// in the high 16 bits.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_ThrottleSleepCascade()
+{
+  return DolphinWeb::g_sleep_k_permille.load(std::memory_order_relaxed) |
+         (DolphinWeb::g_sleep_spin_us.load(std::memory_order_relaxed) << 16);
+}
