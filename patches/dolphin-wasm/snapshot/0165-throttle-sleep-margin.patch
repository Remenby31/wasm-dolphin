@@ -608,10 +679,57 @@ void CoreTimingManager::SleepUntil(TimePoint time_point)
     // pacing). Busy-spin burned that 41ms of CPU on the pthread which
     // starved the main-thread audio worklet → underruns. Sleep releases
     // the CPU so audio/render can use it during throttle.
+#ifdef __EMSCRIPTEN__
+    // Patch 0165: the cascade (?sleepk), else the margin (?sleepmargin, with
+    // ?sleepstep), then a spin to the target (nothing when a wait overran).
+    const u32 k_permille = DolphinWeb::g_sleep_k_permille.load(std::memory_order_relaxed);
+    const u32 margin_us = DolphinWeb::g_sleep_margin_us.load(std::memory_order_relaxed);
+    if (k_permille != 0 || margin_us != 0)
+    {
+      if (k_permille != 0)
+      {
+        const auto spin_limit =
+            std::chrono::microseconds{DolphinWeb::g_sleep_spin_us.load(std::memory_order_relaxed)};
+        // At most 8 waits: under a coarse timer (Windows on battery) a wait
+        // shorter than the quantum still lasts a quantum and overruns.
+        for (int waits = 0; waits < 8; ++waits)
+        {
+          const TimePoint now = Clock::now();
+          const auto left = time_point - now;
+          if (left <= spin_limit)
+            break;
+          DolphinWeb::ThrottleWaitUntil(now + left * k_permille / 1000);
+        }
+      }
+      else
+      {
+        const TimePoint coarse = time_point - std::chrono::microseconds{margin_us};
+        if (coarse > time)
+          DolphinWeb::ThrottleWaitUntil(coarse);
+        const u32 step_us = DolphinWeb::g_sleep_step_us.load(std::memory_order_relaxed);
+        if (step_us != 0)
+        {
+          const auto step = std::chrono::microseconds{step_us};
+          while (time_point - Clock::now() > step)
+            DolphinWeb::ThrottleWaitUntil(Clock::now() + step);
+        }
+      }
+      const TimePoint spin_start = Clock::now();
+      TimePoint now = spin_start;
+      while (now < time_point)
+        now = Clock::now();
+      DolphinWeb::PresentCadence::AddSpin(now - spin_start);
+    }
+    else
+#endif
     if (use_precision_timer)
       m_precision_cpu_timer.SleepUntil(time_point);
     else
+#ifdef __EMSCRIPTEN__
+      DolphinWeb::ThrottleWaitUntil(time_point);
+#else
       std::this_thread::sleep_until(time_point);
+#endif
 
     // Count amount of time sleeping for analytics
     const TimePoint time_after_sleep = Clock::now();
