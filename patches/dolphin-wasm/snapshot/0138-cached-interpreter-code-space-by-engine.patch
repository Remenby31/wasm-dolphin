+// Patch 0138: the code space (callbacks and operands only, the WASM bodies
+// live in their own modules) is set by the page before the boot
+// (DolphinWeb_SetCodeSpaceMiB): 32 MiB under JSC, where its memory, all
+// dirtied at boot by Emscripten's mmap, counts on iOS; 128 MiB (Jit64's)
+// otherwise, the default here. Counters in GetPpcWasmHelperStats: cache
+// clears in all, those because the space was full, and the highest offset
+// written.
+std::atomic<u32> s_code_space_mib{128};
+std::atomic<u32> s_code_clears{0};
+std::atomic<u32> s_code_full_clears{0};
+std::atomic<u32> s_code_high_kib{0};
+}  // namespace
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetCodeSpaceMiB(int mib)
+{
+  if (mib >= 4 && mib <= 128)
+    s_code_space_mib.store(static_cast<u32>(mib), std::memory_order_relaxed);
+}
+#endif
