diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
--- a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
@@ -15122,6 +15122,12 @@ struct RegionFragment
 bool BuildRegionFragment(Core::System& system, u32 entry_pc, std::span<const u32> ranges,
                          u32 max_blocks, RegionFragment* out)
 {
+  // 0091: no region under the MMU (a game's INI). Its slow memory paths take
+  // a DSI and go on with 0, and a region does not stop there; the block JIT
+  // never runs under the MMU either (jo.memcheck: TryWriteWasmBlock refuses).
+  // Defence in depth with 0090, which keeps such regions from installing.
+  if (system.IsMMUMode())
+    return false;
   // End of the range holding pc, 0 when none does.
   const auto range_end = [&](u32 pc) -> u32 {
     for (std::size_t i = 0; i + 1 < ranges.size(); i += 2)
@@ -15429,6 +15435,13 @@ extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_AotLayoutHash()
 }
 
 // The layout's fields, in WasmStateLayout order (diagnostics: which one moved).
+// Tests: the MMU mode a game's INI would set (0091), so a test can check that
+// nothing is translated under it.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotMMUModeForTest(int enabled)
+{
+  Core::System::GetInstance().SetMMUModeForTest(enabled != 0);
+}
+
 extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_AotLayoutWords(u32* out, u32 capacity)
 {
   const WasmStateLayout layout = CurrentWasmStateLayout(Core::System::GetInstance());
