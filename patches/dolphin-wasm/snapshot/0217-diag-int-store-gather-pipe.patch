+// DIAG 0217 prototype: the integer store's path out of RAM. A store to the
+// gather pipe page (MSR.DR on, the EA masked as the float path masks it,
+// within its 4 KiB page) is written inline as GPFifo::Write8/16/32 does
+// (FastWriteN: big-endian at gather_pipe_ptr, then the pointer advances; then
+// CheckGatherPipe when 32 bytes or more wait), every other store calls the
+// MMU helper as before. Not exact: the BAT is not looked at (sizing only).
+void EmitIntStoreOutOfRam(std::vector<u8>& body, const WasmStateLayout& layout, u32 size,
+                          u32 import_index)
+{
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, 1u << 4);  // MSR.DR
+  body.push_back(0x71);
+  EmitI32Const(body, 0);
+  body.push_back(0x47);  // ne
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 0x0ffff000);
+  body.push_back(0x71);
+  EmitI32Const(body, GPFifo::GATHER_PIPE_PHYSICAL_ADDRESS);
+  body.push_back(0x46);  // eq
+  body.push_back(0x71);
+  EmitLocalGet(body, 1);
+  EmitI32Const(body, 0xfff);
+  body.push_back(0x71);
+  EmitI32Const(body, static_cast<s32>(0x1000 - size));
+  body.push_back(0x4d);  // le_u: no page crossing
+  body.push_back(0x71);
+  HintNextIf(body, true);
+  body.push_back(0x04);
+  body.push_back(0x40);
+  if (size == 4)
+    EmitBswap32FromLocal(body, 2);
+  else if (size == 2)
+    EmitBswap16FromLocal(body, 2);
+  else
+    EmitLocalGet(body, 2);
+  EmitLocalSet(body, 3);
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitLocalGet(body, 3);
+  body.push_back(size == 4 ? 0x36 : size == 2 ? 0x3b : 0x3a);
+  body.push_back(0x00);
+  EmitU32Leb(body, 0);
+  EmitStateStoreU32Prefix(body);
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitI32Const(body, static_cast<s32>(size));
+  body.push_back(0x6a);
+  EmitStateStoreU32Suffix(body, layout.gather_pipe_ptr_offset);
+  EmitStateLoadU32(body, layout.gather_pipe_ptr_offset);
+  EmitStateLoadU32(body, layout.gather_pipe_base_ptr_offset);
+  body.push_back(0x6b);
+  EmitI32Const(body, GPFifo::GATHER_PIPE_SIZE);
+  body.push_back(0x4f);  // ge_u
+  HintNextIf(body, false);
+  body.push_back(0x04);
+  body.push_back(0x40);
+  EmitLocalGet(body, 0);
+  EmitI32Const(body, 1);
+  EmitI32Const(body, 0);
+  EmitCallImport(body, WASM_IMPORT_FASTCHECK_GPFIFO_INDEX);
+  body.push_back(0x0b);
+  body.push_back(0x05);
+  EmitLocalGet(body, 0);
+  EmitLocalGet(body, 1);
+  EmitLocalGet(body, 2);
+  EmitCallImport(body, import_index);
+  body.push_back(0x0b);
+}
