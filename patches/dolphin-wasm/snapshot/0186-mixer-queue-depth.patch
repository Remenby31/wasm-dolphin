diff --git a/Source/Core/AudioCommon/Mixer.h b/Source/Core/AudioCommon/Mixer.h
--- a/Source/Core/AudioCommon/Mixer.h
+++ b/Source/Core/AudioCommon/Mixer.h
@@ -41,6 +41,16 @@
   // Note: NullSoundStream sets the sample rate to 0.
   bool IsOutputSampleRateValid() const { return m_output_sample_rate != 0; }
 
+  // 0186 (read-only, no effect on emulation): the input queued ahead of the
+  // output, in microseconds, the longer of the DMA and streaming FIFOs (the
+  // granule queue AudioBufferSize sizes). Read from the queue's atomics.
+  u64 GetQueuedMicroseconds() const
+  {
+    const u64 dma = m_dma_mixer.QueuedMicroseconds();
+    const u64 streaming = m_streaming_mixer.QueuedMicroseconds();
+    return dma > streaming ? dma : streaming;
+  }
+
   void SetDMAInputSampleRateDivisor(u32 rate_divisor);
   void SetStreamInputSampleRateDivisor(u32 rate_divisor);
   void SetGBAInputSampleRate(std::size_t device_number, u32 sample_rate);
@@ -131,6 +141,19 @@
     void SetVolume(u32 lvolume, u32 rvolume);
     std::pair<s32, s32> GetVolume() const;
 
+    // 0186: queued granules, each GRANULE_SIZE / 2 input samples (they
+    // overlap by half), at the input rate dividend / divisor.
+    u64 QueuedMicroseconds() const
+    {
+      const std::size_t head = m_queue_head.load(std::memory_order_acquire);
+      const std::size_t tail = m_queue_tail.load(std::memory_order_acquire);
+      const u64 granules = (head - tail) & GRANULE_QUEUE_MASK;
+      const u64 divisor = m_input_sample_rate_divisor;
+      return m_input_sample_rate_dividend == 0 ?
+                 0 :
+                 granules * (GRANULE_SIZE / 2) * divisor * 1000000 / m_input_sample_rate_dividend;
+    }
+
   private:
     Mixer* m_mixer;
 
