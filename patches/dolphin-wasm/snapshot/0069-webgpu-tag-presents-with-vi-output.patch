+bool WebGPUCommandStream::PushViTag(u32 vi_since_boot, u32 vi_since_load, u64 ticks,
+                                    u32 load_generation)
+{
+  if (!m_header)
+    return false;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::ViTag);
+  rec.arg.u[0] = vi_since_boot;
+  rec.arg.u[1] = vi_since_load;
+  rec.arg.u[2] = static_cast<u32>(ticks);
+  rec.arg.u[3] = static_cast<u32>(ticks >> 32);
+  rec.arg.u[4] = load_generation;
+  return Push(rec);
+}
+
+bool WebGPUCommandStream::PushPresentSource(u32 x, u32 y, u32 w, u32 h)
+{
+  if (!m_header)
+    return false;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::PresentSource);
+  rec.arg.u[0] = x;
+  rec.arg.u[1] = y;
+  rec.arg.u[2] = w;
+  rec.arg.u[3] = h;
+  return Push(rec);
+}
