+
+// The live WebGPU backend, for the harness hooks below (called from
+// VideoCommon, which does not know the backend type); null under any other.
+static WebGPU::WebGPUGfx* ActiveWebGpuGfx()
+{
+  if (!g_video_backend || !g_gfx ||
+      g_video_backend->GetConfigName() != WebGPU::VideoBackend::CONFIG_NAME)
+  {
+    return nullptr;
+  }
+  return static_cast<WebGPU::WebGPUGfx*>(g_gfx.get());
+}
+
+// Called on the video thread right before ViSwap when the harness hooks are on.
+extern "C" void DolphinWeb_WebGpuTagViOutput(u32 vi_since_boot, u32 vi_since_load, u64 ticks,
+                                             u32 load_generation)
+{
+  if (auto* gfx = ActiveWebGpuGfx())
+    gfx->TagViOutput(vi_since_boot, vi_since_load, ticks, load_generation);
+}
+
+// Called by the Presenter before it binds the backbuffer, with the source
+// rectangle its blit will sample, when the harness hooks are on.
+extern "C" void DolphinWeb_WebGpuTagPresentSource(int left, int top, int right, int bottom)
+{
+  if (auto* gfx = ActiveWebGpuGfx())
+    gfx->TagPresentSource(MathUtil::Rectangle<int>(left, top, right, bottom));
+}
