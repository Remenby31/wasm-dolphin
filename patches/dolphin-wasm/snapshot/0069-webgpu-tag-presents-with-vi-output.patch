+void WebGPUGfx::TagViOutput(u32 vi_since_boot, u32 vi_since_load, u64 ticks,
+                            u32 load_generation)
+{
+  if (!m_cmd_stream.ready())
+    return;
+  // Keep the tag out of any pass, so it orders cleanly against the
+  // presenter's backbuffer pass.
+  EndPassIfOpen();
+  m_cmd_stream.PushViTag(vi_since_boot, vi_since_load, ticks, load_generation);
+}
+
+void WebGPUGfx::TagPresentSource(const MathUtil::Rectangle<int>& source_rc)
+{
+  if (!m_cmd_stream.ready() || source_rc.GetWidth() <= 0 || source_rc.GetHeight() <= 0)
+    return;
+  EndPassIfOpen();
+  m_cmd_stream.PushPresentSource(static_cast<u32>(std::max(0, source_rc.left)),
+                                 static_cast<u32>(std::max(0, source_rc.top)),
+                                 static_cast<u32>(source_rc.GetWidth()),
+                                 static_cast<u32>(source_rc.GetHeight()));
+}
