+bool WebGPUCommandStream::PushViTag(u32 vi_since_boot, u32 vi_since_load, u64 ticks)
+{
+  if (!m_header)
+    return false;
+  CmdRecord rec{};
+  rec.op = static_cast<u32>(CmdOp::ViTag);
+  rec.arg.u[0] = vi_since_boot;
+  rec.arg.u[1] = vi_since_load;
+  rec.arg.u[2] = static_cast<u32>(ticks);
+  rec.arg.u[3] = static_cast<u32>(ticks >> 32);
+  return Push(rec);
+}
