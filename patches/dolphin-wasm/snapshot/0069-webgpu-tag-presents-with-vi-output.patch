+// The live backend, for DolphinWeb_WebGpuTagViOutput (called from
+// VideoBackendBase, which does not know the backend type).
+static WebGPUGfx* s_active_gfx = nullptr;
+
 WebGPUGfx::WebGPUGfx()
 {
   m_sampler_states.fill(PackSamplerState(RenderState::GetPointSamplerState()));
   UpdateActiveConfig();
+  s_active_gfx = this;
 }
 
 WebGPUGfx::~WebGPUGfx()
 {
+  if (s_active_gfx == this)
+    s_active_gfx = nullptr;
   UpdateActiveConfig();
 }
 
+void WebGPUGfx::TagViOutput(u32 vi_since_boot, u32 vi_since_load, u64 ticks)
+{
+  if (!m_cmd_stream.ready())
+    return;
+  // Keep the tag out of any pass, so it orders cleanly against the
+  // presenter's backbuffer pass.
+  EndPassIfOpen();
+  m_cmd_stream.PushViTag(vi_since_boot, vi_since_load, ticks);
+}
