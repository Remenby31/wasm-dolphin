@@ -56,6 +56,30 @@
 void DolphinWeb_RegionInstallsWhileIdle(std::chrono::steady_clock::time_point deadline);
 #endif
 
+#ifdef __EMSCRIPTEN__
+namespace DolphinWeb
+{
+// Patch 0150 (?dupvsync=1): a duplicated XFB rearms the Rush throttle as a
+// presented one does (Presenter::ViSwap).
+std::atomic<bool> g_dup_xfb_rearms_throttle{false};
+}  // namespace DolphinWeb
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetDupXfbRearmsThrottle(int on)
+{
+  DolphinWeb::g_dup_xfb_rearms_throttle.store(on != 0, std::memory_order_relaxed);
+}
+
+// The pacing settings the core runs with, from its effective config: bit 0
+// SyncOnSkipIdle, bit 1 Rush Frame Presentation, bit 2 the 0150 rearm. The
+// harness reads it (validationReadPacingConfig) to know a switch was applied.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_PacingConfig()
+{
+  return (Config::Get(Config::MAIN_SYNC_ON_SKIP_IDLE) ? 1u : 0u) |
+         (Config::Get(Config::MAIN_RUSH_FRAME_PRESENTATION) ? 2u : 0u) |
+         (DolphinWeb::g_dup_xfb_rearms_throttle.load(std::memory_order_relaxed) ? 4u : 0u);
+}
+#endif
+
 namespace CoreTiming
 {
 static constexpr int MAX_SLICE_LENGTH = 20000;
