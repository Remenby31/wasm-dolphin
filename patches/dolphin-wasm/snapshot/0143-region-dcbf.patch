 bool RegionInterpretsInline(const PPCAnalyst::CodeOp& op)
 {
+  const UGeckoInstruction inst = op.inst;
+  // Patch 0143: dcbf and dcbst run in region code through the interpret
+  // helper (a flush loop over data stayed outside, one exit per line). With
