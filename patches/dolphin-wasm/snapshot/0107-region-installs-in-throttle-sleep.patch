+// CoreTiming's throttle sleep on the CPU thread (patch 0107): the time until
+// `deadline` installs ready regions instead of sleeping through it; the rest
+// is slept as before.
+void DolphinWeb_RegionInstallsWhileIdle(std::chrono::steady_clock::time_point deadline)
+{
+  if (s_regions_enabled.load(std::memory_order_relaxed))
+    ServiceRegionInstalls(deadline);
+}
+
+// Tests: a sleep window of `ms` from now, as the throttle would give it.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotRegionSleepWindowForTest(double ms)
+{
+  ServiceRegionInstalls(std::chrono::steady_clock::now() +
+                        std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                            std::chrono::duration<double, std::milli>(ms)));
+}
+
+// [installs done in throttle sleeps, host time they took in 0.01 ms].
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotRegionSleepInstalls(u32* out)
+{
+  out[0] = s_region_sleep_installs;
+  out[1] = static_cast<u32>(std::min(s_region_sleep_used_ms * 100.0, 4e9));
+}
