+// CoreTiming's throttle sleep on the CPU thread (patch 0107): the time until
+// `deadline` installs ready regions instead of sleeping through it; the rest
+// is slept as before.
+void DolphinWeb_RegionInstallsWhileIdle(std::chrono::steady_clock::time_point deadline)
+{
+  // Any CPU core sleeps here (Interpreter, FifoPlayer): only the
+  // CachedInterpreter runs regions.
+  if (s_regions_enabled.load(std::memory_order_relaxed) &&
+      s_region_core_active.load(std::memory_order_relaxed))
+    ServiceRegionInstalls(deadline);
+}
+
+// Tests: a sleep window of `ms` from now, as the throttle would give it.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotRegionSleepWindowForTest(double ms)
+{
+  ServiceRegionInstalls(std::chrono::steady_clock::now() +
+                        std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                            std::chrono::duration<double, std::milli>(ms)));
+}
+
+// Tests: how long a large module waits for a sleep window (ms).
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotSetSleepWaitForTest(int ms)
+{
+  s_region_sleep_wait = std::chrono::milliseconds(ms);
+}
+
+// Tests: the estimated install cost per module byte (ms), so that a test
+// module counts as one too large for a slice.
+extern "C" EMSCRIPTEN_KEEPALIVE double DolphinWeb_AotSetInstallCostForTest(double ms_per_byte)
+{
+  const double before = s_install_ms_per_byte;
+  s_install_ms_per_byte = ms_per_byte;
+  return before;
+}
+
+// [installs done in throttle sleeps, host time they took in 0.01 ms, worst
+// lateness past a sleep's deadline after its installs in 0.01 ms, installs a
+// slice did after a large module's sleep wait ran out]. Read by the region
+// stats request; reset with the session's regions (ForgetAllRegions).
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotRegionSleepInstalls(u32* out)
+{
+  out[0] = s_region_sleep_installs;
+  out[1] = static_cast<u32>(std::min(s_region_sleep_used_ms * 100.0, 4e9));
+  out[2] = static_cast<u32>(std::min(std::max(s_region_sleep_overshoot_max_ms, 0.0) * 100.0, 4e9));
+  out[3] = s_region_sleep_wait_expired;
+}
