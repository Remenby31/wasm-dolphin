diff --git a/Source/Core/Core/WasmCpuThreadDiag.h b/Source/Core/Core/WasmCpuThreadDiag.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/WasmCpuThreadDiag.h
@@ -0,0 +1,225 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// CPU-thread "other" diagnostics (patch 0213, read by the harness through
+// validationReadCpuThreadDiag, harness/lib/cpu-thread-diag.mjs): the CPU
+// thread's host time outside the timed slice parts (region stats 0075:
+// regions, blocks + dispatch, Idle; installs; headroom 0113: throttle sleep),
+// cut into the work CachedInterpreter::Run does around each slice:
+//   setup         the slice set-up (policy, burst stats, region and memory
+//                 stats requests, mode checks, BeginSlice, the region stats'
+//                 own set-up)
+//   retry         RetryDeferredWasmBlocks (off-thread waiting list visits,
+//                 deferred queue drain), with the two lists' sizes after it
+//   regionService ServiceRegionInstalls less its installs
+//   advance       CoreTiming::Advance, with each event type's callbacks
+//                 (table below); the throttle's bookkeeping (Throttle less
+//                 its sleep and installs) is inside the VI event
+//   tail          the slice close-out after the slice loop
+// Every part is net of the "nested" time it contains: throttle sleep
+// (SleepUntil), region installs (TryInstallRegion) and FlushGpu waits, all
+// counted elsewhere. The parts come from consecutive clock points of one Run
+// iteration, so setup + retry + regionService + advance + tail == control
+// (the iteration's time outside its slice loop, less nested) by
+// construction; what control misses against the harness's "other" is CPU
+// thread time outside Run's iterations (or the edge of the reads).
+// Stale-region checks (nested in other parts, never added): a region
+// re-verified before it runs (TryRunRegion, in blocks/dispatch),
+// DolphinWeb_InvalidateRegions (where the invalidation came from: guest code
+// or a DMA event) and ClearOffThreadAndRegionState (a cache clear).
+//
+// Off until DolphinWeb_CpuThreadDiagStats(n >= 0), which turns g_on on and
+// asks the CPU thread to zero the counters at its next Run iteration;
+// n == -2 turns it off; any other n < 0 only reads. Every hook reads g_on
+// once and, when it is off, takes no clock and writes nothing (the guards
+// are `if (cpu_thread_diag)` / `cpu_thread_diag ? Now() : ...`). Written by
+// the CPU thread alone, as plain doubles; the worker copies the struct as
+// whole f64s, twice, and the harness refuses a torn read.
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstring>
+#include <string_view>
+
+#include "Common/CommonTypes.h"
+
+namespace DolphinWeb::CpuThreadDiag
+{
+// Event types get a slot by first registration (a name registered again
+// after UnregisterAllEvents keeps its slot); past EVENT_SLOTS they share the
+// last entry, "(others)".
+constexpr u32 EVENT_SLOTS = 32;
+constexpr u32 NAME_BYTES = 32;
+constexpr int OTHERS_SLOT = EVENT_SLOTS;
+
+struct EventEntry
+{
+  char name[NAME_BYTES] = {};  // NUL-terminated, cut at 31 bytes
+  double us = 0;               // callback host time, net of nested time
+  double calls = 0;
+};
+
+// Layout v1 (1856 bytes, little-endian), agreed with the harness: a 16-byte
+// header, 32 f64 fields, then EVENT_SLOTS + 1 event entries of 48 bytes.
+struct Stats
+{
+  u32 version = 1;
+  u32 size_bytes = 1856;
+  u32 on = 0;
+  u32 event_slots = EVENT_SLOTS;
+  double window_us = 0;        // host time from the reset to the last iteration's start
+  double iterations = 0;       // Run iterations (slices)
+  double control_us = 0;       // iteration time outside its slice loop, less nested
+  double slice_loop_us = 0;    // inside the slice loops (regions, blocks, dispatch, Idle)
+  double nested_us = 0;        // sleep + installs + FlushGpu waits (everywhere)
+  double setup_us = 0;
+  double retry_us = 0;
+  double region_service_us = 0;
+  double advance_us = 0;       // CoreTiming::Advance from Run
+  double tail_us = 0;
+  double events_us = 0;        // every event callback (all of Advance's callers)
+  double event_calls = 0;
+  double throttle_us = 0;      // Throttle less its sleep and installs (inside an event)
+  double throttle_calls = 0;
+  double off_thread_waiting_now = 0;  // after the last retry
+  double off_thread_waiting_max = 0;
+  double off_thread_waiting_sum = 0;  // over the iterations: mean = sum / iterations
+  double deferred_now = 0;            // deferred queue entries (stored)
+  double deferred_max = 0;
+  double deferred_sum = 0;
+  double region_waiting_now = 0;      // regions waiting for their module
+  double region_waiting_max = 0;
+  double region_waiting_sum = 0;
+  double reverify_us = 0;      // TryRunRegion: an unverified region checked again
+  double reverify_calls = 0;
+  double invalidate_us = 0;    // DolphinWeb_InvalidateRegions
+  double invalidate_calls = 0;
+  double invalidate_scans = 0; // regions those invalidations looked at
+  double clear_region_state_us = 0;  // ClearOffThreadAndRegionState
+  double clear_region_state_calls = 0;
+  double spare0 = 0;
+  double spare1 = 0;
+  EventEntry events[EVENT_SLOTS + 1];
+};
+static_assert(sizeof(EventEntry) == 48);
+static_assert(offsetof(Stats, window_us) == 16);
+static_assert(offsetof(Stats, events) == 16 + 32 * 8);
+static_assert(sizeof(Stats) == 16 + 32 * 8 + (EVENT_SLOTS + 1) * 48);
+
+using Clock = std::chrono::steady_clock;
+using TimePoint = Clock::time_point;
+alignas(8) inline Stats g_stats;
+inline std::atomic<bool> g_on{false};
+inline std::atomic<bool> g_reset_request{false};
+inline TimePoint g_reset_at;
+inline u32 g_slots_used = 0;
+
+inline bool On()
+{
+  return g_on.load(std::memory_order_relaxed);
+}
+inline TimePoint Now()
+{
+  return Clock::now();
+}
+inline double Micros(Clock::duration d)
+{
+  return std::chrono::duration<double, std::micro>(d).count();
+}
+
+// The slot of an event type, from its name (CoreTimingManager::RegisterEvent,
+// diag on or not: the names are there when it is turned on).
+inline int SlotFor(std::string_view name)
+{
+  for (u32 i = 0; i < g_slots_used; ++i)
+  {
+    const char* const held = g_stats.events[i].name;
+    if (name.substr(0, NAME_BYTES - 1) == std::string_view{held, strnlen(held, NAME_BYTES)})
+      return static_cast<int>(i);
+  }
+  if (g_slots_used >= EVENT_SLOTS)
+    return OTHERS_SLOT;
+  const u32 slot = g_slots_used++;
+  const std::size_t n = std::min<std::size_t>(name.size(), NAME_BYTES - 1);
+  std::memcpy(g_stats.events[slot].name, name.data(), n);
+  g_stats.events[slot].name[n] = '\0';
+  return static_cast<int>(slot);
+}
+
+// CPU thread, at the top of a Run iteration with the diag on: applies a
+// reset (zeroes every time and count, keeps the event names).
+inline void ApplyReset(TimePoint now)
+{
+  if (!g_reset_request.load(std::memory_order_relaxed)) [[likely]]
+    return;
+  g_reset_request.exchange(false, std::memory_order_acquire);
+  Stats fresh;
+  for (u32 i = 0; i <= EVENT_SLOTS; ++i)
+    std::memcpy(fresh.events[i].name, g_stats.events[i].name, NAME_BYTES);
+  fresh.on = 1;
+  g_stats = fresh;
+  g_reset_at = now;
+}
+
+inline void AddNested(double us)
+{
+  g_stats.nested_us += us;
+}
+inline void AddEvent(int slot, Clock::duration d, double nested_before)
+{
+  const double us = Micros(d) - (g_stats.nested_us - nested_before);
+  EventEntry& e = g_stats.events[slot >= 0 && slot <= OTHERS_SLOT ? slot : OTHERS_SLOT];
+  e.us += us;
+  e.calls += 1;
+  g_stats.events_us += us;
+  g_stats.event_calls += 1;
+}
+inline void AddThrottle(Clock::duration d, double nested_before)
+{
+  g_stats.throttle_us += Micros(d) - (g_stats.nested_us - nested_before);
+  g_stats.throttle_calls += 1;
+}
+inline void NoteListSizes(double off_thread_waiting, double deferred, double region_waiting)
+{
+  Stats& s = g_stats;
+  s.off_thread_waiting_now = off_thread_waiting;
+  s.off_thread_waiting_max = std::max(s.off_thread_waiting_max, off_thread_waiting);
+  s.off_thread_waiting_sum += off_thread_waiting;
+  s.deferred_now = deferred;
+  s.deferred_max = std::max(s.deferred_max, deferred);
+  s.deferred_sum += deferred;
+  s.region_waiting_now = region_waiting;
+  s.region_waiting_max = std::max(s.region_waiting_max, region_waiting);
+  s.region_waiting_sum += region_waiting;
+}
+
+// A timed scope for a function with several returns: no clock unless on.
+struct Scope
+{
+  bool on;
+  double* us;
+  double* calls;
+  TimePoint start;
+  double nested_before;
+  Scope(bool on_, double* us_, double* calls_)
+      : on(on_), us(us_), calls(calls_), start(on_ ? Now() : TimePoint{}),
+        nested_before(on_ ? g_stats.nested_us : 0)
+  {
+  }
+  ~Scope()
+  {
+    if (on)
+    {
+      *us += Micros(Now() - start) - (g_stats.nested_us - nested_before);
+      *calls += 1;
+    }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+};
+}  // namespace DolphinWeb::CpuThreadDiag
+#endif
