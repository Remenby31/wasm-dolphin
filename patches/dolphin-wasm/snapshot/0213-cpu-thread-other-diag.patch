+namespace
+{
+// Patch 0213, CPU-thread diag (Core/WasmCpuThreadDiag.h, layout v1): one Run
+// iteration's clock points and the nested time at each (taken only with the
+// diag on): 0 start, 1 before RetryDeferredWasmBlocks, 2 after it, 3 after
+// ServiceRegionInstalls, 4 before Advance, 5 after it, 6 before the slice
+// loop, 7 after it, 8 the iteration's end.
+struct CpuThreadDiagIteration
+{
+  DolphinWeb::CpuThreadDiag::TimePoint t[9];
+  double nested[9];
+  void Mark(int i)
+  {
+    t[i] = DolphinWeb::CpuThreadDiag::Now();
+    nested[i] = DolphinWeb::CpuThreadDiag::g_stats.nested_us;
+  }
+  // Host µs from point a to b, less the nested time in between.
+  double Span(int a, int b) const
+  {
+    return DolphinWeb::CpuThreadDiag::Micros(t[b] - t[a]) - (nested[b] - nested[a]);
+  }
+};
+
+// The deferred lists' sizes, next to RetryDeferredWasmBlocks (contract
+// harnesses compile that function alone: nothing is added inside it).
+void NoteDeferredListSizes(const CachedInterpreter& cpu)
+{
+  const auto found = s_deferred_wasm_queues.find(&cpu);
+  const double deferred =
+      found == s_deferred_wasm_queues.end() ? 0.0 : static_cast<double>(found->second.Stored());
+  DolphinWeb::CpuThreadDiag::NoteListSizes(static_cast<double>(s_wasm_off_thread_waiting.size()),
+                                           deferred, static_cast<double>(s_region_waiting.size()));
+}
+
+// The iteration's parts (point 8 just marked); they add up to control.
+void FinishCpuThreadDiagIteration(const CpuThreadDiagIteration& it, const CachedInterpreter& cpu)
+{
+  auto& s = DolphinWeb::CpuThreadDiag::g_stats;
+  const double setup = it.Span(0, 1) + it.Span(3, 4) + it.Span(5, 6);
+  const double retry = it.Span(1, 2);
+  const double service = it.Span(2, 3);
+  const double advance = it.Span(4, 5);
+  const double tail = it.Span(7, 8);
+  s.setup_us += setup;
+  s.retry_us += retry;
+  s.region_service_us += service;
+  s.advance_us += advance;
+  s.tail_us += tail;
+  s.control_us += it.Span(0, 8) - it.Span(6, 7);
+  s.slice_loop_us += DolphinWeb::CpuThreadDiag::Micros(it.t[7] - it.t[6]);
+  s.iterations += 1;
+  s.window_us = DolphinWeb::CpuThreadDiag::Micros(it.t[8] - DolphinWeb::CpuThreadDiag::g_reset_at);
+  NoteDeferredListSizes(cpu);
+}
+}  // namespace
+
+// n >= 0: turns the diag on and asks the CPU thread to zero it at its next
+// Run iteration; n == -2: off; other n < 0: reads only. Returns the struct's
+// address (8-aligned). Callable from any thread: the CPU thread alone writes
+// the struct, the caller copies it.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_CpuThreadDiagStats(int n)
+{
+  if (n >= 0)
+  {
+    DolphinWeb::CpuThreadDiag::g_reset_request.store(true, std::memory_order_release);
+    DolphinWeb::CpuThreadDiag::g_on.store(true, std::memory_order_release);
+  }
+  else if (n == -2)
+  {
+    DolphinWeb::CpuThreadDiag::g_on.store(false, std::memory_order_release);
+  }
+  return static_cast<u32>(
+      reinterpret_cast<std::uintptr_t>(&DolphinWeb::CpuThreadDiag::g_stats));
+}
