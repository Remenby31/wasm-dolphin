+  // Without this, a crafted log writes anywhere in the host's memory (in
+  // WebAssembly, address 0 and up are the module's own data).
+  const bool exram = (memUpdate.address & 0x10000000) != 0;
+  u8* const base = exram ? memory.GetEXRAM() : memory.GetRAM();
+  const u32 size = exram ? memory.GetExRamSizeReal() : memory.GetRamSizeReal();
+  const u32 offset = memUpdate.address & (exram ? memory.GetExRamMask() : memory.GetRamMask());
+  if (!base || offset >= size || memUpdate.data.size() > size - offset)
+    return;
 
-  std::ranges::copy(memUpdate.data, mem);
+  std::ranges::copy(memUpdate.data, base + offset);
