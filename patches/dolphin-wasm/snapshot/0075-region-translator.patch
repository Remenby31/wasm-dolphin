+// P4 region translator, step 2: one block as a region fragment
+// (docs/region-translator.md). The block emitter runs in fragment mode (helper
+// calls relocatable, halts return 2) and the tail RunWasmBlock runs for a
+// completed block moves into the fragment: pc = npc, downcount -= the block's
+// cycles. The performance monitor is not updated on this path yet.
+namespace
+{
+std::vector<u32> s_aot_translate_out;
+std::array<u32, 248> s_aot_test_state{};
+constexpr u32 AOT_TEST_MSR = 0x00002032;  // FP, IR, DR, RI; external interrupts off
+
+WasmStateLayout CurrentWasmStateLayout(Core::System& system)
+{
+  auto& ppc = system.GetPPCState();
+  auto& memory = system.GetMemory();
+  const auto state_base = reinterpret_cast<std::uintptr_t>(&ppc);
+  const auto offset = [&](const void* field) {
+    return static_cast<u32>(reinterpret_cast<std::uintptr_t>(field) - state_base);
+  };
+  return {
+      offset(&ppc.npc), offset(ppc.gpr), offset(ppc.ps), offset(ppc.cr.fields),
+      offset(ppc.spr), offset(&ppc.msr), offset(&ppc.fpscr), offset(&ppc.feature_flags),
+      offset(&ppc.pagetable_update_pending), offset(&ppc.xer_ca), offset(&ppc.xer_so_ov),
+      offset(&ppc.xer_stringctrl), offset(&ppc.m_enable_dcache), offset(&ppc.gather_pipe_ptr),
+      offset(&ppc.gather_pipe_base_ptr),
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(memory.GetRAM())),
+      memory.GetRamSizeReal(),
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(memory.GetL1Cache())),
+      memory.GetL1CacheSize(),
+  };
+}
+
+// The block at entry_pc as the CPU thread would build it (same analyzer, same
+// direct-candidate prefix), emitted as a fragment into `out`.
+bool BuildWasmRegionFragmentForBlock(Core::System& system, u32 entry_pc, WasmFragmentRelocs* out)
+{
+  auto& ppc = system.GetPPCState();
+  PPCAnalyst::PPCAnalyzer analyzer;
+  analyzer.SetBranchFollowingEnabled(Config::Get(Config::MAIN_JIT_FOLLOW_BRANCH));
+  PPCAnalyst::CodeBuffer buffer(JIT_ORACLE_MAX_WORDS + 8);
+  PPCAnalyst::CodeBlock block;
+  const u32 next_pc = analyzer.Analyze(entry_pc, &block, &buffer, buffer.size());
+  if (block.m_memory_exception || block.m_num_instructions == 0)
+    return false;
+  u32 prefix = 0;
+  for (; prefix < block.m_num_instructions; ++prefix)
+  {
+    const PPCAnalyst::CodeOp& op = buffer[prefix];
+    if (op.branchIsIdleLoop || !IsPpcWasmDirectInstructionCandidate(op) ||
+        ((op.opinfo->flags & FL_USE_FPU) != 0 && !ppc.msr.FP))
+      break;
+    if (op.canEndBlock)
+    {
+      ++prefix;
+      break;
+    }
+  }
+  if (prefix == 0)
+    return false;
+  const bool ends_with_branch = buffer[prefix - 1].canEndBlock;
+  const u32 resume_pc = prefix == block.m_num_instructions ? next_pc : buffer[prefix].address;
+  WasmFragmentRelocs* const saved = s_wasm_fragment_relocs;
+  s_wasm_fragment_relocs = out;
+  const std::vector<u8> bytes = BuildWasmCachedInterpreterBlock(
+      std::span<const PPCAnalyst::CodeOp>{buffer.data(), prefix}, CurrentWasmStateLayout(system),
+      resume_pc, !ends_with_branch, false, false);
+  s_wasm_fragment_relocs = saved;
+  std::vector<u8>& code = out->code;
+  const std::size_t n = code.size();
+  if (bytes.empty() || n < 3 || code[n - 3] != 0x41 || code[n - 2] != 0x00 || code[n - 1] != 0x0b)
+    return false;
+  code.resize(n - 3);  // i32.const 0; end
+  const auto base = reinterpret_cast<std::uintptr_t>(&ppc);
+  const u32 pc_offset = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.pc) - base);
+  const u32 npc_offset = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.npc) - base);
+  const u32 downcount_offset =
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.downcount) - base);
+  const auto load = [&](u32 offset) {
+    code.insert(code.end(), {0x28, 0x02});
+    EmitU32Leb(code, offset);
+  };
+  const auto store = [&](u32 offset) {
+    code.insert(code.end(), {0x36, 0x02});
+    EmitU32Leb(code, offset);
+  };
+  EmitLocalGet(code, 0);
+  EmitLocalGet(code, 0);
+  load(npc_offset);
+  store(pc_offset);
+  EmitLocalGet(code, 0);
+  EmitLocalGet(code, 0);
+  load(downcount_offset);
+  EmitI32Const(code, out->cycles);
+  code.push_back(0x6b);  // i32.sub
+  store(downcount_offset);
+  EmitI32Const(code, 0);
+  code.push_back(0x0b);
+  return true;
+}
