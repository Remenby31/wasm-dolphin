+    for (u32 a = region.ranges[i] & ~0xfffu; a < region.ranges[i + 1]; a += 0x1000)
+    {
+      const u32 page = (a & 0x01ffffff) >> 12;
+      if (page < s_region_pages.size())
+        s_region_pages[page] = static_cast<u16>(s_region_pages[page] + delta);
+    }
+  }
+}
+
+void DropRegion(u32 index)
+{
+  InstalledRegion& region = s_regions[index];
+  if (!region.live)
+    return;
+  region.live = false;
+  s_region_stats.regions_dropped += 1;
+  for (const u32 pc : region.entries)
+  {
+    const auto it = s_region_at.find(pc);
+    if (it != s_region_at.end() && it->second == index)
+      s_region_at.erase(it);
+  }
+  ForEachRegionPage(region, -1);
+  s_region_filter.fill(0);
+  for (const auto& [pc, owner] : s_region_at)
+    RegionFilterAdd(pc);
+}
+
+// A cache clear (state load, full JIT cache) does not say which code changed:
+// every region is hashed again before it next runs, and dropped if its code
+// is no longer the one it was translated from.
+void UnverifyAllRegions()
+{
+  for (InstalledRegion& region : s_regions)
+    region.verified = false;
+}
+
+// On the CPU thread at a slice boundary: compile and map queued regions. A
+// region with an entry HLE hooks is left out (the block path replaces that
+// function; a region would run its original code).
+void ServiceRegionInstalls()
+{
+  if (!s_region_queue_nonempty.load(std::memory_order_acquire))
+    return;
+  double spent_ms = 0;
+  for (u32 n = 0; n < REGION_INSTALLS_PER_SLICE && spent_ms < REGION_INSTALL_BUDGET_MS; ++n)
+  {
+    PendingRegion pending;
+    {
+      std::lock_guard lock(s_region_queue_mutex);
+      if (s_region_queue.empty())
+        break;
+      pending = std::move(s_region_queue.front());
+      s_region_queue.erase(s_region_queue.begin());
+      s_region_queue_nonempty.store(!s_region_queue.empty(), std::memory_order_release);
+    }
+    if (std::any_of(pending.entries.begin(), pending.entries.end(),
+                    [](u32 pc) { return HLE::GetHookByAddress(pc) != 0; }))
+    {
+      s_region_stats.regions_hle_refused += 1;
+      continue;
+    }
+    // The code may have changed since the translation (an overlay, code
+    // reloaded): an icbi then found no region to drop. Checked against the
+    // plan's hashes, not against whatever memory holds now.
+    if (!RegionCodeMatchesPlan(pending.ranges, pending.members))
+    {
+      s_region_stats.regions_refused += 1;
+      continue;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    const int handle = CompileWasmCachedInterpreterBlockForTest(pending.bytes, true);
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    spent_ms += ms;
+    s_region_stats.install_ms += ms;
+    if (ms < 0.5)
+      s_region_stats.installs_fast += 1;
+    if (handle <= 0)
+    {
+      s_region_stats.regions_refused += 1;
+      continue;
+    }
+    s_region_stats.regions_installed += 1;
+    const u32 index = static_cast<u32>(s_regions.size());
+    s_regions.push_back({handle, std::move(pending.entries), std::move(pending.ranges),
+                         std::move(pending.members), true, true});
+    for (const u32 pc : s_regions.back().entries)
+    {
+      s_region_at.emplace(pc, index);  // an entry already mapped keeps its region
+      RegionFilterAdd(pc);
+    }
+    ForEachRegionPage(s_regions.back(), +1);
+  }
+  s_region_stats.install_max_slice_ms = std::max(s_region_stats.install_max_slice_ms, spent_ms);
+}
+
+// CPU thread, at a slice boundary: a pending stats request (reset, sampling)
+// is applied, and the diagnostics other threads feed are published.
+std::atomic<int> s_region_stats_request{-1};
+std::atomic<u32> s_regions_queued{0};
+u32 s_publish_counter = 0;
+
+void PublishRegionStats()
+{
+  s_region_stats.regions_queued = s_regions_queued.load(std::memory_order_relaxed);
+  s_region_stats.entries_mapped = static_cast<double>(s_region_at.size());
+  s_region_stats.regions_enabled = s_regions_enabled.load(std::memory_order_relaxed) ? 1 : 0;
+  std::vector<std::pair<double, u32>> top;
+  top.reserve(s_miss_cycles.size());
+  for (const auto& [pc, cycles] : s_miss_cycles)
+    top.emplace_back(cycles, pc);
+  const std::size_t n = std::min<std::size_t>(3, top.size());
+  std::partial_sort(top.begin(), top.begin() + n, top.end(), std::greater<>());
+  for (std::size_t i = 0; i < 3; ++i)
+  {
+    s_region_stats.top_miss[2 * i] = i < n ? top[i].second : 0;
+    s_region_stats.top_miss[2 * i + 1] = i < n ? top[i].first : 0;
+  }
+}
+
+void ApplyRegionStatsRequest()
+{
+  const int request = s_region_stats_request.exchange(-1, std::memory_order_acq_rel);
+  if (request >= 0)
+  {
+    const RegionStats kept = s_region_stats;
+    s_region_stats = RegionStats{};
+    s_region_stats.regions_installed = kept.regions_installed;
+    s_region_stats.regions_refused = kept.regions_refused;
+    s_region_stats.regions_dropped = kept.regions_dropped;
+    s_region_stats.regions_hle_refused = kept.regions_hle_refused;
+    s_region_stats.install_ms = kept.install_ms;
+    s_region_stats.install_max_slice_ms = kept.install_max_slice_ms;
+    s_region_stats.installs_fast = kept.installs_fast;
+    s_miss_cycles.clear();
+    s_region_stats.sample_every = static_cast<u32>(request);
+    s_last_timed_ms = 0;
+    s_sampled_lookup_ms = 0;
+    s_sampled_lookups = 0;
+    s_clock_pair_ms = request > 0 ? MeasureClockPairMs() : 0;
+    s_region_stats_on = true;
+    PublishRegionStats();
+  }
+  else if (s_region_stats_on && (++s_publish_counter & 63) == 0)
+  {
+    PublishRegionStats();
+  }
+}
+
+// Runs the region holding pc. False when there is none (or it refuses the
+// pc): the caller dispatches a block.
+bool TryRunRegion(PowerPC::PowerPCState& ppc_state)
+{
+  if (!RegionFilterHas(ppc_state.pc))
+    return false;
+  // Regions keep no performance monitor counts (the block path does).
+  if (!ppc_state.msr.IR || !ppc_state.msr.DR || !ppc_state.msr.FP ||
+      (ppc_state.feature_flags & FEATURE_FLAG_PERFMON) != 0)
+  {
+    if (s_region_stats_on)
+      s_region_stats.mode_refusals += 1;
+    return false;
+  }
+  const auto it = s_region_at.find(ppc_state.pc);
+  if (it == s_region_at.end())
+  {
+    if (s_region_stats_on)
+      s_region_stats.filter_false_hits += 1;
+    return false;
+  }
+  InstalledRegion& region = s_regions[it->second];
+  if (!region.verified)
+  {
+    if (!RegionCodeMatchesPlan(region.ranges, region.members))
+    {
+      DropRegion(it->second);
+      return false;
+    }
+    region.verified = true;
+  }
+  using RegionFunction = int (*)(int);
+  const auto run = reinterpret_cast<RegionFunction>(
+      static_cast<std::uintptr_t>(s_regions[it->second].handle));
+  const s32 downcount = ppc_state.downcount;
+  int code;
+  if (s_region_stats_on && s_region_stats.sample_every != 0)
+  {
+    // Every region call is timed (they are few: a region runs until it
+    // leaves its code or downcount runs out).
+    const auto start = std::chrono::steady_clock::now();
+    code = run(static_cast<int>(reinterpret_cast<std::uintptr_t>(&ppc_state)));
+    const double ms =
+        std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count() -
+        s_clock_pair_ms;
+    s_region_stats.region_time_ms += std::max(ms, 0.0);
+  }
+  else
+  {
+    code = run(static_cast<int>(reinterpret_cast<std::uintptr_t>(&ppc_state)));
+  }
+  if (s_region_stats_on)
+  {
+    s_region_stats.region_calls += 1;
+    s_region_stats.region_cycles += static_cast<double>(downcount - ppc_state.downcount);
+    if (code == 1)
+      s_region_stats.region_not_entry += 1;
+    else if (code == 2)
+      s_region_stats.region_stops += 1;
+  }
+  return code != 1;
+}
+// Block chaining stops where a region would run: at a mapped entry, in the
+// mode regions run in.
+inline bool RegionWouldRun(const PowerPC::PowerPCState& ppc_state)
+{
+  if (!s_regions_enabled.load(std::memory_order_relaxed) || !RegionFilterHas(ppc_state.pc) ||
+      !ppc_state.msr.IR || !ppc_state.msr.DR || !ppc_state.msr.FP ||
+      (ppc_state.feature_flags & FEATURE_FLAG_PERFMON) != 0 ||
+      !s_region_at.contains(ppc_state.pc))
+    return false;
+  if (s_region_stats_on)
+    s_region_stats.chain_breaks += 1;
+  return true;
+}
