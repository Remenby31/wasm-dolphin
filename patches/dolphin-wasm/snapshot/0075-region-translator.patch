+// Helper imports in index order (the block module's import section).
+constexpr std::array<const char*, 20> WASM_IMPORT_NAMES = {
+    "read_u32", "write_u32", "read_u8", "write_u8", "read_u16", "write_u16", "lfs",
+    "stfs", "lfd", "fmr", "system", "fp", "fctiwz", "interpret", "fastcheck_gpfifo",
+    "fast_os_interrupt_call", "fast_melee_input_status_call", "fast_melee_status_call",
+    "fast_melee_service_poll_call", "fma"};
+
+// Region fragments (P4): while a collector is installed, helper calls are
+// emitted with a 5-byte padded LEB index and recorded, so the region
+// assembler can renumber them by name. Block modules never install one: their
+// bytes, and so their cache keys, stay as they were.
+struct WasmFragmentRelocs
+{
+  struct Reloc
+  {
+    std::size_t offset;  // of the LEB in the body being emitted
+    const char* name;
+  };
+  std::vector<Reloc> relocs;
+};
+thread_local WasmFragmentRelocs* s_wasm_fragment_relocs = nullptr;
+
+void EmitPaddedU32Leb(std::vector<u8>& out, u32 value)
+{
+  for (int i = 0; i < 4; ++i, value >>= 7)
+    out.push_back(static_cast<u8>((value & 0x7f) | 0x80));
+  out.push_back(static_cast<u8>(value & 0x7f));
+}
+
+void EmitCallImport(std::vector<u8>& body, u32 index)
+{
+  body.push_back(0x10);  // call
+  if (!s_wasm_fragment_relocs)
+  {
+    EmitU32Leb(body, index);
+    return;
+  }
+  s_wasm_fragment_relocs->relocs.push_back({body.size(), WASM_IMPORT_NAMES[index]});
+  EmitPaddedU32Leb(body, index);
+}
