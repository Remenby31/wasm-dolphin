+// Test CPU for region equivalence: the oracle's memory and BATs, MSR with FP
+// and translation on. Returns the PowerPCState address (the region's state
+// argument); RAM is at DolphinWeb_AotTestRam.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_AotTestSetUp()
+{
+  auto& system = Core::System::GetInstance();
+  if (!JitOracleSetUp(system))
