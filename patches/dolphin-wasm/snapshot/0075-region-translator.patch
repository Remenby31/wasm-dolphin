+// A function of a region: its ranges (indexes into the region's ranges) and
+// the plan's FNV-1a 64 of their code (src/aot-plan.js regionHash), the code
+// the translator checked. 0: no hash known.
+struct RegionMember
+{
+  u32 first_range = 0;
+  u32 range_count = 0;
+  u64 hash = 0;
+};
+
+struct InstalledRegion
+{
+  int handle = 0;
