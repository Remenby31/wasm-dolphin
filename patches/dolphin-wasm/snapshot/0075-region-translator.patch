+// Queues a region module for installation (any thread). bytes: the module
+// (src/aot-region-module.js); entries: its entry PCs; ranges: [start, end)
+// pairs of the guest code it was translated from, member after member;
+// members: (range count, hash lo, hash hi) per function, the plan's FNV-1a 64
+// of its ranges. A region whose code no longer matches is never installed.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotQueueRegion(const u8* bytes, u32 size,
+                                                               const u32* entries, u32 entry_count,
+                                                               const u32* ranges, u32 range_count,
+                                                               const u32* members, u32 member_count)
+{
+  PendingRegion pending{std::vector<u8>(bytes, bytes + size),
+                        std::vector<u32>(entries, entries + entry_count),
+                        std::vector<u32>(ranges, ranges + 2 * std::size_t{range_count}),
+                        {}};
+  u32 next = 0;
+  for (u32 i = 0; i < member_count; ++i)
+  {
+    const u32 count = members[3 * i];
+    if (next + count > range_count)
+      return;  // malformed: nothing queued
+    pending.members.push_back(
+        {next, count, (u64{members[3 * i + 2]} << 32) | members[3 * i + 1]});
+    next += count;
+  }
+  if (next != range_count || pending.members.empty())
+    return;
+  std::lock_guard lock(s_region_queue_mutex);
+  s_region_queue.push_back(std::move(pending));
+  s_region_queue_nonempty.store(true, std::memory_order_release);
+  s_regions_queued.fetch_add(1, std::memory_order_relaxed);
+}
