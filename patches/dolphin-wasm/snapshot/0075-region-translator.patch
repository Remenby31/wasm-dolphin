+// without the final `i32.const 0; end`), the PCs control can reach statically
+// when it ends, and the target of a closing b/bl.
+struct FragmentBlock
+{
+  u32 start = 0;
+  std::vector<u8> expr;
+  std::vector<WasmFragmentRelocs::Reloc> relocs;  // offsets in expr
+  u32 cycles = 0;
+  std::vector<u32> successors;
+  u32 jump_target = UINT32_MAX;
+};
+
+// Locals of a block body without the fastmem hoist (the only layout a
+// fragment takes: its blocks share the function's locals).
+constexpr std::array<u8, 13> WASM_BLOCK_LOCALS = {0x06, 0x03, 0x7f, 0x02, 0x7e, 0x01, 0x7c,
+                                                  0x01, 0x7f, 0x20, 0x7f, 0x10, 0x7c};
+constexpr u32 WASM_FRAGMENT_PC_LOCAL = 56;  // appended after the block locals 1..55
+
+// The block at pc as the CPU thread would build it (same analyzer, same
+// direct-candidate prefix), emitted in fragment mode.
+bool BuildFragmentBlock(Core::System& system, u32 pc, FragmentBlock* out)
+{
+  auto& ppc = system.GetPPCState();
+  PPCAnalyst::PPCAnalyzer analyzer;
+  analyzer.SetBranchFollowingEnabled(Config::Get(Config::MAIN_JIT_FOLLOW_BRANCH));
+  PPCAnalyst::CodeBuffer buffer(JIT_ORACLE_MAX_WORDS + 8);
+  PPCAnalyst::CodeBlock block;
+  const u32 next_pc = analyzer.Analyze(pc, &block, &buffer, buffer.size());
+  if (block.m_memory_exception || block.m_num_instructions == 0)
+    return false;
+  u32 prefix = 0;
+  for (; prefix < block.m_num_instructions; ++prefix)
+  {
+    const PPCAnalyst::CodeOp& op = buffer[prefix];
+    if (op.branchIsIdleLoop || !IsPpcWasmDirectInstructionCandidate(op) ||
+        ((op.opinfo->flags & FL_USE_FPU) != 0 && !ppc.msr.FP))
+      break;
+    if (op.canEndBlock)
+    {
