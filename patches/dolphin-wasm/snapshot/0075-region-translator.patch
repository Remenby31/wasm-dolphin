+extern "C" EMSCRIPTEN_KEEPALIVE const char* DolphinWeb_JitHelperName(u32 index)
+{
+  return index < WASM_IMPORT_NAMES.size() ? WASM_IMPORT_NAMES[index] : nullptr;
+}
+
+// Translates the block at entry_pc of the guest RAM (set up by
+// DolphinWeb_AotTestSetUp, filled by the caller). Returns u32 words: entry,
+// code length, reloc count, (offset, helper index) per reloc, then the code
+// bytes packed little-endian; null when the block cannot be translated.
+extern "C" EMSCRIPTEN_KEEPALIVE const u32* DolphinWeb_AotTranslateForTest(u32 entry_pc,
+                                                                          u32 disable_mask)
+{
+  auto& system = Core::System::GetInstance();
+  WasmFragmentRelocs fragment;
+  const u32 saved_mask = s_dolphin_web_disable_mask.exchange(disable_mask);
+  const bool built = BuildWasmRegionFragmentForBlock(system, entry_pc, &fragment);
+  s_dolphin_web_disable_mask.store(saved_mask);
+  if (!built)
+    return nullptr;
+  auto& out = s_aot_translate_out;
+  out.assign({entry_pc, static_cast<u32>(fragment.code.size()),
+              static_cast<u32>(fragment.relocs.size())});
+  for (const auto& reloc : fragment.relocs)
+  {
+    const auto it = std::find(WASM_IMPORT_NAMES.begin(), WASM_IMPORT_NAMES.end(), reloc.name);
+    out.push_back(static_cast<u32>(reloc.offset));
+    out.push_back(static_cast<u32>(it - WASM_IMPORT_NAMES.begin()));
+  }
+  const std::size_t words = out.size();
+  out.resize(words + (fragment.code.size() + 3) / 4);
+  std::memcpy(out.data() + words, fragment.code.data(), fragment.code.size());
+  return out.data();
+}
