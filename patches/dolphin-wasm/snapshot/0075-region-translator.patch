+// Code at [address, address + size) changed (icbi, DMA, a cache clear):
+// regions covering it are dropped. From JitInterface.
+void DolphinWeb_InvalidateRegions(u32 address, u32 size)
+{
+  if (s_region_at.empty())
+    return;
+  // MEM1 offsets: the 0x8 and 0xC views and DMA (physical) addresses meet.
+  const u64 begin = address & 0x01ffffff;
+  const u64 end = size >= 0x01800000 ? u64{0x01800000} : begin + size;
+  bool covered = false;
+  for (u64 a = begin & ~u64{0xfff}; a < end && !covered; a += 0x1000)
+    covered = (a >> 12) < s_region_pages.size() && s_region_pages[a >> 12] != 0;
+  if (!covered)
+    return;
+  for (u32 index = 0; index < s_regions.size(); ++index)
+  {
+    const InstalledRegion& region = s_regions[index];
+    for (std::size_t i = 0; region.live && i + 1 < region.ranges.size(); i += 2)
+    {
+      const u64 start = region.ranges[i] & 0x01ffffff;
+      const u64 stop = start + (region.ranges[i + 1] - region.ranges[i]);
+      if (start < end && begin < stop)
+        DropRegion(index);
+    }
+  }
+}
