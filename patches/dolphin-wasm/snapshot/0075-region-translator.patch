+// P4 region translator (docs/region-translator.md): a function as a region
+// fragment. The block emitter runs in fragment mode (helper calls
+// relocatable, halts return 2) and the tail RunWasmBlock runs for a completed
+// block moves into the fragment: pc = npc, downcount -= the block's cycles.
+// The performance monitor is not updated on this path yet.
+namespace
+{
+std::vector<u32> s_aot_translate_out;
+std::array<u32, 248> s_aot_test_state{};
+constexpr u32 AOT_TEST_MSR = 0x00002032;  // FP, IR, DR, RI; external interrupts off
+
+WasmStateLayout CurrentWasmStateLayout(Core::System& system)
+{
+  auto& ppc = system.GetPPCState();
+  auto& memory = system.GetMemory();
+  const auto state_base = reinterpret_cast<std::uintptr_t>(&ppc);
+  const auto offset = [&](const void* field) {
+    return static_cast<u32>(reinterpret_cast<std::uintptr_t>(field) - state_base);
+  };
+  return {
+      offset(&ppc.npc), offset(ppc.gpr), offset(ppc.ps), offset(ppc.cr.fields),
+      offset(ppc.spr), offset(&ppc.msr), offset(&ppc.fpscr), offset(&ppc.feature_flags),
+      offset(&ppc.pagetable_update_pending), offset(&ppc.xer_ca), offset(&ppc.xer_so_ov),
+      offset(&ppc.xer_stringctrl), offset(&ppc.m_enable_dcache), offset(&ppc.gather_pipe_ptr),
+      offset(&ppc.gather_pipe_base_ptr),
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(memory.GetRAM())),
+      memory.GetRamSizeReal(),
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(memory.GetL1Cache())),
+      memory.GetL1CacheSize(),
+  };
+}
+
+// A block of a fragment: its expression (the block body without locals and
+// without the final `i32.const 0; end`), the PCs control can reach statically
+// when it ends, and the target of a closing b/bl.
+// Set while DolphinWeb_AotTranslate runs on this thread: regions run with
+// FP on only (TryRunRegion), so FP instructions are taken whatever the CPU's
+// MSR is now.
+thread_local bool t_aot_translating = false;
+
+struct FragmentBlock
+{
+  u32 start = 0;
+  std::vector<u8> expr;
+  std::vector<WasmFragmentRelocs::Reloc> relocs;  // offsets in expr
+  u32 cycles = 0;
+  std::vector<u32> successors;
+  u32 jump_target = UINT32_MAX;
+  // Ends with an instruction that ends a block without branching (isync
+  // after icbi, sc, rfi, mtmsr...): the region returns to the dispatcher
+  // there, as the block JIT does, so invalidated code is never run on.
+  bool exits = false;
+};
+
+// Locals of a block body without the fastmem hoist (the only layout a
+// fragment takes: its blocks share the function's locals).
+constexpr std::array<u8, 13> WASM_BLOCK_LOCALS = {0x06, 0x03, 0x7f, 0x02, 0x7e, 0x01, 0x7c,
+                                                  0x01, 0x7f, 0x20, 0x7f, 0x10, 0x7c};
+constexpr u32 WASM_FRAGMENT_PC_LOCAL = 56;  // appended after the block locals 1..55
+
+// The block at pc as the CPU thread would build it (same analyzer, same
+// direct-candidate prefix), emitted in fragment mode. A region holds only
+// code inside its ranges (invalidation drops it by those ranges): no branch
+// following (a call is a jump, its return point an entry), and the block
+// stops at `limit`, the end of the range holding pc.
+bool BuildFragmentBlock(Core::System& system, u32 pc, u32 limit, FragmentBlock* out)
+{
+  auto& ppc = system.GetPPCState();
+  PPCAnalyst::PPCAnalyzer analyzer;
+  analyzer.SetBranchFollowingEnabled(false);
+  PPCAnalyst::CodeBuffer buffer(JIT_ORACLE_MAX_WORDS + 8);
+  PPCAnalyst::CodeBlock block;
+  const std::size_t max_ops =
+      std::min<std::size_t>(buffer.size(), limit > pc ? (limit - pc) / 4 : 1);
+  const u32 next_pc = analyzer.Analyze(pc, &block, &buffer, max_ops);
+  if (block.m_memory_exception || block.m_num_instructions == 0)
+    return false;
+  u32 prefix = 0;
+  for (; prefix < block.m_num_instructions; ++prefix)
+  {
+    const PPCAnalyst::CodeOp& op = buffer[prefix];
+    if (op.branchIsIdleLoop || !IsPpcWasmDirectInstructionCandidate(op) ||
+        ((op.opinfo->flags & FL_USE_FPU) != 0 && !ppc.msr.FP && !t_aot_translating))
+      break;
+    if (op.canEndBlock)
+    {
+      ++prefix;
+      break;
+    }
+  }
+  if (prefix == 0)
+    return false;
+  const u32 resume_pc = prefix == block.m_num_instructions ? next_pc : buffer[prefix].address;
+  if (prefix < block.m_num_instructions)
+  {
+    // The analysis of the whole block lets an op skip state a later op
+    // overwrites (FPRF, CR fields, discardable GPRs). Past the prefix those
+    // later ops run outside the region, after a block boundary where the
+    // region can exit on downcount and an interrupt see that state: analyze
+    // the prefix alone.
+    analyzer.Analyze(pc, &block, &buffer, prefix);
+    if (block.m_memory_exception || block.m_num_instructions != prefix)
+      return false;
+  }
+  const PPCAnalyst::CodeOp& last = buffer[prefix - 1];
+  const bool ends_with_branch = last.canEndBlock;
+  WasmFragmentRelocs fragment;
+  WasmFragmentRelocs* const saved = s_wasm_fragment_relocs;
+  s_wasm_fragment_relocs = &fragment;
+  const std::vector<u8> bytes = BuildWasmCachedInterpreterBlock(
+      std::span<const PPCAnalyst::CodeOp>{buffer.data(), prefix}, CurrentWasmStateLayout(system),
+      resume_pc, !ends_with_branch, false, false);
+  s_wasm_fragment_relocs = saved;
+  const std::vector<u8>& code = fragment.code;
+  const std::size_t n = code.size();
+  if (bytes.empty() || n < WASM_BLOCK_LOCALS.size() + 3 ||
+      !std::equal(WASM_BLOCK_LOCALS.begin(), WASM_BLOCK_LOCALS.end(), code.begin()) ||
+      code[n - 3] != 0x41 || code[n - 2] != 0x00 || code[n - 1] != 0x0b)
+    return false;
+  out->start = pc;
+  out->expr.assign(code.begin() + WASM_BLOCK_LOCALS.size(), code.end() - 3);
+  out->relocs = fragment.relocs;
+  for (auto& reloc : out->relocs)
+    reloc.offset -= WASM_BLOCK_LOCALS.size();
+  out->cycles = fragment.cycles;
+  if (!ends_with_branch)
+  {
+    out->successors.push_back(resume_pc);
+    // The prefix stopped at an instruction the direct tier does not take: it
+    // runs outside the region, which picks up again after it.
+    if (prefix < block.m_num_instructions)
+      out->successors.push_back(resume_pc + 4);
+    return true;
+  }
+  const UGeckoInstruction inst = last.inst;
+  // bc, b, bclr, bcctr (isync and rfi are opcode 19 too, but do not branch).
+  const bool branch = inst.OPCD == 16 || inst.OPCD == 18 ||
+                      (inst.OPCD == 19 && (inst.SUBOP10 == 16 || inst.SUBOP10 == 528));
+  if (!branch)
+  {
+    out->exits = true;  // sc, rfi, isync, ...: back to the dispatcher
+    return true;
+  }
+  if (last.branchTo != UINT32_MAX)
+    out->successors.push_back(last.branchTo);
+  const bool conditional = inst.OPCD != 18 && (inst.BO & 0x14) != 0x14;
+  if (conditional || inst.LK)
+    out->successors.push_back(last.address + 4);
+  if (inst.OPCD == 18 && last.branchTo != UINT32_MAX)
+    out->jump_target = last.branchTo;
+  return true;
+}
+
+struct RegionFragment
+{
+  std::vector<u32> entries;  // block starts, the entry first
+  std::vector<u8> code;
+  struct Reloc
+  {
+    u32 offset;
+    u32 kind;   // 0 import, 1 jump, 2 dispatch
+    u32 value;  // helper index, target pc, 0
+  };
+  std::vector<Reloc> relocs;
+};
+
+// The blocks of a function reachable from its entry through static
+// successors inside `ranges` (at most max_blocks), as one fragment:
+//   loop: pc = state.pc; for each block: if pc == start { body; pc = npc;
+//         downcount -= cycles; if downcount <= 0 return 0;
+//         b/bl out of the fragment: return_call jump(target), else re-enter
+//         the loop }; no block at pc: return_call dispatch
+// Halts inside a body return 2.
+bool BuildRegionFragment(Core::System& system, u32 entry_pc, std::span<const u32> ranges,
+                         u32 max_blocks, RegionFragment* out)
+{
+  // End of the range holding pc, 0 when none does.
+  const auto range_end = [&](u32 pc) -> u32 {
+    for (std::size_t i = 0; i + 1 < ranges.size(); i += 2)
+      if (pc >= ranges[i] && pc < ranges[i + 1])
+        return ranges[i + 1];
+    return 0;
+  };
+  const auto inside = [&](u32 pc) { return range_end(pc) != 0; };
+  std::vector<FragmentBlock> blocks;
+  std::vector<u32> work{entry_pc};
+  std::unordered_set<u32> seen{entry_pc};
+  while (!work.empty() && blocks.size() < max_blocks)
+  {
+    const u32 pc = work.front();
+    work.erase(work.begin());
+    FragmentBlock fb;
+    // The entry may lie outside the ranges (a test's single block): one block.
+    const u32 limit = inside(pc) ? range_end(pc) : pc + 4 * (JIT_ORACLE_MAX_WORDS + 8);
+    if (!BuildFragmentBlock(system, pc, limit, &fb))
+    {
+      if (pc == entry_pc)
+        return false;
+      // Stays outside (dispatch); the region picks up again after it.
+      if (inside(pc + 4) && seen.insert(pc + 4).second)
+        work.push_back(pc + 4);
+      continue;
+    }
+    for (const u32 next : fb.successors)
+    {
+      if ((next & 3) == 0 && inside(next) && seen.insert(next).second)
+        work.push_back(next);
+    }
+    blocks.push_back(std::move(fb));
+  }
+  std::unordered_set<u32> starts;
+  for (const auto& b : blocks)
+    starts.insert(b.start);
+
+  auto& ppc = system.GetPPCState();
+  const auto base = reinterpret_cast<std::uintptr_t>(&ppc);
+  const u32 pc_offset = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.pc) - base);
+  const u32 npc_offset = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.npc) - base);
+  const u32 downcount_offset =
+      static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.downcount) - base);
+  std::vector<u8>& code = out->code;
+  const auto load = [&](u32 offset) {
+    code.insert(code.end(), {0x28, 0x02});
+    EmitU32Leb(code, offset);
+  };
+  const auto store = [&](u32 offset) {
+    code.insert(code.end(), {0x36, 0x02});
+    EmitU32Leb(code, offset);
+  };
+  const auto reloc_site = [&](u32 kind, u32 value) {
+    code.push_back(0x12);  // return_call
+    out->relocs.push_back({static_cast<u32>(code.size()), kind, value});
+    EmitPaddedU32Leb(code, 0);
+  };
+  code.assign(WASM_BLOCK_LOCALS.begin(), WASM_BLOCK_LOCALS.end());
+  code[0] = 0x07;
+  code.insert(code.end(), {0x01, 0x7f});  // the dispatch pc
+  code.insert(code.end(), {0x03, 0x40});  // loop
+  EmitLocalGet(code, 0);
+  load(pc_offset);
+  EmitLocalSet(code, WASM_FRAGMENT_PC_LOCAL);
+  for (const auto& b : blocks)
+  {
+    out->entries.push_back(b.start);
+    EmitLocalGet(code, WASM_FRAGMENT_PC_LOCAL);
+    EmitI32Const(code, b.start);
+    code.insert(code.end(), {0x46, 0x04, 0x40});  // i32.eq; if
+    const u32 at = static_cast<u32>(code.size());
+    code.insert(code.end(), b.expr.begin(), b.expr.end());
+    for (const auto& reloc : b.relocs)
+    {
+      const auto it = std::find(WASM_IMPORT_NAMES.begin(), WASM_IMPORT_NAMES.end(), reloc.name);
+      out->relocs.push_back({at + static_cast<u32>(reloc.offset), 0,
+                             static_cast<u32>(it - WASM_IMPORT_NAMES.begin())});
+    }
+    EmitLocalGet(code, 0);
+    EmitLocalGet(code, 0);
+    load(npc_offset);
+    store(pc_offset);
+    EmitLocalGet(code, 0);
+    EmitLocalGet(code, 0);
+    load(downcount_offset);
+    EmitI32Const(code, b.cycles);
+    code.push_back(0x6b);  // i32.sub
+    store(downcount_offset);
+    EmitLocalGet(code, 0);
+    load(downcount_offset);
+    EmitI32Const(code, 0);
+    code.insert(code.end(), {0x4c, 0x04, 0x40});  // i32.le_s; if
+    EmitI32Const(code, 0);
+    code.insert(code.end(), {0x0f, 0x0b});  // return; end
+    if (b.exits)
+    {
+      EmitI32Const(code, 0);
+      code.push_back(0x0f);  // return
+    }
+    else if (b.jump_target != UINT32_MAX && !starts.contains(b.jump_target))
+    {
+      EmitLocalGet(code, 0);
+      reloc_site(1, b.jump_target);
+    }
+    else
+    {
+      code.insert(code.end(), {0x0c, 0x01});  // br to the loop
+    }
+    code.push_back(0x0b);  // end if
+  }
+  EmitLocalGet(code, 0);
+  reloc_site(2, 0);
+  code.insert(code.end(), {0x0b, 0x00, 0x0b});  // end loop; unreachable; end
+  return true;
+}
+}  // namespace
+
+extern "C" EMSCRIPTEN_KEEPALIVE const char* DolphinWeb_JitHelperName(u32 index)
+{
+  return index < WASM_IMPORT_NAMES.size() ? WASM_IMPORT_NAMES[index] : nullptr;
+}
+
+// Translates the function at entry_pc of the guest RAM (set up by
+// DolphinWeb_AotTestSetUp, filled by the caller): its blocks inside `ranges`
+// (range_count [start, end) pairs), at most max_blocks. Returns u32 words:
+// entry, code length, entry count, reloc count, the entries, (offset, kind,
+// value) per reloc, then the code bytes packed little-endian; null when the
+// block at the entry cannot be translated.
+extern "C" EMSCRIPTEN_KEEPALIVE const u32* DolphinWeb_AotTranslateForTest(
+    u32 entry_pc, u32 disable_mask, const u32* ranges, u32 range_count, u32 max_blocks)
+{
+  auto& system = Core::System::GetInstance();
+  RegionFragment fragment;
+  const u32 saved_mask = s_dolphin_web_disable_mask.exchange(disable_mask);
+  const bool built = BuildRegionFragment(
+      system, entry_pc, std::span<const u32>{ranges, 2 * std::size_t{range_count}},
+      std::max<u32>(max_blocks, 1), &fragment);
+  s_dolphin_web_disable_mask.store(saved_mask);
+  if (!built)
+    return nullptr;
+  auto& out = s_aot_translate_out;
+  out.assign({entry_pc, static_cast<u32>(fragment.code.size()),
+              static_cast<u32>(fragment.entries.size()),
+              static_cast<u32>(fragment.relocs.size())});
+  out.insert(out.end(), fragment.entries.begin(), fragment.entries.end());
+  for (const auto& reloc : fragment.relocs)
+    out.insert(out.end(), {reloc.offset, reloc.kind, reloc.value});
+  const std::size_t words = out.size();
+  out.resize(words + (fragment.code.size() + 3) / 4);
+  std::memcpy(out.data() + words, fragment.code.data(), fragment.code.size());
+  return out.data();
+}
+
+// Production region translator (P7, src/aot-orchestrator.js), callable on any
+// pthread of the module but the CPU thread: the mask is this call's, the
+// emitter state thread_local, guest code read from MEM1 through the 0x8 and
+// 0xC views (no MMU, no TLB, whatever the CPU's mode), and the plan's FNV-1a
+// 64 of the ranges checked before and after (the game may write its code
+// meanwhile). Output: [status, entry, codeLength, entryCount, relocCount, 0],
+// entries, relocs (offset, kind, value), code; valid until the next call on
+// the same thread. Status: 0 ok, 1 hash-mismatch, 2 untranslatable,
+// 3 too-large, 4 not-ready, 5 budget (unused).
+namespace
+{
+// Bumped whenever the code the translator emits changes (cache keys).
+constexpr u32 AOT_COMPILER_VERSION = 1;
+constexpr u32 AOT_MAX_FRAGMENT_BYTES = 1u << 20;
+thread_local std::vector<u32> t_aot_out;
+u8* s_aot_ram = nullptr;
+u32 s_aot_ram_size = 0;
+
+PPCAnalyst::InstructionRead AotReadInstruction(u32 address)
+{
+  const u32 view = address >> 28;
+  const u32 physical = address & 0x01ffffff;
+  if ((view != 0x8 && view != 0xc) || (address & 0x0e000000) != 0 || (address & 3) != 0 ||
+      physical + 4 > s_aot_ram_size)
+    return {false, 0, 0};
+  const u8* p = s_aot_ram + physical;
+  return {true, (u32{p[0]} << 24) | (u32{p[1]} << 16) | (u32{p[2]} << 8) | p[3], physical};
+}
+
+// FNV-1a 64 of the ranges, bytes in memory order (src/aot-plan.js regionHash);
+// false when a word is outside MEM1.
+bool AotRangesHash(std::span<const u32> ranges, u64* hash)
+{
+  u64 h = 0xcbf29ce484222325ull;
+  for (std::size_t i = 0; i + 1 < ranges.size(); i += 2)
+  {
+    for (u32 a = ranges[i]; a < ranges[i + 1]; a += 4)
+    {
+      const auto read = AotReadInstruction(a);
+      if (!read.valid)
+        return false;
+      for (int shift = 24; shift >= 0; shift -= 8)
+      {
+        h ^= (read.hex >> shift) & 0xff;
+        h *= 0x100000001b3ull;
+      }
+    }
+  }
+  *hash = h;
+  return true;
+}
+
+const u32* AotStatus(u32 status, u32 entry)
+{
+  t_aot_out.assign({status, entry, 0, 0, 0, 0});
+  return t_aot_out.data();
+}
+}  // namespace
+
+extern "C" EMSCRIPTEN_KEEPALIVE const u32* DolphinWeb_AotTranslate(u32 entry_pc, u32 mask,
+                                                                   const u32* ranges,
+                                                                   u32 range_count, u32 max_blocks,
+                                                                   u32 hash_lo, u32 hash_hi)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  if (!memory.GetRAM())
+    return AotStatus(4, entry_pc);
+  s_aot_ram = memory.GetRAM();
+  s_aot_ram_size = memory.GetRamSizeReal();
+  const std::span<const u32> range_span{ranges, 2 * std::size_t{range_count}};
+  // The game not started yet (P7 may plan a small disc before the boot has
+  // copied the DOL; the CPU is still outside MEM1's game code, below
+  // 0x80000000 or in the apploader at 0x81200000): not ready, P7 waits and
+  // tries again. Once the game runs, code still absent (zeros, loaded later)
+  // is a hash mismatch for that function only, never a wait for all.
+  {
+    const u32 pc = Core::System::GetInstance().GetPPCState().pc;  // racy read, a hint
+    if (pc < 0x80000000 || pc >= 0x81200000)
+    {
+      const auto entry_word = AotReadInstruction(entry_pc);
+      if (entry_word.valid && entry_word.hex == 0)
+        return AotStatus(4, entry_pc);
+    }
+  }
+  const u64 expected = (u64{hash_hi} << 32) | hash_lo;
+  u64 hash = 0;
+  if (!AotRangesHash(range_span, &hash))
+    return AotStatus(2, entry_pc);
+  if (expected != 0 && hash != expected)
+    return AotStatus(1, entry_pc);
+
+  RegionFragment fragment;
+  t_disable_mask_override = true;
+  t_disable_mask = mask;
+  t_aot_translating = true;
+  PPCAnalyst::g_instruction_reader = AotReadInstruction;
+  const bool built = BuildRegionFragment(Core::System::GetInstance(), entry_pc, range_span,
+                                         std::max<u32>(max_blocks, 1), &fragment);
+  PPCAnalyst::g_instruction_reader = nullptr;
+  t_aot_translating = false;
+  t_disable_mask_override = false;
+  if (!built)
+    return AotStatus(2, entry_pc);
+  if (fragment.code.size() > AOT_MAX_FRAGMENT_BYTES)
+    return AotStatus(3, entry_pc);
+  u64 after = 0;
+  if (!AotRangesHash(range_span, &after) || after != hash)
+    return AotStatus(1, entry_pc);
+
+  auto& out = t_aot_out;
+  out.assign({0, entry_pc, static_cast<u32>(fragment.code.size()),
+              static_cast<u32>(fragment.entries.size()), static_cast<u32>(fragment.relocs.size()),
+              0});
+  out.insert(out.end(), fragment.entries.begin(), fragment.entries.end());
+  for (const auto& reloc : fragment.relocs)
+    out.insert(out.end(), {reloc.offset, reloc.kind, reloc.value});
+  const std::size_t words = out.size();
+  out.resize(words + (fragment.code.size() + 3) / 4);
+  std::memcpy(out.data() + words, fragment.code.data(), fragment.code.size());
+  return out.data();
+}
+
+// [compilerVersion, codegenMask]: the codegen mask is the CPU thread's, so
+// regions are emitted as its blocks are.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotKeyParts(u32* out)
+{
+  out[0] = AOT_COMPILER_VERSION;
+  out[1] = s_dolphin_web_disable_mask.load(std::memory_order_relaxed);
+}
+
+// Helper signatures in import order, "params>results" (BuildWasmCachedInterpreterBlock's types).
+extern "C" EMSCRIPTEN_KEEPALIVE const char* DolphinWeb_JitHelperSignature(u32 index)
+{
+  static constexpr std::array<const char*, 5> TYPES = {
+      "i32>i32", "i32,i32>i32", "i32,i32,i32>", "i32,i32,i32,i32,i32>i32", "f64,f64,f64,i32>f64"};
+  static constexpr std::array<u8, 20> TYPE_OF = {1, 2, 1, 2, 1, 2, 3, 3, 3, 3,
+                                                 3, 3, 3, 3, 2, 3, 1, 3, 3, 4};
+  return index < TYPE_OF.size() ? TYPES[TYPE_OF[index]] : nullptr;
+}
+
+// Test CPU for region equivalence: the oracle's memory and BATs, MSR with FP
+// and translation on. Returns the PowerPCState address (the region's state
+// argument); RAM is at DolphinWeb_AotTestRam.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_AotTestSetUp()
+{
+  auto& system = Core::System::GetInstance();
+  if (!JitOracleSetUp(system))
+    return 0;
+  system.GetPowerPC().GetBreakPoints().Clear();
+  return static_cast<u32>(reinterpret_cast<std::uintptr_t>(&system.GetPPCState()));
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_AotTestRam()
+{
+  return static_cast<u32>(
+      reinterpret_cast<std::uintptr_t>(Core::System::GetInstance().GetMemory().GetRAM()));
+}
+
+// Start state of a call: GPRs from `gprs`, every other register cleared,
+// pc = entry, LR = return address.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotTestReset(const u32* gprs, u32 pc, u32 lr)
+{
+  auto& ppc = Core::System::GetInstance().GetPPCState();
+  std::copy(s_jit_oracle_spr.begin(), s_jit_oracle_spr.end(), ppc.spr);
+  for (u32 i = 0; i < 32; ++i)
+  {
+    ppc.gpr[i] = gprs[i];
