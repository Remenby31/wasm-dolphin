+
+// FNV-1a 64 of the guest words in ranges[first .. first+count) (pairs), read
+// from MEM1 (0x8/0xC views); false when a word is outside it.
+bool RegionRangesHash(const std::vector<u32>& ranges, u32 first, u32 count, u64* out)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u8* ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  if (!ram)
+    return false;
+  u64 h = 0xcbf29ce484222325ull;
+  for (u32 r = first; r < first + count && 2 * r + 1 < ranges.size(); ++r)
+  {
+    for (u32 a = ranges[2 * r]; a < ranges[2 * r + 1]; a += 4)
+    {
+      const u32 physical = a & 0x01ffffff;
+      if (((a >> 28) != 0x8 && (a >> 28) != 0xc) || physical + 4 > ram_size)
+        return false;
+      for (u32 k = 0; k < 4; ++k)
+      {
+        h ^= ram[physical + k];
+        h *= 0x100000001b3ull;
+      }
+    }
+  }
+  *out = h;
+  return true;
+}
+
+// Every member's code is still the code the plan (and the translator) saw.
+bool RegionCodeMatchesPlan(const std::vector<u32>& ranges, const std::vector<RegionMember>& members)
+{
+  for (const RegionMember& m : members)
+  {
+    u64 h = 0;
+    if (!RegionRangesHash(ranges, m.first_range, m.range_count, &h) || (m.hash != 0 && h != m.hash))
+      return false;
+  }
+  return true;
