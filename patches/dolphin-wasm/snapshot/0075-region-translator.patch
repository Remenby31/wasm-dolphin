 // Drives the armed warmup with a synthetic field counter, as the CPU thread
 // would at the start of each slice; returns the engaged field or -1.
+// Region modules (P4) write pc and downcount themselves; the region
+// assembler finds pc with these. out: pc, npc and downcount offsets in
+// PowerPCState, then the layout version.
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_JitStateLayout(u32* out)
+{
+  auto& ppc = Core::System::GetInstance().GetPPCState();
+  const auto base = reinterpret_cast<std::uintptr_t>(&ppc);
+  out[0] = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.pc) - base);
+  out[1] = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.npc) - base);
+  out[2] = static_cast<u32>(reinterpret_cast<std::uintptr_t>(&ppc.downcount) - base);
+  out[3] = 1;
+}
