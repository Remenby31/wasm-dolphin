 // The RAM and L1 host addresses of this session (tests: the RAM shifted by
@@ -9635,6 +9948,39 @@
 // On the CPU thread at a slice boundary: compile and map queued regions. A
 // region with an entry HLE hooks is left out (the block path replaces that
 // function; a region would run its original code).
+// The static memory instructions and instructions per cycle of the code in
+// `ranges` (pairs, effective addresses in MEM1), as the interpreter counts
+// cycles; words it cannot read are left out.
+void RegionStaticRates(InstalledRegion& region)
+{
+  auto& memory = Core::System::GetInstance().GetMemory();
+  const u8* ram = memory.GetRAM();
+  const u32 ram_size = memory.GetRamSizeReal();
+  if (!ram)
+    return;
+  double cycles = 0, instructions = 0, accesses = 0;
+  for (std::size_t r = 0; r + 1 < region.ranges.size(); r += 2)
+  {
+    for (u32 a = region.ranges[r]; a < region.ranges[r + 1]; a += 4)
+    {
+      const u32 physical = a & 0x01ffffff;
+      if (((a >> 28) != 0x8 && (a >> 28) != 0xc) || physical + 4 > ram_size)
+        continue;
+      const UGeckoInstruction inst{ReadRamU32BE(ram, physical)};
+      const GekkoOPInfo* info = PPCTables::GetOpInfo(inst, a);
+      cycles += info->num_cycles;
+      instructions += 1;
+      if (MemAccessKind(info, inst) >= 0)
+        accesses += 1;
+    }
+  }
+  if (cycles > 0)
+  {
+    region.accesses_per_cycle = accesses / cycles;
+    region.instructions_per_cycle = instructions / cycles;
+  }
+}
