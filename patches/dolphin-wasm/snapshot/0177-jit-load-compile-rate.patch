+// Patch 0177: the load's window is over: its held blocks join the deferred
+// queue, drained at the usual per-slice rate.
+void HandOverLoadHeldBlocks(CachedInterpreter& cpu)
+{
+  if (!s_wasm_load_rate_start ||
+      std::chrono::steady_clock::now() - *s_wasm_load_rate_start < s_wasm_load_rate_window)
+    return;
+  s_wasm_load_rate_start.reset();
+  if (s_wasm_jit_enabled)
+  {
+    auto& queue = s_deferred_wasm_queues[&cpu];
+    for (const LoadHeldBlock& held : s_wasm_load_held)
+      queue.Defer(held.address, held.features, held.normal_entry);
+  }
+  s_wasm_load_held.clear();
+}
