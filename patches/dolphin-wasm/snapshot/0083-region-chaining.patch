+// Patch 0083, region chaining. A region leaving for a PC it does not hold
+// (its exit stub: a jump out of the region, or a blr/bctr/bctrl to a PC that
+// is not one of its entries; state.pc and the rest of the state written)
+// calls this through its `region_chain` import: the table index of the
+// region mapped at state.pc, which the stub tail-calls instead of returning
+// 0 to the dispatcher, or 0 to return there. Same conditions as TryRunRegion,
+// plus downcount left (the dispatcher loop's test). The CPU state is not
+// tested, as a region's own loops do not: a pause waits for the slice end.
+// A region not verified since a cache clear is left to TryRunRegion.
+struct RegionChainStats
+{
+  u32 version = 1;
+  u32 enabled = 1;
+  // Exits that went on to the next region; that returned to the dispatcher:
+  // downcount spent, no region entry at pc, refused (mode, not verified,
+  // chaining off).
+  double chained = 0, out_of_time = 0, no_region = 0, refused = 0;
+};
+static_assert(sizeof(RegionChainStats) == 40);
+alignas(8) RegionChainStats s_region_chain_stats;
+
+void ResetRegionChainStats()
+{
+  const u32 enabled = s_region_chain_stats.enabled;
+  s_region_chain_stats = RegionChainStats{};
+  s_region_chain_stats.enabled = enabled;
+  s_chain_exit_pcs.clear();
+  s_chain_break_pcs.clear();
+}
+
+int RegionChainNext(int state_ptr)
+{
+  const auto& ppc_state =
+      *reinterpret_cast<const PowerPC::PowerPCState*>(static_cast<std::uintptr_t>(state_ptr));
+  RegionChainStats& stats = s_region_chain_stats;
+  if (!stats.enabled)
+  {
+    stats.refused += 1;
+    return 0;
+  }
+  if (ppc_state.downcount <= 0)
+  {
+    stats.out_of_time += 1;
+    return 0;
+  }
+  const u32 index = RegionFilterHas(ppc_state.pc) ? FindRegionIndex(ppc_state.pc) : NO_REGION;
+  if (index == NO_REGION)
+  {
+    stats.no_region += 1;
+    if (s_region_stats_on)
+      ++s_chain_exit_pcs[ppc_state.pc];
+    return 0;
+  }
+  const InstalledRegion& region = s_regions[index];
+  if (!region.verified || !s_regions_enabled.load(std::memory_order_relaxed) ||
+      !ppc_state.msr.IR || !ppc_state.msr.DR || !ppc_state.msr.FP ||
+      (ppc_state.feature_flags & FEATURE_FLAG_PERFMON) != 0)
+  {
+    stats.refused += 1;
+    return 0;
+  }
+  stats.chained += 1;
+  return region.handle;
+}
 }  // namespace
 
