+// Patch 0083: a direct-mapped cache of s_region_at (entry pc -> index + 1,
+// 0 empty) for the hot lookups: the dispatcher, block chaining and region
+// chaining. s_region_at holds ~135 000 nodes, one cache miss per find.
+// Cleared whenever s_region_at changes.
+struct RegionLookupSlot
+{
+  u32 pc = 0;
+  u32 index_plus_one = 0;
+};
+std::array<RegionLookupSlot, 8192> s_region_lookup{};
+inline void ClearRegionLookup()
+{
+  s_region_lookup.fill({});
+}
+constexpr u32 NO_REGION = 0xffffffffu;
+[[gnu::noinline]] u32 FindRegionIndexSlow(u32 pc, RegionLookupSlot& slot)
+{
+  const auto it = s_region_at.find(pc);
+  if (it == s_region_at.end())
+    return NO_REGION;
+  slot = {pc, it->second + 1};
+  return it->second;
+}
+// The index in s_regions of the region mapped at entry pc, or NO_REGION.
+inline u32 FindRegionIndex(u32 pc)
+{
+  RegionLookupSlot& slot = s_region_lookup[(pc >> 2) & (s_region_lookup.size() - 1)];
+  if (slot.pc == pc && slot.index_plus_one != 0)
+    return slot.index_plus_one - 1;
+  return FindRegionIndexSlow(pc, slot);
+}
