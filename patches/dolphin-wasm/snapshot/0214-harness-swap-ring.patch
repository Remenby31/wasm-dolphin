+// Patch 0214: the one place the target is read (0211's hold and the harness
+// swap ring share it), so the read order below cannot drift between them.
+FifoManager::GpuCatchUp FifoManager::GpuCatchUpTargetAndDistance() const
 {
   auto& fifo = m_system.GetCommandProcessor().GetFifo();
   // The consumed count first, then the distance: a chunk the GPU thread
   // consumes between the two reads lowers the distance only, so the target
   // can come out one chunk low (a hold missed), never one high (a hold of a
-  // swap whose copy already ran).
+  // swap whose copy already ran). Reversed, the race 0211 fixed comes back.
   const u64 consumed = m_gpu_chunks_consumed.load(std::memory_order_acquire);
   const u32 pending = fifo.CPReadWriteDistance.load(std::memory_order_seq_cst);
-  return consumed + (pending + GPFifo::GATHER_PIPE_SIZE - 1) / GPFifo::GATHER_PIPE_SIZE;
+  return {consumed + (pending + GPFifo::GATHER_PIPE_SIZE - 1) / GPFifo::GATHER_PIPE_SIZE, pending};
 }
 
