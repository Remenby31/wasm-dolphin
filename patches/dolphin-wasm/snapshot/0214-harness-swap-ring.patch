 extern "C" int DolphinWeb_UseWorkerOwnedWebGL();
+// Patch 0214 (harness pipeline diag, dolphin_web_discio.cpp): the swap ring.
+extern "C" int DolphinWeb_HarnessSwapsEnabled();
+extern "C" void DolphinWeb_HarnessRecordSwap(std::uint32_t vi_since_boot, double host_ms,
+                                             std::uint32_t behind_chunks,
+                                             std::uint32_t fifo_bytes, std::uint32_t flags);
+namespace DolphinWeb
+{
+extern std::atomic<u32> g_stale_xfb_held;  // Present.cpp, patch 0211
+}
+
+// Patch 0214: one VI swap on the video thread, recorded in the harness swap
+// ring: when the video thread pulled it (host ms, emscripten_get_now, the VI
+// ring's clock), how many FIFO chunks it still had to replay to reach what the
+// game wrote before this VI (0211's target; UINT32_MAX: unknown, single core
+// or a deterministic GPU thread), the FIFO distance at the VI in bytes (same),
+// and whether the swap found a new picture (bit 0) or held the last one for a
+// late copy (bit 1, patch 0211). Called only when the harness asked for it.
+static void HarnessRecordedViSwap(u32 xfb_addr, u32 fb_width, u32 fb_stride, u32 fb_height,
+                                  u64 ticks, TimePoint presentation_time, u64 fifo_target,
+                                  bool fifo_known, u32 fifo_bytes, u32 vi_since_boot)
+{
+  constexpr u32 UNKNOWN = 0xFFFFFFFFu;
+  const double host_ms = emscripten_get_now();
+  const u64 consumed = fifo_known ? Core::System::GetInstance().GetFifo().GpuChunksConsumed() : 0;
+  const u32 held_before = DolphinWeb::g_stale_xfb_held.load(std::memory_order_relaxed);
+  const bool duplicate = g_presenter->ViSwap(xfb_addr, fb_width, fb_stride, fb_height, ticks,
+                                             presentation_time, fifo_target);
+  const bool held = DolphinWeb::g_stale_xfb_held.load(std::memory_order_relaxed) != held_before;
+  const u32 behind = !fifo_known ? UNKNOWN :
+                     fifo_target > consumed ?
+                                   static_cast<u32>(std::min<u64>(fifo_target - consumed, UNKNOWN - 1)) :
+                                   0;
+  DolphinWeb_HarnessRecordSwap(vi_since_boot, host_ms, behind, fifo_known ? fifo_bytes : UNKNOWN,
+                               (duplicate ? 0u : 1u) | (held ? 2u : 0u));
+}
 #endif
 
