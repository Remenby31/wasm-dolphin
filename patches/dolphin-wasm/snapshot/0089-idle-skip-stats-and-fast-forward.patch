diff --git a/Source/Core/Core/WasmIdleStats.h b/Source/Core/Core/WasmIdleStats.h
new file mode 100644
index 0000000000..d5da6dc9fb
--- /dev/null
+++ b/Source/Core/Core/WasmIdleStats.h
@@ -0,0 +1,87 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Idle-skip counters for the harness (DolphinWeb_IdleStats, decoded by
+// harness/lib/idle-stats.mjs). Off until the harness asks: then the CPU
+// thread resets them at its next Advance() and counts until the next request.
+// Written by the CPU thread only; a reader copies the struct.
+
+#pragma once
+
+#include <atomic>
+
+#include "Common/CommonTypes.h"
+
+namespace DolphinWeb::IdleStats
+{
+// Layout v1, little-endian, f64 from +16, cumulative since the last reset.
+struct Stats
+{
+  u32 version = 1;
+  u32 size_bytes = 0;
+  u32 on = 0;
+  u32 reserved = 0;
+  // Guest cycles and host time since the reset (updated at each Advance).
+  double cycles = 0, host_ms = 0;
+  // CoreTiming slices, CoreTiming::Idle() calls, the cycles they skipped,
+  // and the FlushGpu() calls they made (SyncOnSkipIdle).
+  double advances = 0, idle_calls = 0, idle_cycles = 0, flush_gpu = 0;
+  // An Idle() at the same loop as the previous one, with at most
+  // REENTRY_MAX_CYCLES executed in between (no interrupt handler ran): the
+  // loop came back out only to go straight back in. Executed cycles, host
+  // time from the previous Idle() to this one, and the part of it spent in
+  // event callbacks (work that has to happen anyway).
+  double reentries = 0, reentry_cycles = 0, reentry_host_ms = 0, reentry_event_ms = 0;
+  // Slices that began right after an Idle(): those with only a VI event that
+  // changed nothing a game can observe besides the beam position, those
+  // with a VI event, and those where an external exception was taken.
+  double idle_wakes = 0, wake_vi_only = 0, wake_with_vi = 0, wake_exceptions = 0;
+  // VI half-line updates, those with an effect beyond the beam position
+  // (field start/end, SI poll, an interrupt status bit set), and guest reads
+  // of the beam position registers.
+  double vi_updates = 0, vi_observable = 0, beam_reads = 0;
+  // Events run in an idle wake, by kind.
+  double wake_audio_dma = 0, wake_dsp = 0, wake_gpu_sleeper = 0, wake_ipc = 0, wake_dec = 0,
+         wake_si = 0, wake_other = 0;
+  // Idle fast-forward (?idleff=1): wakes where it could start (the loop just
+  // proved itself, see CoreTiming::Idle) and loop iterations it replaced.
+  double ff_armed = 0, ff_skips = 0;
+};
+
+inline constexpr s64 REENTRY_MAX_CYCLES = 256;
+
+inline Stats g_stats;
+inline bool g_on = false;
+// Set by VideoInterfaceManager::Update when the half-line does more than
+// move the beam; read and cleared by CoreTiming around each VI callback.
+inline bool g_vi_observable = false;
+inline std::atomic<int> g_request{-1};
+
+// Idle fast-forward (?idleff=1, DolphinWeb_SetIdleFastForward). When a wait
+// loop has just run one iteration that read no hardware register and came
+// straight back to CoreTiming::Idle(), the next events that only touch
+// hardware registers, interrupts or the host (VI, AI, audio DMA, GPU sleeper)
+// cannot change what the loop reads: CoreTiming::Advance then accounts for
+// the iterations it would run between them, without running them, until an
+// exception is pending or another event runs.
+inline std::atomic<bool> g_ff_enabled{false};
+// Guest loads from hardware registers or the EFB (MMU::ReadFromHardware),
+// counted always by the CPU thread.
+inline u32 g_hw_reads = 0;
+
+inline void NoteHardwareRead()
+{
+  ++g_hw_reads;
+}
+
+inline void NoteViObservable()
+{
+  g_vi_observable = true;
+}
+
+inline void NoteBeamRead()
+{
+  if (g_on)
+    g_stats.beam_reads += 1;
+}
+}  // namespace DolphinWeb::IdleStats
