+// An event a proven wait loop cannot observe (WasmIdleStats.h): it only
+// changes hardware registers and interrupts, or the host's state.
+bool CoreTimingManager::IsIdleTransparentEvent(const EventType* type)
+{
+  if (!s_ff_events_resolved)
+  {
+    const char* names[] = {"VICallback", "AICallback", "AudioDMACallback", "GPUSleeper"};
+    for (size_t i = 0; i < std::size(names); ++i)
+    {
+      const auto it = m_event_types.find(names[i]);
+      s_ff_events[i] = it != m_event_types.end() ? &it->second : nullptr;
+    }
+    s_ff_events_resolved = true;
+  }
+  for (const EventType* t : s_ff_events)
+  {
+    if (t != nullptr && t == type)
+      return true;
+  }
+  return false;
+}
+#endif
