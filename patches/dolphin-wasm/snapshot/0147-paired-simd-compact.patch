+// Patch 0147: a v128 with `bits` in both 64-bit lanes, in its shortest form:
+// i64.const + i64x2.splat (4 to 11 bytes) or f64.const + f64x2.splat (11),
+// instead of an 18-byte v128.const. The same value either way.
+void EmitSplatConst64(std::vector<u8>& body, u64 bits)
+{
+  u32 leb = 1;
+  for (s64 v = static_cast<s64>(bits); !(v >= -64 && v < 64); v >>= 7)
+    ++leb;
+  if (1 + leb <= 9)
+  {
+    EmitI64Const(body, bits);
+    body.push_back(0xfd);
+    EmitU32Leb(body, 0x12);  // i64x2.splat
+  }
+  else
+  {
+    EmitF64ConstBits(body, bits);
+    body.push_back(0xfd);
+    EmitU32Leb(body, 0x14);  // f64x2.splat
+  }
+}
