+// 0201: the consumer's OP_DESTROY tags: 1 buffer, 2 texture, 3 bind group.
+static constexpr u32 kDestroyTagBindGroup = 3;
 
+void WebGPUGfx::DestroyRetiredBindGroups()
+{
+  // Only between passes: a destroy inside a staged pass poisons it, and the
+  // consumer refuses one inside a pass while mapped uploads are pending.
+  if (m_pass_open || m_retired_bind_groups.empty())
+    return;
+  for (const u32 id : m_retired_bind_groups)
+    m_cmd_stream.PushDestroy(kDestroyTagBindGroup, id);
+  m_retired_bind_groups.clear();
+}
