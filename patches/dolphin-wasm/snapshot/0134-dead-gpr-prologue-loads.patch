diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
--- a/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/CachedInterpreter.cpp
@@ -9488,11 +9488,29 @@ std::vector<u8> BuildWasmCachedInterpreterBlock(std::span<const PPCAnalyst::Code
     BitSet32 used_gprs;
     for (const PPCAnalyst::CodeOp& op : ops)
       used_gprs |= op.regsIn | op.regsOut;
+    // Patch 0134 (was 0127): a GPR whose first access in the block is a
+    // write by a plain integer op is not loaded; it is present all the same
+    // (its local is written before it is read). Only such writes count: the
+    // dirty flags are set when an op is emitted, so a GPR a load or an FPU op
+    // writes on its fast path only would be stored, unloaded, by a halt on its
+    // slow path. Skipped ops neither read nor write.
+    BitSet32 read_first, written, written_plain;
+    for (const PPCAnalyst::CodeOp& op : ops)
+    {
+      if (op.skip)
+        continue;
+      read_first |= op.regsIn & ~written;
+      if (op.opinfo->type == OpType::Integer && (op.opinfo->flags & (FL_LOADSTORE | FL_USE_FPU)) == 0)
+        written_plain |= op.regsOut & ~written & ~read_first;
+      written |= op.regsOut;
+    }
     for (int bit : used_gprs)
     {
       if (bit < 0 || bit >= 32)
         continue;
       s_gpr_rc.present[bit] = true;
+      if (!read_first[bit] && written_plain[bit])
+        continue;
       EmitLocalGet(body, 0);
       body.push_back(0x28);  // i32.load
       body.push_back(0x02);  // align=2
@@ -16937,8 +16955,10 @@ namespace
 // taken by 0108-0110). 16 (0121): region code takes MSR LE/FE0/FE1 and
 // HID2.LSQE for granted (15 is 0119's). 17 (0126): region byte swaps as two
 // rotates (11-15 are taken by 0112-0119). 21 (0129): fused relaxed_madd mode
-// (18 retired, 19 and 20 are 0127's and 0128's).
-constexpr u32 AOT_COMPILER_VERSION = 21;
+// (18 retired, 19 and 20 are 0127's and 0128's). 26 (0134): GPRs written
+// before they are read are not loaded in the block prologue (22-25 are taken
+// by 0130-0133; 19 is retired, from 0127).
+constexpr u32 AOT_COMPILER_VERSION = 26;
 constexpr u32 AOT_MAX_FRAGMENT_BYTES = 1u << 20;
 thread_local std::vector<u32> t_aot_out;
 u8* s_aot_ram = nullptr;
