+// Tests: how long without a throttle sleep makes emulation late (0125, ms).
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_AotSetNoSleepSpanForTest(int ms)
+{
+  s_region_no_sleep_span = std::chrono::milliseconds(ms);
+}
+
+// Installs that did not wait for a sleep because emulation ran late (0125).
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_AotRegionLateInstalls()
+{
+  return s_region_late_installs;
+}
