+// Patch 0135 (was 0128): a region fragment keeps npc and downcount in
+// locals (with the dispatch pc, 56): its blocks write npc to a local, its
+// frame subtracts cycles from a local, and the state is written back at every
+// exit. Set by BuildRegionFragment while it builds the fragment's blocks.
+constexpr u32 WASM_FRAME_PC_LOCAL = 56;
+constexpr u32 WASM_FRAME_NPC_LOCAL = 57;
+constexpr u32 WASM_FRAME_DOWNCOUNT_LOCAL = 58;
+struct FragmentFrame
+{
+  bool active = false;
+  u32 pc_offset = 0, npc_offset = 0, downcount_offset = 0;
+};
+thread_local FragmentFrame t_fragment_frame;
+
+// state.offset = local (stack-neutral) / local = state.offset.
+void EmitStoreLocalToState(std::vector<u8>& body, u32 local, u32 offset)
+{
+  body.push_back(0x20);
+  EmitU32Leb(body, 0);
+  body.push_back(0x20);
+  EmitU32Leb(body, local);
+  body.insert(body.end(), {0x36, 0x02});
+  EmitU32Leb(body, offset);
+}
+void EmitLoadStateToLocal(std::vector<u8>& body, u32 offset, u32 local)
+{
+  body.push_back(0x20);
+  EmitU32Leb(body, 0);
+  body.insert(body.end(), {0x28, 0x02});
+  EmitU32Leb(body, offset);
+  body.push_back(0x21);
+  EmitU32Leb(body, local);
+}
