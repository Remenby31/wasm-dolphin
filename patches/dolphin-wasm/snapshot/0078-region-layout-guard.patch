+// FNV-1a 32 of every field (offsets in PowerPCState, and the absolute
+// addresses and sizes of RAM and L1 in this session's heap), never 0.
+u32 WasmLayoutHash(const WasmStateLayout& layout)
+{
+  static_assert(sizeof(WasmStateLayout) % sizeof(u32) == 0);
+  std::array<u32, sizeof(WasmStateLayout) / sizeof(u32)> words;
+  std::memcpy(words.data(), &layout, sizeof(layout));
+  u32 h = 0x811c9dc5u;
+  for (const u32 w : words)
+  {
+    for (int shift = 0; shift < 32; shift += 8)
+    {
+      h ^= (w >> shift) & 0xff;
+      h *= 0x01000193u;
+    }
+  }
+  return h != 0 ? h : 1;
+}
