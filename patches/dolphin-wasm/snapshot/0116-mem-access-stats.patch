+// Memory-access counts (patch 0116, DolphinWeb_MemAccessStats). Every block
+// end (EndBlock, a RunWasmBlock that ends its block) carries an index into
+// s_mem_static: the guest instructions and memory instructions by kind from
+// the block's start to that end, counted where its downcount is, so the
+// counts and the cycles they cover agree. While stats are on, each block end
+// that runs adds its entry once. Slow accesses, served by Dolphin's MMU or
+// interpreter instead of a direct RAM access, are counted where they happen;
+// the memory instructions a cached-interpreter block interprets are slow
+// every time and counted with its entry. Regions add an estimate: their
+// cycles times their code's static accesses per cycle. Block ends also count
+// the instructions that write or read the condition register (a CR field)
+// and XER's carry, for the lazy-CR lever (research/deep-cr-flags.md).
+namespace
+{
+enum MemKind : u32
+{
+  kIntLoad,
+  kIntStore,
+  kFpLoad,
+  kFpStore,
+  kPsqLoad,
+  kPsqStore,
+  kMemKinds
+};
+
+// The kind of a memory instruction, or -1. Cache operations (dcbz, dcbz_l)
+// and eciwx/ecowx are not counted.
+int MemAccessKind(const GekkoOPInfo* info, UGeckoInstruction inst)
+{
+  switch (info->type)
+  {
+  case OpType::Load:
+    return kIntLoad;
+  case OpType::Store:
+    return kIntStore;
+  case OpType::LoadFP:
+    return kFpLoad;
+  case OpType::StoreFP:
+    return kFpStore;
+  case OpType::LoadPS:
+    return kPsqLoad;
+  case OpType::StorePS:
+    return kPsqStore;
+  case OpType::System:
+    return inst.OPCD == 46 ? kIntLoad : inst.OPCD == 47 ? kIntStore : -1;  // lmw, stmw
+  default:
+    return -1;
+  }
+}
+
+// Instructions that write a CR field (cmp*, Rc=1, CR logic, mtcrf...), read
+// one (a conditional bc, CR logic, mfcr...), set XER[CA], read it.
+enum FlagCount : u32
+{
+  kCrWrites,
+  kCrReads,
+  kCaWrites,
+  kCaReads,
+  kFlagCounts
+};
 
+struct MemStaticCounts
+{
+  u16 instructions = 0;
+  std::array<u16, kMemKinds> accesses{};
+  std::array<u16, kMemKinds> interpreted{};  // run by the interpreter: slow every time
+  u16 flags = 0;  // bit 0: a wasm block end
+  std::array<u16, kFlagCounts> flag_ops{};
+};
+static_assert(sizeof(MemStaticCounts) == 36);
+
+// The counts of the block being emitted, from its start.
+struct MemCountBuilder
+{
+  u32 instructions = 0;
+  std::array<u32, kMemKinds> accesses{};
+  std::array<u32, kMemKinds> interpreted{};
+  std::array<u32, kFlagCounts> flag_ops{};
+
+  void Add(const PPCAnalyst::CodeOp& op)
+  {
+    ++instructions;
+    if (op.skip)
+      return;
+    if (const int kind = MemAccessKind(op.opinfo, op.inst); kind >= 0)
+      ++accesses[kind];
+    flag_ops[kCrWrites] += op.crOut.Count() != 0 ? 1 : 0;
+    flag_ops[kCrReads] += op.crIn.Count() != 0 ? 1 : 0;
+    flag_ops[kCaWrites] += op.outputCA ? 1 : 0;
+    flag_ops[kCaReads] += op.wantsCA ? 1 : 0;
+  }
+  void Interpreted(const PPCAnalyst::CodeOp& op)
+  {
+    if (const int kind = MemAccessKind(op.opinfo, op.inst); kind >= 0)
+      ++interpreted[kind];
+  }
+  void Add(const MemCountBuilder& other)
+  {
+    instructions += other.instructions;
+    for (u32 k = 0; k < kMemKinds; ++k)
+    {
+      accesses[k] += other.accesses[k];
+      interpreted[k] += other.interpreted[k];
+    }
+    for (u32 k = 0; k < kFlagCounts; ++k)
+      flag_ops[k] += other.flag_ops[k];
+  }
+};
+
+MemCountBuilder s_mem_block_counts;  // CPU thread, while a block is emitted
+// Distinct counts, interned: blocks share a few thousand of them. Entries are
+// never freed, so an index stays valid after its block is gone.
+std::vector<MemStaticCounts> s_mem_static(1);  // [0]: no counts
+std::unordered_map<u64, u32> s_mem_static_index;
+constexpr std::size_t MEM_STATIC_MAX = 1u << 20;
+std::unordered_map<u32, u32> s_mem_static_at;  // block start -> its last end's entry
+double s_mem_static_saturations = 0;            // counts past 65535, cumulative
+
+struct MemAccessTotals
+{
+  u64 instructions = 0;
+  std::array<u64, kMemKinds> accesses{};
+  std::array<u64, kMemKinds> slow{};
+  std::array<u64, kFlagCounts> flag_ops{};
+  u64 cycles_covered = 0;
+  double cycles_total = 0, region_accesses = 0, region_instructions = 0;
+};
+MemAccessTotals s_mem_totals;
+bool s_mem_stats_on = false;
+std::atomic<bool> s_mem_stats_reset{false};
+
+// Layout v1, agreed with the harness (lib/mem-access-stats.mjs): written as
+// a whole at each slice boundary while on; readers copy it twice. The flag
+// counts sit in v1's spares (readers of the first v1 ignore them).
+struct MemAccessStatsV1
+{
+  u32 version = 1;
+  u32 size_bytes = 192;
+  u32 on = 0;
+  u32 reserved = 0;
+  double instructions = 0;
+  std::array<double, kMemKinds> accesses{};
+  std::array<double, kMemKinds> slow{};
+  double cycles_covered = 0, cycles_total = 0, region_accesses = 0, region_instructions = 0,
+         static_saturations = 0;
+  std::array<double, kFlagCounts> flag_ops{};  // blocks: CR writes, CR reads, CA writes, CA reads
+};
+static_assert(sizeof(MemAccessStatsV1) == 192);
+static_assert(offsetof(MemAccessStatsV1, slow) == 72 &&
+              offsetof(MemAccessStatsV1, cycles_covered) == 120 &&
+              offsetof(MemAccessStatsV1, static_saturations) == 152 &&
+              offsetof(MemAccessStatsV1, flag_ops) == 160);
+alignas(8) MemAccessStatsV1 s_mem_stats_view;
+
+u32 InternMemCounts(const MemCountBuilder& b, u16 flags)
+{
+  MemStaticCounts c;
+  c.flags = flags;
+  const auto clamp = [](u32 v) -> u16 {
+    if (v <= 0xffff)
+      return static_cast<u16>(v);
+    s_mem_static_saturations += 1;
+    return 0xffff;
+  };
+  c.instructions = clamp(b.instructions);
+  for (u32 k = 0; k < kMemKinds; ++k)
+  {
+    c.accesses[k] = clamp(b.accesses[k]);
+    c.interpreted[k] = clamp(b.interpreted[k]);
+  }
+  for (u32 k = 0; k < kFlagCounts; ++k)
+    c.flag_ops[k] = clamp(b.flag_ops[k]);
+  u64 key = 0xcbf29ce484222325ull;
+  const auto* bytes = reinterpret_cast<const u8*>(&c);
+  for (std::size_t i = 0; i < sizeof(c); ++i)
+    key = (key ^ bytes[i]) * 0x100000001b3ull;
+  if (const auto it = s_mem_static_index.find(key); it != s_mem_static_index.end())
+  {
+    if (std::memcmp(&s_mem_static[it->second], &c, sizeof(c)) == 0)
+      return it->second;
+  }
+  if (s_mem_static.size() >= MEM_STATIC_MAX)
+    return 0;  // not counted: shows in cycles_covered
+  const u32 index = static_cast<u32>(s_mem_static.size());
+  s_mem_static.push_back(c);
+  s_mem_static_index.emplace(key, index);
+  return index;
+}
+
+// The entry of the block end being written; the last one written for a block
+// stands for the whole block (DolphinWeb_MemAccessStaticAt).
+u32 BlockEndMemCounts(u32 block_start, bool wasm)
+{
+  const u32 index = InternMemCounts(s_mem_block_counts, wasm ? 1 : 0);
+  s_mem_static_at[block_start] = index;
+  return index;
+}
+
+void CountMemBlockEnd(u32 index, u32 downcount)
+{
+  if (index == 0)
+    return;
+  const MemStaticCounts& c = s_mem_static[index];
+  s_mem_totals.instructions += c.instructions;
+  for (u32 k = 0; k < kMemKinds; ++k)
+  {
+    s_mem_totals.accesses[k] += c.accesses[k];
+    s_mem_totals.slow[k] += c.interpreted[k];
+  }
+  for (u32 k = 0; k < kFlagCounts; ++k)
+    s_mem_totals.flag_ops[k] += c.flag_ops[k];
+  s_mem_totals.cycles_covered += downcount;
+}
+
+inline void CountSlowMemAccess(u32 kind)
+{
+  if (s_mem_stats_on) [[unlikely]]
+    ++s_mem_totals.slow[kind];
+}
+
+// The MMU arm of a fast RAM instruction (the RAM arm is unchanged).
+template <typename T>
+T SlowMemRead(Core::System& system, u32 kind, u32 address)
+{
+  CountSlowMemAccess(kind);
+  return system.GetMMU().Read<T>(address);
+}
+template <typename T>
+void SlowMemWrite(Core::System& system, u32 kind, T value, u32 address)
+{
+  CountSlowMemAccess(kind);
+  system.GetMMU().Write<T>(value, address);
+}
+
+// A memory instruction a helper hands to the interpreter.
+inline void CountSlowMemInstruction(UGeckoInstruction inst, u32 pc)
+{
+  if (!s_mem_stats_on) [[likely]]
+    return;
+  if (const int kind = MemAccessKind(PPCTables::GetOpInfo(inst, pc), inst); kind >= 0)
+    ++s_mem_totals.slow[kind];
+}
+
+void PublishMemStats()
+{
+  MemAccessStatsV1& v = s_mem_stats_view;
+  v.on = s_mem_stats_on ? 1 : 0;
+  v.instructions = static_cast<double>(s_mem_totals.instructions);
+  for (u32 k = 0; k < kMemKinds; ++k)
+  {
+    v.accesses[k] = static_cast<double>(s_mem_totals.accesses[k]);
+    v.slow[k] = static_cast<double>(s_mem_totals.slow[k]);
+  }
+  v.cycles_covered = static_cast<double>(s_mem_totals.cycles_covered);
+  v.cycles_total = s_mem_totals.cycles_total;
+  v.region_accesses = s_mem_totals.region_accesses;
+  v.region_instructions = s_mem_totals.region_instructions;
+  v.static_saturations = s_mem_static_saturations;
+  for (u32 k = 0; k < kFlagCounts; ++k)
+    v.flag_ops[k] = static_cast<double>(s_mem_totals.flag_ops[k]);
+}
+
+// At a slice boundary, on the CPU thread: a requested reset zeroes the totals
+// and turns counting on.
+// Returns whether counting just started: the caller drops the JIT cache so
+// every block is emitted again with its CountMemBlock.
+bool ApplyMemStatsRequest()
+{
+  if (!s_mem_stats_reset.exchange(false, std::memory_order_acq_rel))
+    return false;
+  const bool started = !s_mem_stats_on;
+  s_mem_totals = {};
+  s_mem_stats_on = true;
+  PublishMemStats();
+  return started;
+}
+}  // namespace
+
+#ifdef __EMSCRIPTEN__
+// reset >= 0: zero the totals and count from the next slice boundary on;
+// < 0: only read. Returns the MemAccessStatsV1 address.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_MemAccessStats(int reset)
+{
+  if (reset >= 0)
+    s_mem_stats_reset.store(true, std::memory_order_release);
+  return static_cast<u32>(reinterpret_cast<std::uintptr_t>(&s_mem_stats_view));
+}
+
+// Debugging and tests: {u16 instructions, int_load, int_store, fp_load,
+// fp_store, psq_load, psq_store, flags} of the block starting at pc (its last
+// end: the whole block), 0 when none was emitted. flags bit 0: a wasm block.
+// Read it with the CPU thread paused.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_MemAccessStaticAt(u32 pc)
+{
+  static std::array<u16, 8> out;
+  const auto it = s_mem_static_at.find(pc);
+  if (it == s_mem_static_at.end() || it->second == 0)
+    return 0;
+  const MemStaticCounts& c = s_mem_static[it->second];
+  out[0] = c.instructions;
+  std::copy(c.accesses.begin(), c.accesses.end(), out.begin() + 1);
+  out[7] = c.flags;
+  return static_cast<u32>(reinterpret_cast<std::uintptr_t>(out.data()));
+}
+
+// Tests: the kind MemAccessStats counts an instruction under, or -1.
+extern "C" EMSCRIPTEN_KEEPALIVE int DolphinWeb_MemAccessKindForTest(u32 inst_hex)
+{
+  const UGeckoInstruction inst{inst_hex};
+  return MemAccessKind(PPCTables::GetOpInfo(inst, 0), inst);
+}
