+void VertexManager::DestroyRetiredGeometryBuffers()
+{
+  // Called between passes only (WebGPUGfx): the OP_DESTROY lands after the
+  // END_PASS of every pass that drew from these buffers, and the consumer
+  // only drops its reference (encoded passes keep the GPUBuffer alive). One
+  // the ring refused stays for the next pass end.
+  WebGPUCommandStream& cs = GetCommandStream();
+  auto kept = m_retired_geometry_buffers.begin();
+  for (const u32 id : m_retired_geometry_buffers)
+  {
+    if (!cs.PushDestroy(kDestroyTagGeometryBuffer, id))
+      *kept++ = id;
+  }
+  m_retired_geometry_buffers.erase(kept, m_retired_geometry_buffers.end());
+}
