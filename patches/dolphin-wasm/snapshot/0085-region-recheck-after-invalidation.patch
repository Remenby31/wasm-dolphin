+// Whether a region kept after an invalidation can be vouched for by its
+// hashes alone (patch 0085): every member hashed, and no HLE hook installed
+// at an entry since it was (a hook changes no byte; RegionInstallable checks
+// it once).
+bool RegionStillCheckable(const std::vector<u32>& entries, const std::vector<RegionMember>& members)
+{
+  return std::all_of(members.begin(), members.end(), [](const RegionMember& m) { return m.hash != 0; }) &&
+         std::none_of(entries.begin(), entries.end(),
+                      [](u32 pc) { return HLE::GetHookByAddress(pc) != 0; });
+}
