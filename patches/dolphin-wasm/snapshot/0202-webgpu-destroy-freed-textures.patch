+// 0202: the consumer's OP_DESTROY tag for a texture.
+static constexpr u32 kDestroyTagTexture = 2;
+
+void WebGPUGfx::RetireTexture(u32 bridge_id)
+{
+  if (bridge_id == 0)
+    return;
+  // Unbound from every stage still holding it (as Vulkan's UnbindTexture):
+  // no later bind group may name a texture the consumer dropped.
+  for (u32& texture : m_tex_id)
+  {
+    if (texture == bridge_id)
+      texture = 0;
+  }
+  m_retired_textures.push_back(bridge_id);
+}
+
+void WebGPUGfx::DestroyRetiredTextures()
+{
+  // Between passes only, as DestroyRetiredBindGroups.
+  if (m_pass_open || m_retired_textures.empty())
+    return;
+  for (const u32 id : m_retired_textures)
+    m_cmd_stream.PushDestroy(kDestroyTagTexture, id);
+  m_retired_textures.clear();
+}
