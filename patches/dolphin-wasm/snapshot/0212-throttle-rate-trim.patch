+namespace DolphinWeb
+{
+// Patch 0212 (?vilock=1, src/wgpu-vi-phase-lock.js): the throttle's rate
+// trimmed by up to +/-2000 ppm of the configured speed, so the emulated VI can
+// be held in phase with the screen's refresh (59.94 on 60 Hz: +1001 ppm).
+// Only the wall pace of the throttle moves: the emulated time, the configured
+// speed (m_emulation_speed, Config::MAIN_EMULATION_SPEED) and the mixer's step
+// stay as they are. The worker writes the requested value; the CPU thread
+// reads it at each Throttle and applies it through UpdateSpeedLimit, which
+// rebases the throttle at the current cycle (no jump). A plain value read at
+// each Throttle, nothing published with it: relaxed is enough. At 0 ppm the
+// factor is exactly 1.0 (no floating point step), the rate unchanged.
+std::atomic<int> g_throttle_rate_ppm{0};
+std::atomic<int> g_throttle_rate_applied_ppm{0};
+constexpr int THROTTLE_RATE_MAX_PPM = 2000;
+inline double ThrottleRateFactor(int ppm)
+{
+  return ppm == 0 ? 1.0 : 1.0 + static_cast<double>(ppm) * 1e-6;
+}
+}  // namespace DolphinWeb
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetThrottleRatePpm(int ppm)
+{
+  DolphinWeb::g_throttle_rate_ppm.store(
+      std::clamp(ppm, -DolphinWeb::THROTTLE_RATE_MAX_PPM, DolphinWeb::THROTTLE_RATE_MAX_PPM),
+      std::memory_order_relaxed);
+}
+
+// The trim the throttle runs with now (applied by the CPU thread), in ppm.
+extern "C" EMSCRIPTEN_KEEPALIVE int DolphinWeb_ThrottleRatePpm()
+{
+  return DolphinWeb::g_throttle_rate_applied_ppm.load(std::memory_order_relaxed);
+}
