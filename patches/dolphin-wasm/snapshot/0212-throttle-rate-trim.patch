diff --git a/Source/Core/Core/WasmThrottleRate.h b/Source/Core/Core/WasmThrottleRate.h
new file mode 100644
index 0000000..f864f86
--- /dev/null
+++ b/Source/Core/Core/WasmThrottleRate.h
@@ -0,0 +1,39 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Patch 0212 (?vilock=1, src/wgpu-vi-phase-lock.js): the throttle's rate
+// trimmed by up to +/-2000 ppm of the configured speed, so the emulated VI can
+// be held in phase with the screen's refresh (59.94 on 60 Hz: +1001 ppm).
+// The worker writes the requested trim; the CPU thread applies it at its next
+// Throttle through UpdateSpeedLimit (a rebase at the current cycle, no jump)
+// and publishes the applied value, which the mixer's resampler follows so the
+// audio queue does not drift (the sound is +1.7 cents at +1000 ppm). The
+// emulated time, the configured speed and Config::MAIN_EMULATION_SPEED are
+// untouched. Plain values read where they are used, nothing published with
+// them: relaxed is enough. At 0 ppm the factor is exactly 1.0.
+// Header-only (C++17 inline variables): one definition for CoreTiming.cpp and
+// Mixer.cpp.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace DolphinWeb::ThrottleRate
+{
+constexpr int MAX_PPM = 2000;
+inline std::atomic<int> g_requested_ppm{0};
+inline std::atomic<int> g_applied_ppm{0};
+// The mixer's granule queues, the DMA and streaming FIFOs only (the game's
+// sound; the others are dequeued while never fed): a jump of the playhead back
+// to half the queue because it overflowed (an audible skip), and a gap filled
+// because it ran empty, since boot. A FIFO's first fill can count one
+// overflow at boot: read them as deltas.
+inline std::atomic<uint32_t> g_audio_overflow_skips{0};
+inline std::atomic<uint32_t> g_audio_underrun_fills{0};
+
+inline double Factor(int ppm)
+{
+  return ppm == 0 ? 1.0 : 1.0 + static_cast<double>(ppm) * 1e-6;
+}
+}  // namespace DolphinWeb::ThrottleRate
