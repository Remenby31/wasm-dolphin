+// Block-local: the FPR lanes known to hold an f32-exact value (low 29
+// significand bits zero, so never a double denormal), as of the op being
+// emitted. Updated from each op's semantics, so a helper or interpreter
+// fallback for that op leaves it right. Unknown at block entry.
+struct WasmFpSingleState
+{
+  bool active = false;
+  u32 lane[2] = {0, 0};
+};
+static thread_local WasmFpSingleState s_fp_single;
+// Emitted FP lanes that dropped work thanks to it (compile time, all threads).
+std::atomic<u32> s_fp_single_skips{0};
+
+inline bool FprLaneKnownSingle(u32 reg, u32 lane)
+{
+  return s_fp_single.active && ((s_fp_single.lane[lane & 1] >> reg) & 1) != 0;
+}
+
+void UpdateFpSingleState(const PPCAnalyst::CodeOp& op)
+{
+  if (!s_fp_single.active)
+    return;
+  const UGeckoInstruction inst = op.inst;
+  const u32 d = inst.FD, bit = 1u << d;
+  const auto set_both = [&] { s_fp_single.lane[0] |= bit; s_fp_single.lane[1] |= bit; };
+  const auto kill_both = [&](u32 r) {
+    s_fp_single.lane[0] &= ~(1u << r);
+    s_fp_single.lane[1] &= ~(1u << r);
+  };
+  switch (inst.OPCD)
+  {
+  case 48: case 49:  // lfs, lfsu: the same single in both lanes
+  case 56: case 57:  // psq_l, psq_lu: f32 or dequantized (f32-exact), or 1.0
+    set_both();
+    return;
+  case 59:
+    // fdivs, fsubs, fadds, fmuls, fmsubs, fmadds, fnmsubs, fnmadds: rounded
+    // to single (fres and fsqrts left out)
+    if (inst.SUBOP5 == 18 || inst.SUBOP5 == 20 || inst.SUBOP5 == 21 || inst.SUBOP5 == 25 ||
+        inst.SUBOP5 >= 28)
+    {
+      set_both();
+      return;
+    }
+    break;
+  case 31:
+    if (inst.SUBOP10 == 535 || inst.SUBOP10 == 567)  // lfsx, lfsux
+    {
+      set_both();
+      return;
+    }
+    break;
+  case 4:
+    switch (inst.SUBOP5)
+    {
+    case 10: case 11: case 12: case 13: case 14:  // ps_sum0/1, ps_muls0/1, ps_madds0
+    case 15:                                        // ps_madds1
+      if (inst.SUBOP5 >= 12)
+      {
+        set_both();
+        return;
+      }
+      break;
+    case 18: case 20: case 21: case 25: case 28: case 29: case 30: case 31:
+      // ps_div, ps_sub, ps_add, ps_mul, ps_msub, ps_madd, ps_nmsub, ps_nmadd
+      set_both();
+      return;
+    default:
+      break;
+    }
+    break;
+  case 63:
+    if (inst.SUBOP10 == 12)  // frsp
+    {
+      set_both();
+      return;
+    }
+    if (inst.SUBOP10 == 72 || inst.SUBOP10 == 40 || inst.SUBOP10 == 264 ||
+        inst.SUBOP10 == 136)  // fmr, fneg, fabs, fnabs: ps0 from FB.ps0, ps1 kept
+    {
+      const u32 b0 = (s_fp_single.lane[0] >> inst.FB) & 1;
+      s_fp_single.lane[0] = (s_fp_single.lane[0] & ~bit) | (b0 << d);
+      return;
+    }
+    break;
+  case 16: case 17: case 18: case 19:  // branches, sc (HLE and fast calls)
+    s_fp_single.lane[0] = s_fp_single.lane[1] = 0;
+    return;
+  default:
+    break;
+  }
+  if (op.fregOut >= 0)
+    kill_both(static_cast<u32>(op.fregOut));
+}
