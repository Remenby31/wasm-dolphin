     m_jit->ClearCache();
 }
 
+#ifdef __EMSCRIPTEN__
+// Patch 0145: CachedInterpreter.cpp. A cache clear with no range re-checks
+// every region before it runs again.
+extern "C" void DolphinWeb_UnverifyRegions();
+#endif
+
 void JitInterface::ClearSafe()
 {
+#ifdef __EMSCRIPTEN__
+  DolphinWeb_UnverifyRegions();
+#endif
   if (m_jit)
     m_jit->GetBlockCache()->Clear();
 }
