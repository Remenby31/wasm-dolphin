+// The module's "region-heap" custom section (src/aot-region-module.js):
+// u32 LE [ram base, l1 base, count, (kind << 31 | form << 30 | offset)...],
+// each site a 5-byte padded LEB: form 0 an i32.const's signed immediate equal
+// to its base, form 1 a memarg offset of its base plus under 64 KiB. True
+// when the section exists, holds these bases, and every site holds its base.
+bool RegionHeapSitesHold(const std::vector<u8>& bytes, u32 ram_base, u32 l1_base)
+{
+  const std::size_t n = bytes.size();
+  std::size_t p = 8;
+  const auto leb = [&](std::size_t limit, u32* out) {
+    u32 v = 0;
+    for (int shift = 0; shift < 35; shift += 7)
+    {
+      if (p >= limit)
+        return false;
+      const u8 b = bytes[p++];
+      v |= static_cast<u32>(b & 0x7f) << shift;
+      if (!(b & 0x80))
+      {
+        *out = v;
+        return true;
+      }
+    }
+    return false;
+  };
+  static constexpr std::string_view name = "region-heap";
+  while (p < n)
+  {
+    const u8 id = bytes[p++];
+    u32 size = 0;
+    if (!leb(n, &size) || size > n - p)
+      return false;
+    const std::size_t end = p + size;
+    u32 name_length = 0;
+    if (id == 0 && leb(end, &name_length) && name_length <= end - p &&
+        std::string_view(reinterpret_cast<const char*>(bytes.data() + p), name_length) == name)
+    {
+      p += name_length;
+      const std::size_t length = end - p;
+      if (length < 12 || length % 4)
+        return false;
+      const auto word = [&](std::size_t i) {
+        u32 w;
+        std::memcpy(&w, bytes.data() + p + 4 * i, sizeof(w));
+        return w;
+      };
+      if (word(0) != ram_base || word(1) != l1_base || 3 + std::size_t{word(2)} != length / 4)
+        return false;
+      for (u32 i = 0; i < word(2); ++i)
+      {
+        const u32 site = word(3 + i);
+        const std::size_t at = site & 0x3fffffff;
+        const u32 base = (site >> 31) ? l1_base : ram_base;
+        if (at < 1 || at + 5 > n)
+          return false;
+        u32 v = 0;
+        for (int k = 0; k < 4; ++k)
+        {
+          if (!(bytes[at + k] & 0x80))
+            return false;  // not padded to 5 bytes
+          v |= static_cast<u32>(bytes[at + k] & 0x7f) << (7 * k);
+        }
+        const u8 top = bytes[at + 4];
+        if (top & 0x80)
+          return false;
+        v |= static_cast<u32>(top & 0x0f) << 28;
+        const bool offset_form = (site >> 30) & 1;
+        if (offset_form ? ((top & 0x70) != 0 || v - base >= 0x10000) :
+                          (v != base || (top & 0x70) != ((v & 0x80000000u) ? 0x70 : 0)))
+          return false;
+      }
+      return true;
+    }
+    p = end;
+  }
+  return false;  // no section: a module of this translator always has one
+}
