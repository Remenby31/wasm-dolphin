+// Region fragments do not take the host addresses of the emulated RAM and L1
+// as operands: an access pushes the guest offset alone, and its memarg offset
+// holds base + byte offset as a 5-byte padded LEB, a heap site the fragment
+// lists (reloc kind 3, value 0 RAM, 1 L1). V8 folds a memarg offset into the
+// addressing mode: no i32.add, no global read (an imported global cost 0.8 %
+// of the race with aot=1, a local 0.6 %). A module translated while the heap
+// sat elsewhere is patched at its sites before it is compiled (discio) and
+// queued with the bases it holds, checked against this session's.
+// Block modules keep i32.const + i32.add (same bytes, same keys).
+constexpr u32 WASM_HEAP_RAM = 0;
+constexpr u32 WASM_HEAP_L1 = 1;
+constexpr std::array<const char*, 2> WASM_HEAP_SITE_NAMES = {"ram_base", "l1_base"};
+// The base the next access's memarg offset adds (fragment mode), set by
+// EmitHeapBaseOperand, consumed by EmitAccessOffset.
+thread_local int t_heap_site_kind = -1;
+thread_local u32 t_heap_site_base = 0;
+
+void EmitI32Const(std::vector<u8>& body, u32 value);
+
+// The base of an address: i32.const in a block; in a fragment, nothing (the
+// access adds it through its memarg offset).
+void EmitHeapBaseOperand(std::vector<u8>& body, u32 address, u32 kind)
+{
+  if (!s_wasm_fragment_relocs)
+  {
+    EmitI32Const(body, address);
+    return;
+  }
+  t_heap_site_kind = static_cast<int>(kind);
+  t_heap_site_base = address;
+}
+
+void EmitHeapAdd(std::vector<u8>& body)
+{
+  if (!s_wasm_fragment_relocs)
+    body.push_back(0x6a);  // i32.add
+}
+
+// The memarg offset of an access to an address built above.
+void EmitAccessOffset(std::vector<u8>& body, u32 byte_offset)
+{
+  if (!s_wasm_fragment_relocs || t_heap_site_kind < 0)
+  {
+    EmitU32Leb(body, byte_offset);
+    return;
+  }
+  s_wasm_fragment_relocs->relocs.push_back(
+      {body.size(), WASM_HEAP_SITE_NAMES[static_cast<u32>(t_heap_site_kind)]});
+  EmitPaddedU32Leb(body, t_heap_site_base + byte_offset);
+  t_heap_site_kind = -1;
+}
