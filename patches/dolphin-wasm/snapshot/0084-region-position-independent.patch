+// Region fragments do not take the host addresses of the emulated RAM and L1
+// as fixed operands: the i32.const of each base is a 5-byte padded signed LEB,
+// a heap site the fragment lists (reloc kind 3: value bit 0 RAM/L1, bit 1 the
+// form, 0 an i32.const, 1 a memarg offset, kept for x64 where the offset folds
+// into the addressing mode; ARM rematerialises a large offset at every
+// access, -1.3 % on the race). The machine code is main's: an imported global
+// cost 0.8 %, a local 0.6 %. A module translated while the heap sat elsewhere
+// is patched at its sites before it is compiled (discio) and queued with the
+// bases it holds, checked against this session's.
+// Block modules keep the constants as they were (same bytes, same keys).
+constexpr u32 WASM_HEAP_RAM = 0;
+constexpr u32 WASM_HEAP_L1 = 1;
+constexpr std::array<const char*, 2> WASM_HEAP_SITE_NAMES = {"ram_base", "l1_base"};
+
+void EmitI32Const(std::vector<u8>& body, u32 value);
+
+void EmitHeapBase(std::vector<u8>& body, u32 address, u32 kind)
+{
+  if (!s_wasm_fragment_relocs)
+  {
+    EmitI32Const(body, address);
+    return;
+  }
+  body.push_back(0x41);  // i32.const, a 5-byte signed LEB
+  s_wasm_fragment_relocs->relocs.push_back({body.size(), WASM_HEAP_SITE_NAMES[kind]});
+  const s32 value = static_cast<s32>(address);
+  for (int i = 0; i < 4; ++i)
+    body.push_back(static_cast<u8>(((value >> (7 * i)) & 0x7f) | 0x80));
+  body.push_back(static_cast<u8>((value >> 28) & 0x7f));
+}
