+// In region code, stores the compare lazily and records it; false elsewhere.
+bool EmitRegionCompare(std::vector<u8>& body, const WasmStateLayout& layout, FusedCr c)
+{
+  if (!s_wasm_fragment_relocs)
+    return false;
+  c.gprs = BitSet32{};
+  c.gprs[c.ra] = true;
+  if (c.rb_is_reg)
+    c.gprs[c.rb] = true;
+  EmitLazyCrStore(body, layout, c);
+  c.valid = true;
+  t_fused_cr = c;
+  return true;
+}
