+// 0111: the ops that may set XER.SO (mtxer, mcrxr, the OE forms) run
+// outside regions, which rely on SO staying clear inside them.
+bool RegionMaySetSo(const PPCAnalyst::CodeOp& op)
+{
+  const UGeckoInstruction inst = op.inst;
+  if (inst.OPCD != 31)
+    return false;
+  if (inst.SUBOP10 == 512)  // mcrxr
+    return true;
+  if (inst.SUBOP10 == 467 && ((inst.SPRU << 5) | (inst.SPRL & 0x1F)) == SPR_XER)  // mtspr
+    return true;
+  return (op.opinfo->flags & FL_SET_OE) != 0 && inst.OE;
+}
