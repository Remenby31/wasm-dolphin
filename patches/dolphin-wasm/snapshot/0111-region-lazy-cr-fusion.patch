+// Region code (0111): the CR field as one i64, A - B with both extended as
+// the compare is signed or not, SO (bit 59) cleared: regions only run with
+// XER.SO clear (TryRunRegion, RegionChainNext) and never set it (mtxer and
+// mcrxr stay outside them). The format's other bits then read as the
+// interpreter's: LT bit 62, GT (s64) > 0, EQ the low word zero.
+void EmitLazyCrStore(std::vector<u8>& body, const WasmStateLayout& layout, const FusedCr& c)
+{
+  EmitLocalGet(body, 0);
+  EmitStateLoadU32(body, GprOffset(layout, c.ra));
+  body.push_back(c.is_signed ? 0xac : 0xad);  // i64.extend_i32_s / _u
+  if (c.rb_is_reg)
+  {
+    EmitStateLoadU32(body, GprOffset(layout, c.rb));
+    body.push_back(c.is_signed ? 0xac : 0xad);
+  }
+  else
+  {
+    EmitI64Const(body, c.is_signed ? static_cast<u64>(static_cast<s64>(static_cast<s32>(c.imm))) :
+                                     static_cast<u64>(c.imm));
+  }
+  body.push_back(0x7d);  // i64.sub
+  EmitLazyCrFieldTail(body, layout, c.field);
+}
+
+// The CR bit `bit` (LT, GT or EQ of the recorded field) from the operands.
+void EmitFusedCrBit(std::vector<u8>& body, const WasmStateLayout& layout, const FusedCr& c,
+                    u32 bit)
+{
+  EmitStateLoadU32(body, GprOffset(layout, c.ra));
+  if (c.rb_is_reg)
+    EmitStateLoadU32(body, GprOffset(layout, c.rb));
+  else
+    EmitI32Const(body, c.imm);
+  switch (bit & 3)
+  {
+  case 0:
+    body.push_back(c.is_signed ? 0x48 : 0x49);  // i32.lt_s / _u
+    break;
+  case 1:
+    body.push_back(c.is_signed ? 0x4a : 0x4b);  // i32.gt_s / _u
+    break;
+  default:
+    body.push_back(0x46);  // i32.eq
+    break;
+  }
+}
+
+// The i64 on the stack (a difference or a sign-extended result) as a CR
+// field: bit 59 (SO) cleared and, when it is 0, bit 63 set, as the
+// interpreter's Helper_UpdateCR0 and PPCToInternal do: an EQ field is never
+// 0, so code that reads GT as "bit 63 clear" (EmitCrFieldToPpcBits) stays
+// right. Uses i64 local 4. Then the store.
+void EmitLazyCrFieldTail(std::vector<u8>& body, const WasmStateLayout& layout, u32 field)
+{
+  EmitI64Const(body, ~(u64{1} << 59));
+  body.push_back(0x83);  // i64.and
+  body.push_back(0x22);  // local.tee 4
+  EmitU32Leb(body, 4);
+  EmitLocalGet(body, 4);
+  body.push_back(0x50);  // i64.eqz
+  body.push_back(0xad);  // i64.extend_i32_u
+  EmitI64Const(body, 63);
+  body.push_back(0x86);  // i64.shl
+  body.push_back(0x84);  // i64.or
+  body.push_back(0x37);  // i64.store
+  body.push_back(0x03);
+  EmitU32Leb(body, CrFieldOffset(layout, field));
+}
