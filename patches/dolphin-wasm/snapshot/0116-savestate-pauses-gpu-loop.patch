 void FifoManager::RestoreState(const bool was_running)
+{
+  if (was_running)
+    EmulatorState(true);
+}
+
+bool FifoManager::PauseForSavestate()
+{
+  const bool was_running = m_emu_running_state.IsSet();
+  if (!m_system.IsDualCoreMode() || m_use_deterministic_gpu_thread)
+    return was_running;
+
+  // From here a payload only pulls the async requests (the video backend's
+  // DoState among them) and returns before the FIFO.
+  EmulatorState(false);
+
+  // A payload that started earlier may still be decoding, and would write its
+  // read pointer and distance over the state being loaded. Payloads run one
+  // at a time and the loop is done only once a payload started after this
+  // Wakeup has returned, so nothing decodes after the wait. No timeout: the
+  // GPU loop waits on the render worker at most, never on the CPU thread.
+  const bool busy = !m_gpu_mainloop.IsDone();
+  const auto start = std::chrono::steady_clock::now();
+  m_gpu_mainloop.Wakeup();
+  int seconds = 0;
+  m_gpu_mainloop.WaitYield(std::chrono::seconds(1), [&seconds] {
+    WARN_LOG_FMT(COMMANDPROCESSOR, "Savestate: the GPU loop is still running after {} s",
+                 ++seconds);
+  });
+  const u64 waited_us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                             std::chrono::steady_clock::now() - start)
+                                             .count());
+  auto& stats = m_savestate_pause_stats;
+  stats.count.fetch_add(1, std::memory_order_relaxed);
+  if (busy)
+    stats.busy.fetch_add(1, std::memory_order_relaxed);
+  stats.last_us.store(waited_us, std::memory_order_relaxed);
+  if (waited_us > stats.max_us.load(std::memory_order_relaxed))
+    stats.max_us.store(waited_us, std::memory_order_relaxed);
+  return was_running;
+}
+
+void FifoManager::ResumeAfterSavestate(const bool was_running)
 {
+  if (!m_system.IsDualCoreMode() || m_use_deterministic_gpu_thread)
+    return;
   if (was_running)
     EmulatorState(true);
 }
