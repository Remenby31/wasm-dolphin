+bool FifoManager::PauseForSavestate()
+{
+  if (!m_system.IsDualCoreMode() || m_use_deterministic_gpu_thread)
+    return false;
+
+  // A payload that is decoding may span the whole load (on WebGPU a FIFO
+  // backlog takes hundreds of milliseconds) and would then write its
+  // pre-load read pointer and distance over the loaded ones. The
+  // BlockingLoop's done state does not say no payload runs (a payload runs
+  // again in the done state), so the payload flags its FIFO work itself.
+  // No timeout: the GPU payload waits on the render worker at most, never on
+  // the CPU thread. Payloads still pull the async requests while paused, so
+  // the video backend's DoState goes through.
+  m_savestate_pauses.fetch_add(1);
+  const bool busy = m_payload_active.load();
+  auto& stats = m_savestate_pause_stats;
+  if (busy && m_gpu_mainloop.IsDone())
+    stats.done_while_active.fetch_add(1, std::memory_order_relaxed);
+  const auto start = std::chrono::steady_clock::now();
+  auto next_log = start + std::chrono::seconds(1);
+  while (m_payload_active.load())
+  {
+    std::this_thread::sleep_for(std::chrono::microseconds(50));
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= next_log)
+    {
+      WARN_LOG_FMT(COMMANDPROCESSOR, "Savestate: a GPU payload is still decoding after {} s",
+                   std::chrono::duration_cast<std::chrono::seconds>(now - start).count());
+      next_log += std::chrono::seconds(1);
+    }
+  }
+  const u64 waited_us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                             std::chrono::steady_clock::now() - start)
+                                             .count());
+  stats.count.fetch_add(1, std::memory_order_relaxed);
+  if (busy)
+    stats.busy.fetch_add(1, std::memory_order_relaxed);
+  stats.last_us.store(waited_us, std::memory_order_relaxed);
+  if (waited_us > stats.max_us.load(std::memory_order_relaxed))
+    stats.max_us.store(waited_us, std::memory_order_relaxed);
+  return true;
+}
+
+void FifoManager::WaitForFifoChunk()
+{
+  if (!m_system.IsDualCoreMode() || m_use_deterministic_gpu_thread)
+    return;
+  if (!m_chunk_active.load())
+    return;
+  // The chunk waits on the render worker at most, never on the CPU thread.
+  const auto start = std::chrono::steady_clock::now();
+  auto next_log = start + std::chrono::seconds(1);
+  while (m_chunk_active.load())
+  {
+    std::this_thread::sleep_for(std::chrono::microseconds(20));
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= next_log)
+    {
+      WARN_LOG_FMT(COMMANDPROCESSOR, "GP reads off: a FIFO chunk is still decoding after {} s",
+                   std::chrono::duration_cast<std::chrono::seconds>(now - start).count());
+      next_log += std::chrono::seconds(1);
+    }
+  }
+  const u64 waited_us = static_cast<u64>(std::chrono::duration_cast<std::chrono::microseconds>(
+                                             std::chrono::steady_clock::now() - start)
+                                             .count());
+  auto& stats = m_savestate_pause_stats;
+  stats.read_disable_waits.fetch_add(1, std::memory_order_relaxed);
+  if (waited_us > stats.read_disable_max_us.load(std::memory_order_relaxed))
+    stats.read_disable_max_us.store(waited_us, std::memory_order_relaxed);
+}
+
+void FifoManager::ResumeAfterSavestate(const bool counted)
+{
+  // Whatever the mode is now (DoState may switch it): a counted pause is
+  // always undone, or the GPU loop would skip the FIFO for good.
+  if (!counted)
+    return;
+  if (m_savestate_pauses.fetch_sub(1) == 1)
+    m_gpu_mainloop.Wakeup();
 }
 
