 static void DoState(Core::System& system, PointerWrap& p)
 {
+  // In dual core the load or save runs as a CPU-thread job, after
+  // RunOnCPUThread has let the GPU thread go again: the CP FIFO must not move
+  // under DoState (a decode finishing after the load wrote its pre-load read
+  // pointer and distance over the loaded ones, and the GPU idled for good).
+  auto& fifo = system.GetFifo();
+  const bool fifo_was_running = fifo.PauseForSavestate();
+  Common::ScopeGuard resume_fifo([&] { fifo.ResumeAfterSavestate(fifo_was_running); });
+
   bool is_wii = system.IsWii() || system.IsMIOS();
   const bool is_wii_currently = is_wii;
   p.Do(is_wii);
