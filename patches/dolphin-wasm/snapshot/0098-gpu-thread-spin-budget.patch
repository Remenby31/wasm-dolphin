 }
 
+#ifdef __EMSCRIPTEN__
+// ?gpuspin=<us> (patch 0098), set by the worker at boot: the GPU thread's
+// spin budget in microseconds, -1 for the default (sleep at 1 kHz only).
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_SetGpuSpinBudget(int us)
+{
+  Core::System::GetInstance().GetFifo().SetGpuSpinBudgetMicros(us);
+}
+#endif
