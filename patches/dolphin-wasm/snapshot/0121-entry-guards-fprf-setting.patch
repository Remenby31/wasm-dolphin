 // MSR.FP set and FE0 = FE1 = 0: only then can the fast paths skip the
 // interpreter's floating-point exception check.
+// Patch 0121: set while a region fragment is emitted. A region is entered
+// only with MSR.FP on, LE, FE0 and FE1 off and HID2.LSQE on (TryRunRegion,
+// RegionWouldRun, RegionChainNext: RegionGuardsHold), and nothing inside a
+// fragment can change them: mtmsr, rfi and sc end it, mtspr HID2 is not on the
+// direct tier (it runs outside, the region is entered again after it). So
+// its ops take them for granted instead of testing them one by one. GQRs
+// (mtspr GQR is direct) are still tested per op.
+thread_local bool t_region_guards = false;
+
+// [] -> [i32]: MSR.FP on and MSR.LE off.
+void EmitMsrFpOnLittleEndianOff(std::vector<u8>& body, const WasmStateLayout& layout)
+{
+  if (t_region_guards)
+  {
+    EmitI32Const(body, 1);
+    return;
+  }
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, 1u << 13);
+  body.push_back(0x71);
+  EmitI32Const(body, 0);
+  body.push_back(0x47);
+
+  EmitStateLoadU32(body, layout.msr_offset);
+  EmitI32Const(body, 1);
+  body.push_back(0x71);
+  body.push_back(0x45);
+  body.push_back(0x71);
+}
+
+// [] -> [i32]: HID2.LSQE on.
+void EmitHid2LsqeSet(std::vector<u8>& body, const WasmStateLayout& layout)
+{
+  if (t_region_guards)
+  {
+    EmitI32Const(body, 1);
+    return;
+  }
+  EmitStateLoadU32(body, SprOffset(layout, SPR_HID2));
+  EmitI32Const(body, 1u << 31);
+  body.push_back(0x71);
+  EmitI32Const(body, 0);
+  body.push_back(0x47);
