-        block_had_hoist |= flush_group();
-        have_group = false;
-      }
-      continue;
-    }
-
-    // Any other op (ALU, u-form on another reg, branch, etc.) terminates the open
-    // run the moment it writes the run's base register.
-    if (have_group && op.regsOut[group_base])
-    {
-      block_had_hoist |= flush_group();
-      have_group = false;
-    }
-  }
-  block_had_hoist |= flush_group();
-
-  if (block_had_hoist)
