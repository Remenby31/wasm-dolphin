+// 0187: the chaining cache. A slot holds an entry pc and the handle of a
+// region that was live, verified and mapped at that pc when the slot was
+// filled, valid while s_chain_cache_epoch has not moved since. The epoch moves
+// whenever that could stop being true: s_region_at changes (installs, drops,
+// a shutdown: ClearRegionLookup), a region is no longer verified (an
+// invalidation it survives, a cache clear: UnverifyAllRegions). A region
+// verified again needs nothing: a slot is only ever filled from a verified one.
+struct ChainCacheSlot
+{
+  u32 pc = 0;
+  int handle = 0;
+  u32 epoch = 0;
+  u32 pad = 0;
+};
+std::array<ChainCacheSlot, 16384> s_chain_cache{};
+u32 s_chain_cache_epoch = 1;  // slots start at 0: never valid
