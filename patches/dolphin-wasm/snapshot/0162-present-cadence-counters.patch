diff --git a/Source/Core/Core/WasmPresentCadence.h b/Source/Core/Core/WasmPresentCadence.h
new file mode 100644
index 0000000..cdcbf1e
--- /dev/null
+++ b/Source/Core/Core/WasmPresentCadence.h
@@ -0,0 +1,156 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Present cadence counters (patch 0162, read by the harness through
+// validationReadPresentCadence): where a VI output comes late. Per field,
+// histograms of
+//   (1) the throttle's wake-up lateness: CoreTiming::Throttle's SleepUntil,
+//       actual wake-up minus target (CPU thread), and, when the target had
+//       already passed (no sleep), how far behind it was;
+//   (2) the CPU burst: last paced Throttle return to the next
+//       Video_OutputXFB (CPU thread);
+//   (3) on the video thread (WebGPU, dual core), a present's arrival minus
+//       its intended_present_time (signed: early arrivals are what
+//       SmoothEarlyPresentation sleeps away).
+// Each section is written by one thread only, as plain u32s; the worker
+// copies the struct as whole u32s until two copies agree, and the harness
+// keeps a copy only with on == 1 (2 while the CPU thread resets its section).
+// Off until DolphinWeb_PresentCadenceStats(n >= 0): the CPU thread applies
+// the request at its next Throttle and bumps the generation; the video thread
+// zeroes its own section when it sees a new generation (as WasmHeadroom.h)
+// and stores that generation in video_generation: the video section is the
+// current window's only when video_generation == generation.
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+
+#include "Common/CommonTypes.h"
+
+namespace DolphinWeb::PresentCadence
+{
+// Layout v1 (1344 bytes, little-endian u32s), agreed with the harness.
+constexpr u32 SLEEP_BIN_US = 250;   // (1) wake-up lateness, 64 bins, last = overflow
+constexpr u32 BEHIND_BIN_US = 500;  // (1) target already passed, 64 bins
+constexpr u32 BURST_BIN_US = 500;   // (2) Throttle return -> OutputXFB, 64 bins
+constexpr u32 ARRIVAL_BIN_US = 500; // (3) signed, 128 bins, bin 64 = [0, 500 us)
+struct Stats
+{
+  u32 version = 1;
+  u32 size_bytes = 1344;
+  u32 on = 0;  // 0 off, 1 on, 2 resetting (CPU section half zeroed)
+  u32 generation = 0;
+  // CPU thread
+  u32 throttles = 0;  // paced throttles (not skipped by Rush, speed limited)
+  u32 sleeps = 0;     // of them, the ones whose target was still ahead
+  u32 sleep_late_max_us = 0;
+  u32 behind_max_us = 0;
+  u32 burst_max_us = 0;
+  u32 outputs = 0;  // OutputXFB calls with a paced Throttle before them
+  // video thread
+  u32 presents = 0;
+  u32 arrival_late_max_us = 0;
+  u32 video_generation = 0;  // the generation the video section was zeroed for
+  u32 reserved[3] = {};
+  u32 sleep_late_hist[64] = {};
+  u32 behind_hist[64] = {};
+  u32 burst_hist[64] = {};
+  u32 arrival_hist[128] = {};
+};
+static_assert(sizeof(Stats) == 1344);
+
+using Clock = std::chrono::steady_clock;
+alignas(8) inline Stats g_stats;
+inline bool g_on = false;  // read plainly by both threads
+inline std::atomic<int> g_request{-1};
+inline Clock::time_point g_last_throttle_return;
+inline bool g_have_return = false;
+
+inline u32 Micros(Clock::duration d)
+{
+  const auto us = std::chrono::duration_cast<std::chrono::microseconds>(d).count();
+  return us <= 0 ? 0u : static_cast<u32>(std::min<long long>(us, 0x7fffffff));
+}
+inline void Bin(u32* hist, u32 bins, u32 bin_us, u32 us)
+{
+  hist[std::min(us / bin_us, bins - 1)] += 1;
+}
+
+// CPU thread, at each Throttle: applies a reset request.
+inline void OnThrottle()
+{
+  if (g_request.load(std::memory_order_relaxed) >= 0) [[unlikely]]
+  {
+    g_request.exchange(-1, std::memory_order_acquire);
+    g_stats.on = 2;
+    const u32 generation = g_stats.generation + 1;
+    // The CPU section only: the video thread zeroes its own.
+    g_stats.throttles = g_stats.sleeps = g_stats.outputs = 0;
+    g_stats.sleep_late_max_us = g_stats.behind_max_us = g_stats.burst_max_us = 0;
+    std::fill(std::begin(g_stats.sleep_late_hist), std::end(g_stats.sleep_late_hist), 0u);
+    std::fill(std::begin(g_stats.behind_hist), std::end(g_stats.behind_hist), 0u);
+    std::fill(std::begin(g_stats.burst_hist), std::end(g_stats.burst_hist), 0u);
+    g_have_return = false;
+    g_stats.generation = generation;
+    g_stats.on = 1;
+    g_on = true;
+  }
+}
+// CPU thread, a paced Throttle's sleep: target and the instants around it.
+inline void OnThrottleSleep(Clock::time_point entry, Clock::time_point target,
+                            Clock::time_point woke)
+{
+  if (!g_on) [[likely]]
+    return;
+  g_stats.throttles += 1;
+  if (target > entry)
+  {
+    g_stats.sleeps += 1;
+    const u32 late = Micros(woke - target);
+    g_stats.sleep_late_max_us = std::max(g_stats.sleep_late_max_us, late);
+    Bin(g_stats.sleep_late_hist, 64, SLEEP_BIN_US, late);
+  }
+  else
+  {
+    const u32 behind = Micros(entry - target);
+    g_stats.behind_max_us = std::max(g_stats.behind_max_us, behind);
+    Bin(g_stats.behind_hist, 64, BEHIND_BIN_US, behind);
+  }
+  g_last_throttle_return = woke;
+  g_have_return = true;
+}
+// CPU thread, at Video_OutputXFB.
+inline void OnOutputXfb()
+{
+  if (!g_on || !g_have_return) [[likely]]
+    return;
+  const u32 burst = Micros(Clock::now() - g_last_throttle_return);
+  g_stats.outputs += 1;
+  g_stats.burst_max_us = std::max(g_stats.burst_max_us, burst);
+  Bin(g_stats.burst_hist, 64, BURST_BIN_US, burst);
+  g_have_return = false;
+}
+// Video thread, a present's arrival against its intended time.
+inline void OnPresentArrival(Clock::time_point arrival, Clock::time_point intended)
+{
+  if (!g_on) [[likely]]
+    return;
+  const u32 generation = g_stats.generation;
+  if (g_stats.video_generation != generation) [[unlikely]]
+  {
+    g_stats.presents = 0;
+    g_stats.arrival_late_max_us = 0;
+    std::fill(std::begin(g_stats.arrival_hist), std::end(g_stats.arrival_hist), 0u);
+    g_stats.video_generation = generation;
+  }
+  g_stats.presents += 1;
+  const auto d = std::chrono::duration_cast<std::chrono::microseconds>(arrival - intended).count();
+  const long long bin = 64 + (d >= 0 ? d / ARRIVAL_BIN_US : -((-d + ARRIVAL_BIN_US - 1) / ARRIVAL_BIN_US));
+  g_stats.arrival_hist[std::clamp<long long>(bin, 0, 127)] += 1;
+  if (d > 0)
+    g_stats.arrival_late_max_us = std::max(g_stats.arrival_late_max_us, Micros(arrival - intended));
+}
+}  // namespace DolphinWeb::PresentCadence
+#endif
