diff --git a/Source/Core/Core/WasmHeadroom.h b/Source/Core/Core/WasmHeadroom.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/WasmHeadroom.h
@@ -0,0 +1,92 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Headroom counters (patch 0113, read by harness/lib/headroom.mjs): how fast
+// the game could run, measured at speed=1 (research/deep-headroom-kpi.md).
+// The CPU thread counts its throttle sleep, its waits for the GPU in
+// FlushGpu and the Rush skips; the GPU thread counts the host time of its
+// non-empty passes and the XFB copies. Each counter is written by one thread
+// only, as a plain double; the harness copies the struct twice and refuses
+// a torn read. Off until DolphinWeb_HeadroomStats(n >= 0): the CPU thread
+// applies the request at its next Throttle (once per VI) and the hooks test a
+// plain bool, so nothing is added on any per-block path, and no atomic is
+// read on the GPU thread.
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+#include <atomic>
+#include <chrono>
+
+#include "Common/CommonTypes.h"
+
+namespace DolphinWeb::Headroom
+{
+// Layout v1 (80 bytes, little-endian), agreed with the harness.
+struct Stats
+{
+  u32 version = 1;
+  u32 size_bytes = 80;
+  u32 on = 0;
+  u32 reserved = 0;
+  double window_us = 0;        // host time since the reset (CPU thread)
+  double cpu_sleep_us = 0;     // throttle sleep (CPU thread, SleepUntil)
+  double gpu_work_us = 0;      // non-empty GPU loop passes (GPU thread)
+  double xfb_copies = 0;       // EFB-to-XFB copies (GPU thread in dual core)
+  double rush_skips = 0;       // throttles skipped by Rush (CPU thread)
+  double flush_gpu_wait_us = 0;  // CPU waiting in FlushGpu (CPU thread)
+  double flush_gpu_waits = 0;
+  double spare = 0;
+};
+static_assert(sizeof(Stats) == 80);
+
+using Clock = std::chrono::steady_clock;
+inline Stats g_stats;
+inline bool g_on = false;  // read plainly by both threads
+inline std::atomic<int> g_request{-1};
+inline Clock::time_point g_reset_at;
+
+inline double Micros(Clock::duration d)
+{
+  return std::chrono::duration<double, std::micro>(d).count();
+}
+
+// CPU thread, once per Throttle: applies a reset request, keeps the window.
+inline void OnThrottle()
+{
+  if (g_request.load(std::memory_order_relaxed) >= 0) [[unlikely]]
+  {
+    g_request.exchange(-1, std::memory_order_acquire);
+    g_stats = Stats{};
+    g_reset_at = Clock::now();
+    g_stats.on = 1;
+    g_on = true;
+  }
+  if (g_on) [[unlikely]]
+    g_stats.window_us = Micros(Clock::now() - g_reset_at);
+}
+inline void CountRushSkip()
+{
+  if (g_on) [[unlikely]]
+    g_stats.rush_skips += 1;
+}
+inline void AddCpuSleep(Clock::duration d)
+{
+  if (g_on) [[unlikely]]
+    g_stats.cpu_sleep_us += Micros(d);
+}
+inline void AddFlushGpuWait(Clock::duration d)
+{
+  g_stats.flush_gpu_wait_us += Micros(d);
+  g_stats.flush_gpu_waits += 1;
+}
+inline void AddGpuWork(Clock::duration d)
+{
+  g_stats.gpu_work_us += Micros(d);
+}
+inline void CountXfbCopy()
+{
+  if (g_on) [[unlikely]]
+    g_stats.xfb_copies += 1;
+}
+}  // namespace DolphinWeb::Headroom
+#endif
