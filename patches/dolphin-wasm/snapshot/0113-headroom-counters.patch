diff --git a/Source/Core/Core/WasmHeadroom.h b/Source/Core/Core/WasmHeadroom.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/WasmHeadroom.h
@@ -0,0 +1,140 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+//
+// Headroom counters (patch 0113, read by harness/lib/headroom.mjs): how fast
+// the game could run, measured at speed=1 (research/deep-headroom-kpi.md).
+// The CPU thread counts its throttle sleep, its waits for the GPU in
+// FlushGpu, the Rush skips, the host window and the guest ticks of that same
+// window (both written at the same instant, at each Throttle). The GPU
+// thread counts the host time of its passes that ran the FIFO or pulled
+// events, the part of it spent waiting for ring or upload space from the
+// render worker, and the XFB copies. Each counter is written by one thread
+// only, as a plain double; the harness copies the struct as whole f64s, twice,
+// and refuses a torn read.
+// Off until DolphinWeb_HeadroomStats(n >= 0): the CPU thread applies the
+// request at its next Throttle (once per VI) and bumps a generation; the GPU
+// thread zeroes its own counters when it sees a new generation, so no thread
+// ever writes the other's fields. The hooks test a plain bool: nothing is
+// added on any per-block path, and no atomic is read on the GPU thread.
+// One reset per measurement window is the intended use.
+// Limits: with the deterministic GPU thread the GPU loop does not run (no GPU
+// work is counted); PushBlockingEvent and SyncGPU waits (off by default)
+// count as CPU busy time.
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+#include <atomic>
+#include <chrono>
+
+#include "Common/CommonTypes.h"
+
+namespace DolphinWeb::Headroom
+{
+// Layout v1 (96 bytes, little-endian), agreed with the harness.
+struct Stats
+{
+  u32 version = 1;
+  u32 size_bytes = 96;
+  u32 on = 0;
+  u32 reserved = 0;
+  double window_us = 0;          // host time since the reset (CPU thread)
+  double cpu_sleep_us = 0;       // throttle sleep (CPU thread, SleepUntil)
+  double gpu_work_us = 0;        // GPU loop passes with work (GPU thread)
+  double xfb_copies = 0;         // EFB-to-XFB copies (GPU thread in dual core)
+  double rush_skips = 0;         // throttles skipped by Rush (CPU thread)
+  double flush_gpu_wait_us = 0;  // CPU waiting in FlushGpu (CPU thread)
+  double flush_gpu_waits = 0;
+  double gpu_consumer_wait_us = 0;  // inside gpu_work_us: waiting on the render worker
+  double guest_ticks = 0;        // core ticks since the reset, with window_us (CPU thread)
+  double spare = 0;
+};
+static_assert(sizeof(Stats) == 96);
+
+using Clock = std::chrono::steady_clock;
+alignas(8) inline Stats g_stats;
+inline bool g_on = false;  // read plainly by both threads
+inline std::atomic<int> g_request{-1};
+inline Clock::time_point g_reset_at;
+inline u64 g_reset_ticks = 0;
+inline u32 g_generation = 0;      // bumped by the CPU thread at each reset
+inline u32 g_gpu_generation = 0;  // the generation the GPU thread last zeroed for
+
+inline double Micros(Clock::duration d)
+{
+  return std::chrono::duration<double, std::micro>(d).count();
+}
+
+// CPU thread, once per Throttle: applies a reset request, keeps the window
+// and the guest ticks of the same instant.
+inline void OnThrottle(u64 ticks)
+{
+  if (g_request.load(std::memory_order_relaxed) >= 0) [[unlikely]]
+  {
+    g_request.exchange(-1, std::memory_order_acquire);
+    g_stats.window_us = 0;
+    g_stats.cpu_sleep_us = 0;
+    g_stats.rush_skips = 0;
+    g_stats.flush_gpu_wait_us = 0;
+    g_stats.flush_gpu_waits = 0;
+    g_stats.guest_ticks = 0;
+    g_reset_at = Clock::now();
+    g_reset_ticks = ticks;
+    g_generation += 1;
+    g_stats.on = 1;
+    g_on = true;
+  }
+  if (g_on) [[unlikely]]
+  {
+    g_stats.window_us = Micros(Clock::now() - g_reset_at);
+    g_stats.guest_ticks = static_cast<double>(ticks - g_reset_ticks);
+  }
+}
+inline void CountRushSkip()
+{
+  if (g_on) [[unlikely]]
+    g_stats.rush_skips += 1;
+}
+inline void AddCpuSleep(Clock::duration d)
+{
+  if (g_on) [[unlikely]]
+    g_stats.cpu_sleep_us += Micros(d);
+}
+inline void AddFlushGpuWait(Clock::duration d)
+{
+  g_stats.flush_gpu_wait_us += Micros(d);
+  g_stats.flush_gpu_waits += 1;
+}
+// GPU thread: zero its own counters once per new generation.
+inline void GpuSync()
+{
+  if (g_gpu_generation != g_generation) [[unlikely]]
+  {
+    g_gpu_generation = g_generation;
+    g_stats.gpu_work_us = 0;
+    g_stats.gpu_consumer_wait_us = 0;
+    g_stats.xfb_copies = 0;
+  }
+}
+inline void AddGpuWork(Clock::duration d)
+{
+  GpuSync();
+  g_stats.gpu_work_us += Micros(d);
+}
+inline void AddGpuConsumerWait(double us)
+{
+  if (g_on) [[unlikely]]
+  {
+    GpuSync();
+    g_stats.gpu_consumer_wait_us += us;
+  }
+}
+inline void CountXfbCopy()
+{
+  if (g_on) [[unlikely]]
+  {
+    GpuSync();
+    g_stats.xfb_copies += 1;
+  }
+}
+}  // namespace DolphinWeb::Headroom
+#endif
