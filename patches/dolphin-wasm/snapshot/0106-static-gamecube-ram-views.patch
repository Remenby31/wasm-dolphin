diff --git a/Source/Core/Core/HW/Memmap.cpp b/Source/Core/Core/HW/Memmap.cpp
index e6d8fd56a5..0b774293dc 100644
--- a/Source/Core/Core/HW/Memmap.cpp
+++ b/Source/Core/Core/HW/Memmap.cpp
@@ -85,6 +85,37 @@ void MemoryManager::InitMMIO(Core::System& system)
   }
 }
 
+#ifdef __EMSCRIPTEN__
+namespace
+{
+// GameCube RAM views at addresses fixed when the core is linked (patch 0106),
+// instead of MemArena views. Under Emscripten a MemArena view is a MEMFS
+// mmap: a second, JS-side copy of the whole segment (64 MiB here), and an
+// address taken by memalign on the main thread, where it depends on what
+// other threads allocated at boot. Code generated for one address (block JIT
+// cache, regions) then missed on the next launch. In .bss: zero at
+// instantiation, the same address on every launch, no copy.
+alignas(65536) u8 s_static_ram[0x02000000];
+alignas(65536) u8 s_static_l1_cache[0x00040000];
+alignas(65536) u8 s_static_fake_vmem[0x02000000];
+// Zero until a boot used them: the first boot's Clear() would only touch
+// (and dirty) 64 MiB of zeroes.
+bool s_static_views_used = false;
+
+// The static array for a GameCube region of this size, or null.
+u8* StaticView(u8** out_pointer, u8* const* ram, u8* const* l1, u8* const* fake_vmem, u32 size)
+{
+  if (out_pointer == ram && size == sizeof(s_static_ram))
+    return s_static_ram;
+  if (out_pointer == l1 && size == sizeof(s_static_l1_cache))
+    return s_static_l1_cache;
+  if (out_pointer == fake_vmem && size == sizeof(s_static_fake_vmem))
+    return s_static_fake_vmem;
+  return nullptr;
+}
+}  // namespace
+#endif
+
 void MemoryManager::Init()
 {
   const auto get_mem1_size = [] {
@@ -135,7 +166,23 @@ void MemoryManager::Init()
     region.active = true;
