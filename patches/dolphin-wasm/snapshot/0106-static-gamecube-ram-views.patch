     *region.out_pointer = nullptr;
   }
-  m_arena.ReleaseSHMSegment();
+  if (!m_static_views)
+    m_arena.ReleaseSHMSegment();
+  m_static_views = false;
   m_mmio_mapping.reset();
   INFO_LOG_FMT(MEMMAP, "Memory system shut down.");
 }
