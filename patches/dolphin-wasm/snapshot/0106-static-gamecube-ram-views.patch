+  // or a RAM size override, keep MemArena.
+  m_static_views = !wii;
+  for (const PhysicalMemoryRegion& region : m_physical_regions)
+  {
+    if (region.active &&
+        !StaticView(region.out_pointer, &m_ram, &m_l1_cache, &m_fake_vmem, region.size))
+    {
+      m_static_views = false;
+    }
+  }
+#else
+  m_static_views = false;
+#endif
+  if (!m_static_views)
+    m_arena.GrabSHMSegment(mem_size, "dolphin-emu");
 
   m_physical_page_mappings.fill(nullptr);
 
@@ -145,7 +192,13 @@ void MemoryManager::Init()
     if (!region.active)
       continue;
 
-    *region.out_pointer = (u8*)m_arena.CreateView(region.shm_position, region.size);
+#ifdef __EMSCRIPTEN__
