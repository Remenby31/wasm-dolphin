diff --git a/Source/Core/VideoCommon/WasmLoadStats.h b/Source/Core/VideoCommon/WasmLoadStats.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/VideoCommon/WasmLoadStats.h
@@ -0,0 +1,71 @@
+// Copyright 2026 wasm-dolphin contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// Patch 0219 (harness only): what a cache miss costs the video thread, to
+// separate a load's GPU work (textures decoded and uploaded, shaders and
+// pipelines created). Counted in dolphin_web_discio.cpp, in a block the
+// harness allocates; with the counters off (players) a miss makes one
+// acquire load of a flag (On) and nothing else: no clock read, no write.
+// Only cache misses call these, never a hit.
+
+#pragma once
+
+#include "Common/CommonTypes.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+
+extern "C" int DolphinWeb_HarnessLoadStatsOn();
+extern "C" void DolphinWeb_HarnessRecordTextureLoad(u32 bytes, double decode_ms, double upload_ms);
+extern "C" void DolphinWeb_HarnessRecordShaderCompile(double gen_ms, double create_ms);
+extern "C" void DolphinWeb_HarnessRecordPipelineMiss(double ms);
+
+namespace DolphinWeb::LoadStats
+{
+inline bool On()
+{
+  return DolphinWeb_HarnessLoadStatsOn() != 0;
+}
+// A clock read only with the counters on.
+inline double Now(bool on)
+{
+  return on ? emscripten_get_now() : 0.0;
+}
+inline void Texture(bool on, u32 bytes, double decode_ms, double upload_ms)
+{
+  if (on)
+    DolphinWeb_HarnessRecordTextureLoad(bytes, decode_ms, upload_ms);
+}
+inline void Shader(bool on, double gen_ms, double create_ms)
+{
+  if (on)
+    DolphinWeb_HarnessRecordShaderCompile(gen_ms, create_ms);
+}
+inline void Pipeline(bool on, double ms)
+{
+  if (on)
+    DolphinWeb_HarnessRecordPipelineMiss(ms);
+}
+}  // namespace DolphinWeb::LoadStats
+#else
+namespace DolphinWeb::LoadStats
+{
+inline bool On()
+{
+  return false;
+}
+inline double Now(bool)
+{
+  return 0.0;
+}
+inline void Texture(bool, u32, double, double)
+{
+}
+inline void Shader(bool, double, double)
+{
+}
+inline void Pipeline(bool, double)
+{
+}
+}  // namespace DolphinWeb::LoadStats
+#endif
