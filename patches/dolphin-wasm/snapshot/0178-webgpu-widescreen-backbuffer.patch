diff --git a/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
--- a/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
+++ b/Source/Core/VideoBackends/WebGPU/WebGPUGfx.cpp
@@ -2700,7 +2700,12 @@
   // presenter would average the extra pixels away. BindBackbuffer tells the
   // consumer, which sizes the canvas to match. The core allows 1 to 4.
   const u32 scale = static_cast<u32>(std::clamp(g_ActiveConfig.iEFBScale, 1, 4));
-  return {640 * scale, 480 * scale, 1.0f, AbstractTextureFormat::BGRA8};
+  // Widescreen (patch 0178): with Dolphin's widescreen hack the backbuffer
+  // is 16:9, 480N lines and 4/3 as wide, rounded to even: 854, 1706, 2560,
+  // 3414. The picture is stretched to it (Stretch) and the hack widens the
+  // 3D view to the backbuffer's aspect.
+  const u32 width = g_ActiveConfig.bWidescreenHack ? ((2560 * scale + 2) / 3) & ~1u : 640 * scale;
+  return {width, 480 * scale, 1.0f, AbstractTextureFormat::BGRA8};
 }
 
 void WebGPUGfx::OnConfigChanged(u32 changed_bits)
@@ -2708,8 +2713,9 @@
   AbstractGfx::OnConfigChanged(changed_bits);
   // A new internal resolution: lay the presenter out on the new backbuffer
   // now, as other backends do when their surface resizes. The next
-  // BindBackbuffer announces the size before drawing into it.
-  if ((changed_bits & CONFIG_CHANGE_BIT_TARGET_SIZE) && g_presenter)
+  // BindBackbuffer announces the size before drawing into it. The widescreen
+  // hack changes the backbuffer's aspect (patch 0178): same.
+  if ((changed_bits & (CONFIG_CHANGE_BIT_TARGET_SIZE | CONFIG_CHANGE_BIT_ASPECT_RATIO)) && g_presenter)
     g_presenter->SetBackbuffer(GetSurfaceInfo());
 }
 
