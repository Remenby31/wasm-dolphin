+// GX writes a constant destination alpha (GX_SetDstAlpha) while blending the
+// colour by the TEV alpha. Dolphin does both in one draw with dual-source
+// blending: ocol0.a carries the constant, ocol1.a the TEV alpha the blend
+// reads. A pipeline that cannot have dual-source blending (no such host
+// feature, as Safari's WebGPU; or, on WebGPU, a shader that writes depth,
+// see PipelineUtils.cpp) would blend with the constant instead. Old Dolphin
+// drew those in two passes, as below.
+static bool DualSourceBlendDropped(const pixel_shader_uid_data* ps)
+{
+  // Framebuffer fetch blends in the shader and needs no second pass.
+  if (g_backend_info.bSupportsFramebufferFetch)
+    return false;
+  if (!g_backend_info.bSupportsDualSourceBlend)
+    return true;
+  return g_backend_info.api_type == APIType::Vulkan && ps->per_pixel_depth;
+}
+
+bool VertexManagerBase::NeedsDstAlphaPass(const VideoCommon::GXPipelineUid& config)
+{
+  const pixel_shader_uid_data* ps = config.ps_uid.GetUidData();
+  return ps->useDstAlpha && config.blending_state.RequiresDualSrc() &&
+         DualSourceBlendDropped(ps);
+}
+
+static bool ReadsDstAlpha(const BlendingState& b)
+{
+  return b.src_factor == SrcBlendFactor::DstAlpha || b.src_factor == SrcBlendFactor::InvDstAlpha ||
+         b.dst_factor == DstBlendFactor::DstAlpha || b.dst_factor == DstBlendFactor::InvDstAlpha;
+}
+
+VertexManagerBase::DstAlphaPasses
+VertexManagerBase::DstAlphaPassConfigs(const VideoCommon::GXPipelineUid& config)
+{
+  DstAlphaPasses p;
+  // The colour: the game's blend and depth state, with the TEV alpha in
+  // ocol0.a (no destination-alpha constant); the alpha channel left alone.
+  p.color = config;
+  p.color.ps_uid.GetUidData()->useDstAlpha = false;
+  p.color.blending_state.alpha_update = false;
+
+  // The constant alone, unblended, colour writes off, never writing depth.
+  p.alpha = config;
+  p.alpha.blending_state.blend_enable = false;
+  p.alpha.blending_state.color_update = false;
+  p.alpha.depth_state.update_enable = false;
+
+  // Drawn first, it sees the depth buffer the colour pass will see, so it
+  // writes the constant exactly where the colour pass draws, whatever the
+  // game's depth function (strict tests, NEVER) and without a depth write of
+  // its own. Same vertex shader in both pipelines (only the pixel shader uid
+  // differs), so the same depth. Unless the colour blend reads the
+  // destination alpha: it must read the old one, so the colour goes first
+  // and the constant follows on the fragments it left (depth EQUAL when the
+  // colour wrote depth: a fragment it rejected at the same depth gets the
+  // constant too, a known limit of that rare case).
+  p.alpha_first = !ReadsDstAlpha(config.blending_state);
+  if (!p.alpha_first && p.alpha.depth_state.test_enable)
+  {
+    if (p.alpha.depth_state.func == CompareMode::Never)
+      p.alpha_drawn = false;
+    else if (config.depth_state.update_enable)
+      p.alpha.depth_state.func = CompareMode::Equal;
+  }
+  return p;
+}
